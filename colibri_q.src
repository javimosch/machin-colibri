// colibri_q — pure-MFL int8 (Q8_0) LLM inference engine (M1)
// Reads llama2.c "version 2" checkpoints (magic ak42): group-quantized int8
// weights + fp32 group scales, fp32 rmsnorm params. Mirrors runq.c faithfully.

// ---- config ----
var dim = 0
var hidden_dim = 0
var n_layers = 0
var n_heads = 0
var n_kv_heads = 0
var vocab_size = 0
var seq_len = 0
var head_size = 0
var kv_dim = 0
var gs = 0
var shared_cls = 0
var quant4 = 0

// ---- weight offsets into the checkpoint buffer (bytes) ----
var wbuf = 0
var w_rms_att = 0
var w_rms_ffn = 0
var w_rms_final = 0
// quantized tensor bases; per-layer block = size + 4*size/gs (q bytes then f32 scales)
var w_tok = 0
var wq_b = 0
var wk_b = 0
var wv_b = 0
var wo_b = 0
var w1_b = 0
var w2_b = 0
var w3_b = 0
var wcls_b = 0

// ---- run state ----
var s_x = 0
var s_xb = 0
var s_xb2 = 0
var s_hb = 0
var s_hb2 = 0
var s_q = 0
var s_att = 0
var s_logits = 0
var s_key_cache = 0
var s_val_cache = 0
var s_xq = 0    // quantized activation values (int8 bytes)
var s_xq_s = 0  // fp32 group scales
var s_hq = 0
var s_hq_s = 0

// ---- tokenizer ----
var vocab = []string{}
var vocab_idx = make(map[string]int)
var tok_scores = 0 // raw buffer of fp32 scores

func read_i32(b, off) (v) {
	v = byte_at(b, off) | byte_at(b, off+1) << 8 | byte_at(b, off+2) << 16 | byte_at(b, off+3) << 24
	if v >= 2147483648 { v = v - 4294967296 }
	return
}

func bytes_to_buf(b) (p) {
	n := len(b)
	p = alloc(n + 4)
	i := 0
	while i + 4 <= n {
		w := byte_at(b, i) | byte_at(b, i+1) << 8 | byte_at(b, i+2) << 16 | byte_at(b, i+3) << 24
		poke_i32(p, i, w)
		i = i + 4
	}
	while i < n { poke_u8(p, i, byte_at(b, i))  i = i + 1 }
	return
}

// packed quant bytes for a tensor: int8 = size, int4 = size/2 (split-nibble)
func wsz(size) (n) { n = size  if quant4 == 1 { n = size / 2 }  return }
// quantized tensor block size in bytes: packed q values + size/gs fp32 scales
func qblock(size) (n) { n = wsz(size) + 4 * (size / gs)  return }

func load_model(path) {
	b := read_file_bytes(path)
	if len(b) == 0 { println("cannot read model: " + path)  exit(1) }
	m := read_i32(b, 0)
	if m == 1634415666 { quant4 = 0 } else { // 0x616b3432 "ak42" (int8 v2)
		if m == 1634415667 { quant4 = 1 } else { println("bad magic (want ak42 v2 int8 or ak43 v3 int4)")  exit(1) } // 0x616b3433
	}
	dim = read_i32(b, 8)
	hidden_dim = read_i32(b, 12)
	n_layers = read_i32(b, 16)
	n_heads = read_i32(b, 20)
	n_kv_heads = read_i32(b, 24)
	vocab_size = read_i32(b, 28)
	seq_len = read_i32(b, 32)
	shared_cls = byte_at(b, 36)
	gs = read_i32(b, 37)
	head_size = dim / n_heads
	kv_dim = (dim * n_kv_heads) / n_heads
	wbuf = bytes_to_buf(b)
	o := 256
	w_rms_att = o    o = o + n_layers * dim * 4
	w_rms_ffn = o    o = o + n_layers * dim * 4
	w_rms_final = o  o = o + dim * 4
	w_tok = o        o = o + qblock(vocab_size * dim)
	wq_b = o         o = o + n_layers * qblock(dim * dim)
	wk_b = o         o = o + n_layers * qblock(dim * kv_dim)
	wv_b = o         o = o + n_layers * qblock(dim * kv_dim)
	wo_b = o         o = o + n_layers * qblock(dim * dim)
	w1_b = o         o = o + n_layers * qblock(dim * hidden_dim)
	w2_b = o         o = o + n_layers * qblock(hidden_dim * dim)
	w3_b = o         o = o + n_layers * qblock(dim * hidden_dim)
	if shared_cls == 1 { wcls_b = w_tok } else { wcls_b = o }
}

func alloc_state() {
	s_x = alloc(dim * 4)
	s_xb = alloc(dim * 4)
	s_xb2 = alloc(dim * 4)
	s_hb = alloc(hidden_dim * 4)
	s_hb2 = alloc(hidden_dim * 4)
	s_q = alloc(dim * 4)
	s_att = alloc(n_heads * seq_len * 4)
	s_logits = alloc(vocab_size * 4)
	s_key_cache = alloc(n_layers * seq_len * kv_dim * 4)
	s_val_cache = alloc(n_layers * seq_len * kv_dim * 4)
	s_xq = alloc(dim)
	s_xq_s = alloc((dim / gs) * 4)
	s_hq = alloc(hidden_dim)
	s_hq_s = alloc((hidden_dim / gs) * 4)
}

func load_tokenizer(path) {
	b := read_file_bytes(path)
	if len(b) == 0 { println("cannot read tokenizer: " + path)  exit(1) }
	tbuf := bytes_to_buf(b)
	tok_scores = alloc(vocab_size * 4)
	off := 4
	i := 0
	while i < vocab_size {
		poke_f32(tok_scores, i*4, peek_f32(tbuf, off))
		off = off + 4
		n := read_i32(b, off)
		off = off + 4
		piece := bytes_str(bytes_sub(b, off, off+n))
		vocab = append(vocab, piece)
		vocab_idx[piece] = i
		off = off + n
		i = i + 1
	}
	free(tbuf)
}

// ---- math kernels ----

func rmsnorm(dst, x, w, size) {
	ss := 0.0
	j := 0
	while j < size {
		v := peek_f32(x, j*4)
		ss = ss + v * v
		j = j + 1
	}
	ss = ss / float(size)
	ss = 1.0 / sqrt(ss + 0.00001)
	j = 0
	while j < size {
		poke_f32(dst, j*4, peek_f32(w, j*4) * ss * peek_f32(x, j*4))
		j = j + 1
	}
}

func softmax(x, size) {
	mx := peek_f32(x, 0)
	i := 1
	while i < size {
		v := peek_f32(x, i*4)
		if v > mx { mx = v }
		i = i + 1
	}
	sum := 0.0
	i = 0
	while i < size {
		e := exp(peek_f32(x, i*4) - mx)
		poke_f32(x, i*4, e)
		sum = sum + e
		i = i + 1
	}
	i = 0
	while i < size {
		poke_f32(x, i*4, peek_f32(x, i*4) / sum)
		i = i + 1
	}
}

// quantize fp32 buffer x[n] into int32-slot quants xq + fp32 group scales xs (runq.c quantize)
func quantize_act(xq, xs, x, n) {
	ng := n / gs
	g := 0
	while g < ng {
		base := g * gs
		wmax := 0.0
		i := 0
		while i < gs {
			v := abs(peek_f32(x, (base+i)*4))
			if v > wmax { wmax = v }
			i = i + 1
		}
		scale := wmax / 127.0
		poke_f32(xs, g*4, scale)
		i = 0
		while i < gs {
			q := 0
			if scale > 0.0 { q = int(round(peek_f32(x, (base+i)*4) / scale)) }
			poke_u8(xq, base+i, q & 255)
			i = i + 1
		}
		g = g + 1
	}
}

// xout[lo..hi) = W(int8)[d,n] @ xq[n], group-scaled (runq.c matmul)
// wq = q base offset, ws = scale base offset (bytes into wbuf)
func matmul_q(xout, xq, xs, wq, ws, n, lo, hi) {
	i := lo
	while i < hi {
		val := 0.0
		in := i * n
		wrow := wbuf + wq + in
		j := 0
		while j < n {
			ival := dot_i8(xq + j, wrow + j, gs)
			val = val + float(ival) * peek_f32(wbuf, ws + ((in+j)/gs)*4) * peek_f32(xs, (j/gs)*4)
			j = j + gs
		}
		poke_f32(xout, i*4, val)
		i = i + 1
	}
}

// int4 variant: 32-byte groups, byte i holds q[k=i] (low nibble) and q[k=i+32]
// (high nibble), each stored as q+8. Two uniform half-group loops so the
// nibble unpack autovectorizes.
func matmul_q4(xout, xq, xs, wq, ws, n, lo, hi, sc) {
	h := gs / 2
	i := lo
	while i < hi {
		// pass 1: unpack the whole int4 row into the worker's i8 scratch
		wrow := wbuf + wq + i * (n / 2)
		g := 0
		while g < n / gs {
			wg := wrow + g * h
			sg := sc + g * gs
			k := 0
			while k < h {
				b := peek_u8(wg, k)
				poke_u8(sg, k, ((b & 15) - 8) & 255)
				poke_u8(sg, k + h, ((b >> 4) - 8) & 255)
				k = k + 1
			}
			g = g + 1
		}
		// pass 2: same i8 dot as the int8 kernel, reading from L1 scratch
		val := 0.0
		in := i * n
		j := 0
		while j < n {
			ival := dot_i8(xq + j, sc + j, gs)
			val = val + float(ival) * peek_f32(wbuf, ws + ((in+j)/gs)*4) * peek_f32(xs, (j/gs)*4)
			j = j + gs
		}
		poke_f32(xout, i*4, val)
		i = i + 1
	}
}

// quant-width dispatch: tensor base tb, logical element count tsize, input width n
func mmj(xout, xq, xs, tb, tsize, n, lo, hi, sc) {
	if quant4 == 1 { matmul_q4(xout, xq, xs, tb, tb + wsz(tsize), n, lo, hi, sc) } else { matmul_q(xout, xq, xs, tb, tb + wsz(tsize), n, lo, hi) }
}

// dequantize one token-embedding row into x (runq dequantizes whole table; same math per element)
func embed_token(token) {
	row := token * dim
	sbase := w_tok + wsz(vocab_size * dim) // scales sit after the packed q bytes
	if quant4 == 1 {
		h := gs / 2
		g := 0
		while g < dim / gs {
			gq := w_tok + token * (dim / 2) + g * h
			sc := peek_f32(wbuf, sbase + ((row + g*gs)/gs)*4)
			i := 0
			while i < h {
				b := peek_u8(wbuf, gq + i)
				poke_f32(s_x, (g*gs+i)*4, float((b & 15) - 8) * sc)
				poke_f32(s_x, (g*gs+i+h)*4, float((b >> 4) - 8) * sc)
				i = i + 1
			}
			g = g + 1
		}
		return
	}
	i := 0
	while i < dim {
		poke_f32(s_x, i*4, float(peek_i8(wbuf, w_tok + row + i)) * peek_f32(wbuf, sbase + ((row+i)/gs)*4))
		i = i + 1
	}
}

// RoPE: rotate adjacent pairs of q (all dims) and this position's cached k (kv dims)
func rope(l, pos) {
	kptr := s_key_cache + (l * seq_len * kv_dim + pos * kv_dim) * 4
	i := 0
	while i < dim {
		hd := i % head_size
		freq := 1.0 / pow(10000.0, float(hd) / float(head_size))
		val := float(pos) * freq
		fcr := cos(val)
		fci := sin(val)
		q0 := peek_f32(s_q, i*4)
		q1 := peek_f32(s_q, i*4+4)
		poke_f32(s_q, i*4, q0 * fcr - q1 * fci)
		poke_f32(s_q, i*4+4, q0 * fci + q1 * fcr)
		if i < kv_dim {
			k0 := peek_f32(kptr, i*4)
			k1 := peek_f32(kptr, i*4+4)
			poke_f32(kptr, i*4, k0 * fcr - k1 * fci)
			poke_f32(kptr, i*4+4, k0 * fci + k1 * fcr)
		}
		i = i + 2
	}
}

// one attention head over the kv cache: scores -> softmax -> weighted V sum into s_xb
func attn_head(h, l, pos) {
	loff := l * seq_len * kv_dim
	kv_mul := n_heads / n_kv_heads
	qh := s_q + h * head_size * 4
	atth := s_att + h * seq_len * 4
	t := 0
	while t <= pos {
		kt := s_key_cache + (loff + t * kv_dim + (h / kv_mul) * head_size) * 4
		score := 0.0
		j := 0
		while j < head_size {
			score = score + peek_f32(qh, j*4) * peek_f32(kt, j*4)
			j = j + 1
		}
		poke_f32(atth, t*4, score / sqrt(float(head_size)))
		t = t + 1
	}
	softmax(atth, pos + 1)
	xbh := s_xb + h * head_size * 4
	j := 0
	while j < head_size {
		poke_f32(xbh, j*4, 0.0)
		j = j + 1
	}
	t = 0
	while t <= pos {
		vt := s_val_cache + (loff + t * kv_dim + (h / kv_mul) * head_size) * 4
		a := peek_f32(atth, t*4)
		j = 0
		while j < head_size {
			poke_f32(xbh, j*4, peek_f32(xbh, j*4) + a * peek_f32(vt, j*4))
			j = j + 1
		}
		t = t + 1
	}
}

// ---- worker pool: jobs are packed ints, results land in disjoint buffer rows ----
// job = type | layer<<4 | pos<<12 | lo<<24 | hi<<44
// types: 0 wq  1 wk  2 wv  3 wo  4 w1  5 w3  6 w2  7 wcls  8 attention heads
var n_workers = 1
var jobs = make(chan int)
var done = make(chan int)
var pending = 0

func do_job(j, sc) {
	t := j & 15
	l := (j >> 4) & 255
	pos := (j >> 12) & 4095
	lo := (j >> 24) & 1048575
	hi := j >> 44
	if t == 0 { mmj(s_q, s_xq, s_xq_s, wq_b + l * qblock(dim*dim), dim*dim, dim, lo, hi, sc) }
	if t == 1 {
		kptr := s_key_cache + (l * seq_len * kv_dim + pos * kv_dim) * 4
		mmj(kptr, s_xq, s_xq_s, wk_b + l * qblock(dim*kv_dim), dim*kv_dim, dim, lo, hi, sc)
	}
	if t == 2 {
		vptr := s_val_cache + (l * seq_len * kv_dim + pos * kv_dim) * 4
		mmj(vptr, s_xq, s_xq_s, wv_b + l * qblock(dim*kv_dim), dim*kv_dim, dim, lo, hi, sc)
	}
	if t == 3 { mmj(s_xb2, s_xq, s_xq_s, wo_b + l * qblock(dim*dim), dim*dim, dim, lo, hi, sc) }
	if t == 4 { mmj(s_hb, s_xq, s_xq_s, w1_b + l * qblock(dim*hidden_dim), dim*hidden_dim, dim, lo, hi, sc) }
	if t == 5 { mmj(s_hb2, s_xq, s_xq_s, w3_b + l * qblock(dim*hidden_dim), dim*hidden_dim, dim, lo, hi, sc) }
	if t == 6 { mmj(s_xb, s_hq, s_hq_s, w2_b + l * qblock(hidden_dim*dim), hidden_dim*dim, hidden_dim, lo, hi, sc) }
	if t == 7 { mmj(s_logits, s_xq, s_xq_s, wcls_b, dim*vocab_size, dim, lo, hi, sc) }
	if t == 8 {
		h := lo
		while h < hi { attn_head(h, l, pos)  h = h + 1 }
	}
	if t == 9 { // fused qkv: this worker's rows of q, plus the matching k/v shares
		mmj(s_q, s_xq, s_xq_s, wq_b + l * qblock(dim*dim), dim*dim, dim, lo, hi, sc)
		klo := (lo * kv_dim) / dim
		khi := (hi * kv_dim) / dim
		if khi > klo {
			kptr := s_key_cache + (l * seq_len * kv_dim + pos * kv_dim) * 4
			vptr := s_val_cache + (l * seq_len * kv_dim + pos * kv_dim) * 4
			mmj(kptr, s_xq, s_xq_s, wk_b + l * qblock(dim*kv_dim), dim*kv_dim, dim, klo, khi, sc)
			mmj(vptr, s_xq, s_xq_s, wv_b + l * qblock(dim*kv_dim), dim*kv_dim, dim, klo, khi, sc)
		}
	}
	if t == 10 { // fused ffn up: w1 and w3 share the same rows
		mmj(s_hb, s_xq, s_xq_s, w1_b + l * qblock(dim*hidden_dim), dim*hidden_dim, dim, lo, hi, sc)
		mmj(s_hb2, s_xq, s_xq_s, w3_b + l * qblock(dim*hidden_dim), dim*hidden_dim, dim, lo, hi, sc)
	}
}

func worker(jc, dc) {
	sc := alloc(hidden_dim) // per-worker int4 row-unpack scratch (covers widest row)
	for j := range jc {
		do_job(j, sc)
		dc <- 1
	}
}

// split rows [0,d) into n_workers chunks and enqueue with a sliding window:
// never more than n_workers jobs outstanding (unbuffered channels — a bigger
// backlog would deadlock: workers block on done<-, main on jobs<-)
func dispatch(t, l, pos, d) {
	nc := n_workers
	if nc > d { nc = d }
	chunk := (d + nc - 1) / nc
	lo := 0
	while lo < d {
		hi := lo + chunk
		if hi > d { hi = d }
		if pending >= n_workers { <-done  pending = pending - 1 }
		jobs <- (t | l << 4 | pos << 12 | lo << 24 | hi << 44)
		pending = pending + 1
		lo = hi
	}
}

func barrier() {
	while pending > 0 { <-done  pending = pending - 1 }
}

func forward(token, pos) {
	embed_token(token)
	i := 0
	l := 0
	while l < n_layers {
		rmsnorm(s_xb, s_x, wbuf + w_rms_att + l * dim * 4, dim)
		quantize_act(s_xq, s_xq_s, s_xb, dim)
		dispatch(9, l, pos, dim)  barrier()
		rope(l, pos)
		dispatch(8, l, pos, n_heads)  barrier()
		// attention out projection + residual
		quantize_act(s_xq, s_xq_s, s_xb, dim)
		dispatch(3, l, pos, dim)  barrier()
		i = 0
		while i < dim {
			poke_f32(s_x, i*4, peek_f32(s_x, i*4) + peek_f32(s_xb2, i*4))
			i = i + 1
		}
		// ffn
		rmsnorm(s_xb, s_x, wbuf + w_rms_ffn + l * dim * 4, dim)
		quantize_act(s_xq, s_xq_s, s_xb, dim)
		dispatch(10, l, pos, hidden_dim)  barrier()
		i = 0
		while i < hidden_dim {
			v := peek_f32(s_hb, i*4)
			v = v * (1.0 / (1.0 + exp(0.0 - v)))
			poke_f32(s_hb, i*4, v * peek_f32(s_hb2, i*4))
			i = i + 1
		}
		quantize_act(s_hq, s_hq_s, s_hb, hidden_dim)
		dispatch(6, l, pos, dim)  barrier()
		i = 0
		while i < dim {
			poke_f32(s_x, i*4, peek_f32(s_x, i*4) + peek_f32(s_xb, i*4))
			i = i + 1
		}
		l = l + 1
	}
	rmsnorm(s_x, s_x, wbuf + w_rms_final, dim)
	quantize_act(s_xq, s_xq_s, s_x, dim)
	dispatch(7, 0, pos, vocab_size)  barrier()
}

func argmax_logits() (best) {
	best = 0
	bv := peek_f32(s_logits, 0)
	i := 1
	while i < vocab_size {
		v := peek_f32(s_logits, i*4)
		if v > bv { bv = v  best = i }
		i = i + 1
	}
	return
}

// ---- BPE encode (llama2.c encode(): BOS + dummy prefix + char lookup + best-score merges) ----
func bpe_encode(text) (toks) {
	toks = []int{}
	toks = append(toks, 1) // BOS
	if len(text) == 0 { return }
	toks = append(toks, vocab_idx[" "]) // sentencepiece dummy prefix
	b := bytes(text)
	n := len(b)
	i := 0
	while i < n {
		j := i + 1
		while j < n && (byte_at(b, j) & 192) == 128 { j = j + 1 }
		c := bytes_str(bytes_sub(b, i, j))
		if has(vocab_idx, c) {
			toks = append(toks, vocab_idx[c])
		} else {
			k := i
			while k < j { toks = append(toks, byte_at(b, k) + 3)  k = k + 1 }
		}
		i = j
	}
	while true {
		best_score := 0.0 - 1000000000.0
		best_id := -1
		best_idx := -1
		ti := 0
		while ti < len(toks) - 1 {
			merged := vocab[toks[ti]] + vocab[toks[ti+1]]
			if has(vocab_idx, merged) {
				id := vocab_idx[merged]
				sc := peek_f32(tok_scores, id*4)
				if sc > best_score { best_score = sc  best_id = id  best_idx = ti }
			}
			ti = ti + 1
		}
		if best_idx == -1 { break }
		nt := []int{}
		ti = 0
		while ti < len(toks) {
			if ti == best_idx { nt = append(nt, best_id)  ti = ti + 2 } else { nt = append(nt, toks[ti])  ti = ti + 1 }
		}
		toks = nt
	}
	return
}

func decode_piece(prev, token) (piece) {
	piece = vocab[token]
	if prev == 1 && has_prefix(piece, " ") { piece = substr(piece, 1, len(piece)) }
	if has_prefix(piece, "<0x") && has_suffix(piece, ">") {
		piece = bytes_str(from_hex(substr(piece, 3, 5)))
	}
	return
}

func main() {
	a := args()
	model := "models/tinyllama-1.1b-q80.bin"
	steps := 64
	prompt := ""
	if len(a) > 1 { model = a[1] }
	if len(a) > 2 { steps = parse_int(a[2]) }
	if len(a) > 3 { prompt = a[3] }
	nw := parse_int(env("COLIBRI_THREADS"))
	if nw > 0 { n_workers = nw } else { n_workers = 8 }
	t0 := now_ms()
	load_model(model)
	alloc_state()
	load_tokenizer("models/tokenizer.bin")
	w := 0
	while w < n_workers { go worker(jobs, done)  w = w + 1 }
	t1 := now_ms()
	println("loaded: dim=" + str(dim) + " hidden=" + str(hidden_dim) + " layers=" + str(n_layers) + " heads=" + str(n_heads) + " kv_heads=" + str(n_kv_heads) + " vocab=" + str(vocab_size) + " seq=" + str(seq_len) + " gs=" + str(gs) + " shared_cls=" + str(shared_cls) + " (" + str(t1 - t0) + " ms)")
	if steps > seq_len { steps = seq_len }
	ptoks := bpe_encode(prompt)
	token := ptoks[0]
	pos := 0
	t2 := now_ms()
	dl := env("DL")
	while pos < steps {
		forward(token, pos)
		if len(dl) > 0 {
			am := argmax_logits()
			println("DL " + str(pos) + " tok=" + str(token) + " argmax=" + str(am) + " v=" + str(peek_f32(s_logits, am*4)) + " l0=" + str(peek_f32(s_logits, 0)) + " l1=" + str(peek_f32(s_logits, 4)) + " l2=" + str(peek_f32(s_logits, 8)))
		}
		next := 0
		if pos < len(ptoks) - 1 { next = ptoks[pos+1] } else { next = argmax_logits() }
		pos = pos + 1
		if next == 1 || next == 2 { break } // BOS/EOS
		print(decode_piece(token, next))
		flush()
		token = next
	}
	t3 := now_ms()
	println("")
	if t3 > t2 && pos > 0 {
		tps := float(pos) * 1000.0 / float(t3 - t2)
		println("tokens: " + str(pos) + "  time: " + str(t3 - t2) + " ms  tok/s: " + str(tps))
	}
}
