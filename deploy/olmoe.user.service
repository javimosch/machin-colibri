[Unit]
Description=anvil OLMoE — pure-MFL OpenAI server (OLMoE-1B-7B MoE, int8)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/jarancibia/ai/machin-anvil
Environment=COLIBRI_THREADS=8
Environment=COLIBRI_IDLE=300
ExecStart=/home/jarancibia/ai/machin-anvil/serve_olmoe /home/jarancibia/ai/machin-anvil/models/olmoe-q8-lm8.bin 8091 /home/jarancibia/ai/machin-anvil/models/olmoe-tok.bin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
