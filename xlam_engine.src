// Pure-MFL xLAM-1b-fc-r (deepseek-1.3b / dense Llama arch) inference.
// Dense SwiGLU FFN, standard RMSNorm (no qk-norm), rotate_half RoPE with LINEAR
// scaling (pos/rscale), theta 1e5, no GQA. int8 Q8_0 matmuls (dot_q8), mmap +
// worker pool + madvise idle-release, reused from the OLMoE engine.

var mb = 0
var model_bytes = 0
var D = 0
var NH = 0
var NKV = 0
var HD = 0
var II = 0
var L = 0
var VOCAB = 0
var SEQ = 0
var GS = 0
var lmbits = 8
var rscale = 1
var theta = 100000
var HALF = 0
var DSC = 0
var ISC = 0
var blk_attn = 0
var attn_stride = 0
var gu = 0        // gate/up block bytes
var ffn_stride = 0
var embed_off = 0
var norms_off = 0
var fnorm_off = 0
var lmhead_off = 0
var attn_off = 0
var ffn_off = 0

var xx = 0
var hb = 0
var qb = 0
var kb = 0
var vb = 0
var attn = 0
var ffn_out = 0
var gbuf = 0
var ubuf = 0
var xqb = 0
var xsb = 0
var att = 0
var logits = 0
var kcache = 0
var vcache = 0
var rinv = 0
var rcos = 0
var rsin = 0

var n_workers = 1
var jobs = make(chan int)
var done = make(chan int)
var pending = 0
var gj_dst = 0
var gj_wq = 0
var gj_ws = 0
var gj_n = 0
var gj_wf = 0

// ---- batched prefill (tile of positions) + single-slot KV prefix cache ----
var pb_tile = 256
var pb_enabled = 1
var pb_B = 0
var pb_tstart = 0
var pb_x = 0       // TILE x D residual
var pb_xb = 0      // TILE x D normed / attn out
var pb_xb2 = 0     // TILE x D o-proj out
var pb_q = 0       // TILE x D queries
var pb_hb = 0      // TILE x II
var pb_hb2 = 0     // TILE x II
var pb_xq = 0      // TILE x D int8
var pb_xqs = 0     // TILE x (D/GS) f32
var pb_hq = 0      // TILE x II int8
var pb_hqs = 0     // TILE x (II/GS) f32
var cache_buf = 0  // persistent prompt-token bookkeeping (raw, survives per-request arenas)
var cache_len = 0

func load_xlam(path) {
	m, sz := mmap_file(path)
	mb = m
	model_bytes = sz
	if peek_i32(mb, 0) != 1634419761 { println("bad magic")  flush() }  // 0x616B4431 akD1
	D = peek_i32(mb, 4)
	NH = peek_i32(mb, 8)
	NKV = peek_i32(mb, 12)
	HD = peek_i32(mb, 16)
	II = peek_i32(mb, 20)
	L = peek_i32(mb, 24)
	VOCAB = peek_i32(mb, 28)
	SEQ = peek_i32(mb, 32)
	GS = peek_i32(mb, 36)
	lmbits = peek_i32(mb, 40)
	rscale = peek_i32(mb, 44)
	theta = peek_i32(mb, 48)
	embed_off = peek_i32(mb, 52)
	norms_off = peek_i32(mb, 56)
	fnorm_off = peek_i32(mb, 60)
	lmhead_off = peek_i32(mb, 64)
	attn_off = peek_i32(mb, 68)
	ffn_off = peek_i32(mb, 72)
	HALF = HD / 2
	DSC = (D * D) / GS
	ISC = (II * D) / GS
	blk_attn = D*D + 4*DSC
	attn_stride = 4 * blk_attn
	gu = II*D + 4*ISC
	ffn_stride = 3 * gu
}

func alloc_xlam() {
	xx = alloc(D*4)  hb = alloc(D*4)  qb = alloc(D*4)  kb = alloc(D*4)  vb = alloc(D*4)
	attn = alloc(D*4)  ffn_out = alloc(D*4)
	gbuf = alloc(II*4)  ubuf = alloc(II*4)
	mx := D
	if II > D { mx = II }               // quant scratch must cover the widest matmul input (down_proj: II)
	xqb = alloc(mx)  xsb = alloc((mx/GS)*4)
	att = alloc(SEQ*4)  logits = alloc(VOCAB*4)
	kcache = alloc(L*SEQ*D*4)  vcache = alloc(L*SEQ*D*4)
	rinv = alloc(HALF*4)  rcos = alloc(HALF*4)  rsin = alloc(HALF*4)
	cache_buf = alloc(SEQ * 4)
	t := pb_tile
	pb_x = alloc(t*D*4)  pb_xb = alloc(t*D*4)  pb_xb2 = alloc(t*D*4)  pb_q = alloc(t*D*4)
	pb_hb = alloc(t*II*4)  pb_hb2 = alloc(t*II*4)
	pb_xq = alloc(t*D)  pb_xqs = alloc(t*(D/GS)*4)
	pb_hq = alloc(t*II)  pb_hqs = alloc(t*(II/GS)*4)
	lnth := 11.512925464970229   // ln(100000); model theta is fixed at 1e5
	i := 0
	while i < HALF {
		poke_f32(rinv, i*4, exp(0.0 - (float(i)/float(HALF)) * lnth))
		i = i + 1
	}
}

func rmsnorm(dst, src, woff, n) {
	ss := 0.0
	i := 0
	while i < n { v := peek_f32(src, i*4)  ss = ss + v*v  i = i + 1 }
	ss = 1.0 / sqrt(ss/float(n) + 0.000001)
	i = 0
	while i < n { poke_f32(dst, i*4, peek_f32(src, i*4) * ss * peek_f32(mb, woff + i*4))  i = i + 1 }
}

func quantize_act(xq, xs, x, n) {
	ng := n / GS
	g := 0
	while g < ng {
		base := g * GS
		wmax := 0.0
		i := 0
		while i < GS { v := abs(peek_f32(x, (base+i)*4))  if v > wmax { wmax = v }  i = i + 1 }
		scale := wmax / 127.0
		poke_f32(xs, g*4, scale)
		i = 0
		while i < GS {
			q := 0
			if scale > 0.0 { q = int(round(peek_f32(x, (base+i)*4) / scale)) }
			poke_u8(xq, base+i, q & 255)
			i = i + 1
		}
		g = g + 1
	}
}

func do_job(j, att2) {
	t := j & 31
	l := (j >> 5) & 255
	pos := (j >> 13) & 4095
	lo := (j >> 25) & 524287
	hi := j >> 44
	if t == 1 {
		nsc := gj_n / GS
		o := lo
		while o < hi { poke_f32(gj_dst, o*4, dot_q8(xqb, xsb, gj_wq + o*gj_n, gj_ws + o*nsc*4, gj_n, GS))  o = o + 1 }
	}
	if t == 2 {
		o := lo
		while o < hi { poke_f32(logits, o*4, dot_f32(mb + gj_wf + o*D*4, hb, D))  o = o + 1 }
	}
	if t == 3 {
		h := lo
		while h < hi { attn_head(l, pos, h, att2)  h = h + 1 }
	}
	// ---- batched prefill jobs ----
	if t == 11 { ab := attn_off + l*attn_stride  matmul_q_batch(pb_q, D, pb_xq, pb_xqs, mb + ab, mb + ab + D*D, D, lo, hi, pb_B) }
	if t == 12 { ab := attn_off + l*attn_stride  matmul_q_batch(kcache + (l*SEQ*D + pb_tstart*D)*4, D, pb_xq, pb_xqs, mb + ab + blk_attn, mb + ab + blk_attn + D*D, D, lo, hi, pb_B) }
	if t == 13 { ab := attn_off + l*attn_stride  matmul_q_batch(vcache + (l*SEQ*D + pb_tstart*D)*4, D, pb_xq, pb_xqs, mb + ab + 2*blk_attn, mb + ab + 2*blk_attn + D*D, D, lo, hi, pb_B) }
	if t == 14 { ab := attn_off + l*attn_stride  matmul_q_batch(pb_xb2, D, pb_xq, pb_xqs, mb + ab + 3*blk_attn, mb + ab + 3*blk_attn + D*D, D, lo, hi, pb_B) }
	if t == 15 { fb := ffn_off + l*ffn_stride  matmul_q_batch(pb_hb, II, pb_xq, pb_xqs, mb + fb, mb + fb + II*D, D, lo, hi, pb_B) }
	if t == 16 { fb := ffn_off + l*ffn_stride  matmul_q_batch(pb_hb2, II, pb_xq, pb_xqs, mb + fb + gu, mb + fb + gu + II*D, D, lo, hi, pb_B) }
	if t == 17 { fb := ffn_off + l*ffn_stride  matmul_q_batch(pb_xb, D, pb_hq, pb_hqs, mb + fb + 2*gu, mb + fb + 2*gu + D*II, II, lo, hi, pb_B) }
	if t == 18 {
		u := lo
		while u < hi {
			b := u / NH
			h := u % NH
			attn_head_at(h, l, pb_tstart + b, pb_q + b*D*4, pb_xb + b*D*4, att2)
			u = u + 1
		}
	}
	if t == 19 { nb := norms_off + l*(2*D*4)  b := lo  while b < hi { rmsnorm(pb_xb + b*D*4, pb_x + b*D*4, nb, D)  quantize_act(pb_xq + b*D, pb_xqs + b*(D/GS)*4, pb_xb + b*D*4, D)  b = b + 1 } }
	if t == 20 { nb := norms_off + l*(2*D*4) + D*4  b := lo  while b < hi { rmsnorm(pb_xb + b*D*4, pb_x + b*D*4, nb, D)  quantize_act(pb_xq + b*D, pb_xqs + b*(D/GS)*4, pb_xb + b*D*4, D)  b = b + 1 } }
	if t == 21 { b := lo  while b < hi { quantize_act(pb_xq + b*D, pb_xqs + b*(D/GS)*4, pb_xb + b*D*4, D)  b = b + 1 } }
	if t == 22 { b := lo  while b < hi { i := 0  while i < D { poke_f32(pb_x + b*D*4, i*4, peek_f32(pb_x + b*D*4, i*4) + peek_f32(pb_xb2 + b*D*4, i*4))  i = i + 1 }  b = b + 1 } }
	if t == 23 {
		b := lo
		while b < hi {
			i := 0
			while i < II {
				v := peek_f32(pb_hb + b*II*4, i*4)
				v = v / (1.0 + exp(0.0 - v))
				poke_f32(pb_hb + b*II*4, i*4, v * peek_f32(pb_hb2 + b*II*4, i*4))
				i = i + 1
			}
			quantize_act(pb_hq + b*II, pb_hqs + b*(II/GS)*4, pb_hb + b*II*4, II)
			b = b + 1
		}
	}
	if t == 24 { b := lo  while b < hi { i := 0  while i < D { poke_f32(pb_x + b*D*4, i*4, peek_f32(pb_x + b*D*4, i*4) + peek_f32(pb_xb + b*D*4, i*4))  i = i + 1 }  b = b + 1 } }
	if t == 25 { b := lo  while b < hi { rope_at(l, pb_tstart + b, pb_q + b*D*4)  b = b + 1 } }
}

func worker(jc, dc) {
	att2 := alloc(SEQ * 4)
	for j := range jc {
		do_job(j, att2)
		dc <- 1
	}
}

func dispatch_rows(t, l, pos, d) {
	nc := n_workers
	if nc > d { nc = d }
	chunk := (d + nc - 1) / nc
	lo := 0
	while lo < d {
		hi := lo + chunk
		if hi > d { hi = d }
		if pending >= n_workers { <-done  pending = pending - 1 }
		jobs <- (t | l << 5 | pos << 13 | lo << 25 | hi << 44)
		pending = pending + 1
		lo = hi
	}
}

func barrier() {
	while pending > 0 { <-done  pending = pending - 1 }
}

func matmul_q8(dst, wq, ws, x, out, inn) {
	quantize_act(xqb, xsb, x, inn)
	gj_dst = dst  gj_wq = wq  gj_ws = ws  gj_n = inn
	dispatch_rows(1, 0, 0, out)
	barrier()
}

// batched int8 matmul: ob[b][i] = W[i,:].xqb[b], weight row loaded ONCE, reused
// across B positions. wq/ws absolute byte ptrs; xqb/xsb tile-major (stride n / n/gs).
func matmul_q_batch(ob, ostride, xqb, xsb, wq, ws, n, lo, hi, B) {
	nsc := (n / GS) * 4
	i := lo
	while i < hi {
		wrow := wq + i*n
		wsp := ws + (i*(n/GS))*4
		b := 0
		while b < B {
			poke_f32(ob, (b*ostride + i)*4, dot_q8(xqb + b*n, xsb + b*nsc, wrow, wsp, n, GS))
			b = b + 1
		}
		i = i + 1
	}
}

// attention for one (head, position); reads K/V from cache 0..pos, writes obase[h].
func attn_head_at(h, l, pos, qbase, obase, att2) {
	loff := l * SEQ * D
	qh := qbase + h*HD*4
	t := 0
	while t <= pos {
		kt := kcache + (loff + t*D + h*HD)*4
		poke_f32(att2, t*4, dot_f32(qh, kt, HD) / sqrt(float(HD)))
		t = t + 1
	}
	softmax(att2, pos + 1)
	xbh := obase + h*HD*4
	j := 0
	while j < HD { poke_f32(xbh, j*4, 0.0)  j = j + 1 }
	t = 0
	while t <= pos {
		vt := vcache + (loff + t*D + h*HD)*4
		axpy_f32(xbh, peek_f32(att2, t*4), vt, HD)
		t = t + 1
	}
}

// rope query (at qbase) + the K already stored in cache at `pos`; linear scaling.
// cos/sin computed inline (per-worker safe, no shared rcos/rsin).
func rope_at(l, pos, qbase) {
	loff := l * SEQ * D
	kbase := kcache + (loff + pos*D)*4
	sp := float(pos) / float(rscale)
	h := 0
	while h < NH {
		bb := h * HD
		i := 0
		while i < HALF {
			ang := sp * peek_f32(rinv, i*4)
			c := cos(ang)
			s := sin(ang)
			q0 := peek_f32(qbase, (bb+i)*4)
			q1 := peek_f32(qbase, (bb+i+HALF)*4)
			poke_f32(qbase, (bb+i)*4, q0*c - q1*s)
			poke_f32(qbase, (bb+i+HALF)*4, q1*c + q0*s)
			k0 := peek_f32(kbase, (bb+i)*4)
			k1 := peek_f32(kbase, (bb+i+HALF)*4)
			poke_f32(kbase, (bb+i)*4, k0*c - k1*s)
			poke_f32(kbase, (bb+i+HALF)*4, k1*c + k0*s)
			i = i + 1
		}
		h = h + 1
	}
}

func attn_head(l, pos, h, att2) {
	loff := l * SEQ * D
	qh := qb + h*HD*4
	t := 0
	while t <= pos {
		kt := kcache + (loff + t*D + h*HD)*4
		poke_f32(att2, t*4, dot_f32(qh, kt, HD) / sqrt(float(HD)))
		t = t + 1
	}
	softmax(att2, pos+1)
	ah := attn + h*HD*4
	j := 0
	while j < HD { poke_f32(ah, j*4, 0.0)  j = j + 1 }
	t = 0
	while t <= pos {
		vt := vcache + (loff + t*D + h*HD)*4
		axpy_f32(ah, peek_f32(att2, t*4), vt, HD)
		t = t + 1
	}
}

func attention(l, pos) {
	loff := l * SEQ * D
	kc := kcache + (loff + pos*D)*4
	vc := vcache + (loff + pos*D)*4
	i := 0
	while i < D { poke_f32(kc, i*4, peek_f32(kb, i*4))  poke_f32(vc, i*4, peek_f32(vb, i*4))  i = i + 1 }
	dispatch_rows(3, l, pos, NH)
	barrier()
}

func rope(vec) {
	h := 0
	while h < NH {
		b := h * HD
		i := 0
		while i < HALF {
			c := peek_f32(rcos, i*4)
			s := peek_f32(rsin, i*4)
			a := peek_f32(vec, (b+i)*4)
			bb := peek_f32(vec, (b+i+HALF)*4)
			poke_f32(vec, (b+i)*4, a*c - bb*s)
			poke_f32(vec, (b+i+HALF)*4, bb*c + a*s)
			i = i + 1
		}
		h = h + 1
	}
}

func softmax(p, n) {
	mx := peek_f32(p, 0)
	i := 1
	while i < n { v := peek_f32(p, i*4)  if v > mx { mx = v }  i = i + 1 }
	sm := 0.0
	i = 0
	while i < n { e := exp(peek_f32(p, i*4) - mx)  poke_f32(p, i*4, e)  sm = sm + e  i = i + 1 }
	i = 0
	while i < n { poke_f32(p, i*4, peek_f32(p, i*4) / sm)  i = i + 1 }
}

func ffn(l) {
	fb := ffn_off + l*ffn_stride
	matmul_q8(gbuf, mb + fb, mb + fb + II*D, hb, II, D)                 // gate_proj
	matmul_q8(ubuf, mb + fb + gu, mb + fb + gu + II*D, hb, II, D)       // up_proj
	i := 0
	while i < II {
		g := peek_f32(gbuf, i*4)
		g = g / (1.0 + exp(0.0 - g))
		poke_f32(gbuf, i*4, g * peek_f32(ubuf, i*4))
		i = i + 1
	}
	matmul_q8(ffn_out, mb + fb + 2*gu, mb + fb + 2*gu + D*II, gbuf, D, II)  // down_proj
}

func forward(tok, pos) (best) {
	sp := float(pos) / float(rscale)
	i := 0
	while i < HALF {
		ang := sp * peek_f32(rinv, i*4)
		poke_f32(rcos, i*4, cos(ang))
		poke_f32(rsin, i*4, sin(ang))
		i = i + 1
	}
	i = 0
	while i < D { poke_f32(xx, i*4, peek_f32(mb, embed_off + (tok*D + i)*4))  i = i + 1 }
	l := 0
	while l < L {
		nb := norms_off + l*(2*D*4)
		rmsnorm(hb, xx, nb, D)
		ab := attn_off + l*attn_stride
		matmul_q8(qb, mb + ab, mb + ab + D*D, hb, D, D)
		matmul_q8(kb, mb + ab + blk_attn, mb + ab + blk_attn + D*D, hb, D, D)
		matmul_q8(vb, mb + ab + 2*blk_attn, mb + ab + 2*blk_attn + D*D, hb, D, D)
		rope(qb)  rope(kb)
		attention(l, pos)
		matmul_q8(hb, mb + ab + 3*blk_attn, mb + ab + 3*blk_attn + D*D, attn, D, D)
		i = 0
		while i < D { poke_f32(xx, i*4, peek_f32(xx, i*4) + peek_f32(hb, i*4))  i = i + 1 }
		rmsnorm(hb, xx, nb + D*4, D)
		ffn(l)
		i = 0
		while i < D { poke_f32(xx, i*4, peek_f32(xx, i*4) + peek_f32(ffn_out, i*4))  i = i + 1 }
		l = l + 1
	}
	return classify()
}

// final rmsnorm(xx) + lm_head + argmax
func classify() (best) {
	rmsnorm(hb, xx, fnorm_off, D)
	if lmbits == 8 {
		matmul_q8(logits, mb + lmhead_off, mb + lmhead_off + VOCAB*D, hb, VOCAB, D)
	} else {
		gj_wf = lmhead_off
		dispatch_rows(2, 0, 0, VOCAB)
		barrier()
	}
	bi := 0
	bv := peek_f32(logits, 0)
	i := 1
	while i < VOCAB { v := peek_f32(logits, i*4)  if v > bv { bv = v  bi = i }  i = i + 1 }
	return bi
}

func embed_to(token, dst) {
	i := 0
	while i < D { poke_f32(dst, i*4, peek_f32(mb, embed_off + (token*D + i)*4))  i = i + 1 }
}

// common prefix length of cached prompt vs the new prompt (KV cache persists)
func cache_common(prompt, np) (l) {
	l = 0
	n := np
	if cache_len < n { n = cache_len }
	while l < n {
		if peek_i32(cache_buf, l*4) != prompt[l] { return }
		l = l + 1
	}
	return
}

// one batched forward over pb_B positions at [pb_tstart, ..): weights read once
// per tile; leaves KV written and the LAST position's hidden in pb_x.
func batch_layers(B) {
	l := 0
	while l < L {
		dispatch_rows(19, l, 0, B)  barrier()        // in_ln rmsnorm + quant
		dispatch_rows(11, l, 0, D)  barrier()        // Q
		dispatch_rows(12, l, 0, D)  barrier()        // K -> cache
		dispatch_rows(13, l, 0, D)  barrier()        // V -> cache
		dispatch_rows(25, l, 0, B)  barrier()        // rope (q + cached K)
		dispatch_rows(18, l, 0, B * NH)  barrier()   // attention -> pb_xb
		dispatch_rows(21, l, 0, B)  barrier()        // quant attn out
		dispatch_rows(14, l, 0, D)  barrier()        // O -> pb_xb2
		dispatch_rows(22, l, 0, B)  barrier()        // residual
		dispatch_rows(20, l, 0, B)  barrier()        // post_ln rmsnorm + quant
		dispatch_rows(15, l, 0, II)  barrier()       // gate
		dispatch_rows(16, l, 0, II)  barrier()       // up
		dispatch_rows(23, l, 0, B)  barrier()        // silu*up + quant
		dispatch_rows(17, l, 0, D)  barrier()        // down -> pb_xb
		dispatch_rows(24, l, 0, B)  barrier()        // residual
		l = l + 1
	}
}

// batched prefill of positions [start, np); leaves xx = last position's hidden
func prefill_batch(prompt, start, np) {
	ts := start
	while ts < np {
		te := ts + pb_tile
		if te > np { te = np }
		B := te - ts
		pb_B = B
		pb_tstart = ts
		b := 0
		while b < B { embed_to(prompt[ts+b], pb_x + b*D*4)  b = b + 1 }
		batch_layers(B)
		if te == np {
			i := 0
			while i < D { poke_f32(xx, i*4, peek_f32(pb_x + (B-1)*D*4, i*4))  i = i + 1 }
		}
		ts = te
	}
}

func xlam_init(path) {
	tl := parse_int(env("COLIBRI_TILE"))
	if tl > 0 { pb_tile = tl }              // must be set before alloc sizes the tile buffers
	if parse_int(env("COLIBRI_NOBATCH")) == 1 { pb_enabled = 0 }
	load_xlam(path)
	alloc_xlam()
	nw := parse_int(env("COLIBRI_THREADS"))
	if nw > 0 { n_workers = nw } else { n_workers = 6 }
	w := 0
	while w < n_workers { go worker(jobs, done)  w = w + 1 }
}

// greedy generate; prefix-cache the shared prompt prefix + batched-prefill the
// rest (weights read once per tile), then single-token decode. Stop at eos(32021).
func gen_ids(prompt, np, max_new) (out) {
	out = []int{}
	if np > SEQ - 2 { np = SEQ - 2 }
	start := cache_common(prompt, np)
	cur := 0
	if np - start >= 16 && pb_enabled == 1 {
		prefill_batch(prompt, start, np)      // KV for [start,np), xx = last hidden
		cur = classify()                      // first generated token (for position np)
	} else {
		pos := start
		while pos < np - 1 { forward(prompt[pos], pos)  pos = pos + 1 }
		cur = forward(prompt[np-1], np-1)
	}
	i := 0
	while i < np { poke_i32(cache_buf, i*4, prompt[i])  i = i + 1 }
	cache_len = np
	pos := np
	i = 0
	while i < max_new && pos < SEQ - 1 {
		if cur == 32021 { break }
		out = append(out, cur)
		cur = forward(cur, pos)               // writes cur's KV at pos, predicts pos+1
		pos = pos + 1
		i = i + 1
	}
	return
}
