// Pure-MFL Qwen2.5-1.5B-Instruct inference: GQA (12/2), QKV bias, tied
// embeddings (lm_head = embed), rotate_half RoPE theta 1e6 (native 32k, no
// scaling), no qk-norm, SwiGLU FFN. int8 Q8_0 matmuls + batched prefill + KV
// prefix cache + worker pool + madvise idle-release.

var mb = 0
var model_bytes = 0
var D = 0
var NH = 0
var NKV = 0
var HD = 0
var II = 0
var L = 0
var VOCAB = 0
var SEQ = 0
var GS = 0
var theta = 1000000
var KV = 0
var KVMUL = 0
var HALF = 0
var qblk = 0
var QD = 0        // NH*HD (attention inner dim; == D only when head_dim*heads == hidden)
var kvblk = 0
var attn_stride = 0
var gu = 0
var ffn_stride = 0
var embed_off = 0
var embed_soff = 0
var norms_off = 0
var qnorm_stride = 0
var fnorm_off = 0
var attn_off = 0
var ffn_off = 0

var xx = 0
var hb = 0
var qb = 0
var kb = 0
var vb = 0
var attn = 0
var ffn_out = 0
var gbuf = 0
var ubuf = 0
var xqb = 0
var xsb = 0
var att = 0
var logits = 0
var kcache = 0
var vcache = 0
var rinv = 0
var rcos = 0
var rsin = 0

var n_workers = 1
var jobs = make(chan int)
var done = make(chan int)
var pending = 0
var gj_dst = 0
var gj_wq = 0
var gj_ws = 0
var gj_bias = 0
var gj_n = 0

var pb_tile = 256
var pb_enabled = 1
var pb_B = 0
var pb_tstart = 0

// ---- speculative decode (prompt-lookup / n-gram draft, greedy verify) ----
// The target decodes greedily (argmax), so greedy speculative decode is
// byte-identical to plain decode -- a pure, correctness-preserving speedup.
var spec_k = 0            // draft width; 0 = disabled (COLIBRI_SPEC)
var spec_ng = 3           // n-gram key length for prompt-lookup
var SPEC_MAX = 16
var spec_logits = 0       // (SPEC_MAX+1) * VOCAB floats: batched verify logits
var spec_seq = 0          // full token sequence (prompt+generated) for lookup
var spec_slen = 0
var spec_dbuf = 0         // (SPEC_MAX+1) ints: [cur, draft0..draftK-1] verify inputs
var spec_pred = 0         // (SPEC_MAX+1) ints: target argmax per verify position
var spec_st_steps = 0     // instrumentation: verify calls, tokens drafted, accepted
var spec_st_draft = 0
var spec_st_accept = 0
var spec_t_fwd = 0
var spec_t_lm = 0
var spec_t_arg = 0
var spec_stats = 0
var pb_x = 0
var pb_xb = 0
var pb_xb2 = 0
var pb_q = 0
var pb_hb = 0
var pb_hb2 = 0
var pb_xq = 0
var pb_xqs = 0
var pb_hq = 0
var pb_hqs = 0
var cache_buf = 0
var cache_len = 0

func load_qwen(path) {
	m, sz := mmap_file(path)
	mb = m
	model_bytes = sz
	if peek_i32(mb, 0) != 1634423091 { println("bad magic")  flush() }  // 0x616B5133 akQ3
	D = peek_i32(mb, 4)
	NH = peek_i32(mb, 8)
	NKV = peek_i32(mb, 12)
	HD = peek_i32(mb, 16)
	II = peek_i32(mb, 20)
	L = peek_i32(mb, 24)
	VOCAB = peek_i32(mb, 28)
	SEQ = peek_i32(mb, 32)
	GS = peek_i32(mb, 36)
	theta = peek_i32(mb, 40)
	embed_off = peek_i32(mb, 48)
	norms_off = peek_i32(mb, 52)
	fnorm_off = peek_i32(mb, 56)
	attn_off = peek_i32(mb, 60)
	ffn_off = peek_i32(mb, 64)
	KV = NKV * HD
	KVMUL = NH / NKV
	HALF = HD / 2
	embed_soff = embed_off + VOCAB*D/2   // int8 embed scales (tied lm_head)
	QD = NH * HD
	qblk = QD*D/2 + 4*((QD*D)/GS)
	kvblk = KV*D/2 + 4*((KV*D)/GS)
	attn_stride = 2*qblk + 2*kvblk
	gu = II*D/2 + 4*((II*D)/GS)
	ffn_stride = 3 * gu
	qnorm_stride = (2*D + 2*HD) * 4   // in_ln, post_ln, q_norm[HD], k_norm[HD]
}

func alloc_qwen() {
	xx = alloc(D*4)  hb = alloc(D*4)  qb = alloc(QD*4)  kb = alloc(KV*4)  vb = alloc(KV*4)
	attn = alloc(QD*4)  ffn_out = alloc(D*4)
	gbuf = alloc(II*4)  ubuf = alloc(II*4)
	mx := D
	if II > mx { mx = II }
	xqb = alloc(mx)  xsb = alloc((mx/GS)*4)
	att = alloc(SEQ*4)  logits = alloc(VOCAB*4)
	kcache = alloc(L*SEQ*KV*4)  vcache = alloc(L*SEQ*KV*4)
	rinv = alloc(HALF*4)  rcos = alloc(HALF*4)  rsin = alloc(HALF*4)
	cache_buf = alloc(SEQ*4)
	t := pb_tile
	pb_x = alloc(t*D*4)  pb_xb = alloc(t*QD*4)  pb_xb2 = alloc(t*D*4)  pb_q = alloc(t*QD*4)
	pb_hb = alloc(t*II*4)  pb_hb2 = alloc(t*II*4)
	pb_xq = alloc(t*QD)  pb_xqs = alloc(t*(QD/GS)*4)
	pb_hq = alloc(t*II)  pb_hqs = alloc(t*(II/GS)*4)
	spec_logits = alloc((SPEC_MAX+1)*VOCAB*4)  spec_seq = alloc(SEQ*4)
	spec_dbuf = alloc((SPEC_MAX+1)*4)  spec_pred = alloc((SPEC_MAX+1)*4)
	lnth := log(float(theta))
	i := 0
	while i < HALF {
		poke_f32(rinv, i*4, exp(0.0 - (float(i)/float(HALF)) * lnth))
		i = i + 1
	}
}

func rmsnorm(dst, src, woff, n) {
	ss := 0.0
	i := 0
	while i < n { v := peek_f32(src, i*4)  ss = ss + v*v  i = i + 1 }
	ss = 1.0 / sqrt(ss/float(n) + 0.000001)
	i = 0
	while i < n { poke_f32(dst, i*4, peek_f32(src, i*4) * ss * peek_f32(mb, woff + i*4))  i = i + 1 }
}

// rmsnorm a single head slice [buf..buf+n) over n with weight at woff
func rmsnorm_head(buf, woff, n) {
	ss := 0.0
	i := 0
	while i < n { v := peek_f32(buf, i*4)  ss = ss + v*v  i = i + 1 }
	ss = 1.0 / sqrt(ss/float(n) + 0.000001)
	i = 0
	while i < n { poke_f32(buf, i*4, peek_f32(buf, i*4) * ss * peek_f32(mb, woff + i*4))  i = i + 1 }
}

// per-head qk-norm (single-token): qb (NH heads) with q_norm, kb (NKV) with k_norm
func qknorm(qnoff) {
	h := 0
	while h < NH { rmsnorm_head(qb + h*HD*4, qnoff, HD)  h = h + 1 }
	h = 0
	while h < NKV { rmsnorm_head(kb + h*HD*4, qnoff + HD*4, HD)  h = h + 1 }
}

func quantize_act(xq, xs, x, n) {
	ng := n / GS
	g := 0
	while g < ng {
		base := g * GS
		wmax := 0.0
		i := 0
		while i < GS { v := abs(peek_f32(x, (base+i)*4))  if v > wmax { wmax = v }  i = i + 1 }
		scale := wmax / 127.0
		poke_f32(xs, g*4, scale)
		i = 0
		while i < GS {
			q := 0
			if scale > 0.0 { q = int(round(peek_f32(x, (base+i)*4) / scale)) }
			poke_u8(xq, base+i, q & 255)
			i = i + 1
		}
		g = g + 1
	}
}

func do_job(j, att2) {
	t := j & 31
	l := (j >> 5) & 255
	pos := (j >> 13) & 4095
	lo := (j >> 25) & 524287
	hi := j >> 44
	if t == 1 {
		nsc := gj_n / GS
		o := lo
		while o < hi {
			v := dot_q4(xqb, xsb, gj_wq + o*(gj_n/2), gj_ws + o*nsc*4, gj_n, GS)
			if gj_bias > 0 { v = v + peek_f32(gj_bias, o*4) }
			poke_f32(gj_dst, o*4, v)
			o = o + 1
		}
	}
	if t == 2 {   // tied int8 lm_head: logits[o] = embed_int8[o,:] . hb(quantized)
		nsc := D / GS
		o := lo
		while o < hi { poke_f32(logits, o*4, dot_q4(xqb, xsb, mb + embed_off + o*(D/2), mb + embed_soff + o*nsc*4, D, GS))  o = o + 1 }
	}
	if t == 3 {
		h := lo
		while h < hi { attn_head(l, pos, h, att2)  h = h + 1 }
	}
	// ---- batched prefill ----
	if t == 11 { ab := attn_off + l*attn_stride  matmul_q_batch(pb_q, QD, pb_xq, pb_xqs, mb + ab, mb + ab + QD*D/2, 0, D, lo, hi, pb_B) }
	if t == 12 { ab := attn_off + l*attn_stride  matmul_q_batch(kcache + (l*SEQ*KV + pb_tstart*KV)*4, KV, pb_xq, pb_xqs, mb + ab + qblk, mb + ab + qblk + KV*D/2, 0, D, lo, hi, pb_B) }
	if t == 13 { ab := attn_off + l*attn_stride  matmul_q_batch(vcache + (l*SEQ*KV + pb_tstart*KV)*4, KV, pb_xq, pb_xqs, mb + ab + qblk + kvblk, mb + ab + qblk + kvblk + KV*D/2, 0, D, lo, hi, pb_B) }
	if t == 14 { ab := attn_off + l*attn_stride  matmul_q_batch(pb_xb2, D, pb_xq, pb_xqs, mb + ab + qblk + 2*kvblk, mb + ab + qblk + 2*kvblk + D*QD/2, 0, QD, lo, hi, pb_B) }
	if t == 15 { fb := ffn_off + l*ffn_stride  matmul_q_batch(pb_hb, II, pb_xq, pb_xqs, mb + fb, mb + fb + II*D/2, 0, D, lo, hi, pb_B) }
	if t == 16 { fb := ffn_off + l*ffn_stride  matmul_q_batch(pb_hb2, II, pb_xq, pb_xqs, mb + fb + gu, mb + fb + gu + II*D/2, 0, D, lo, hi, pb_B) }
	if t == 17 { fb := ffn_off + l*ffn_stride  matmul_q_batch(pb_xb, D, pb_hq, pb_hqs, mb + fb + 2*gu, mb + fb + 2*gu + D*II/2, 0, II, lo, hi, pb_B) }
	if t == 18 {
		u := lo
		while u < hi {
			b := u / NH
			h := u % NH
			attn_head_at(h, l, pb_tstart + b, pb_q + b*QD*4, pb_xb + b*QD*4, att2)
			u = u + 1
		}
	}
	if t == 19 { nb := norms_off + l*qnorm_stride  b := lo  while b < hi { rmsnorm(pb_xb + b*D*4, pb_x + b*D*4, nb, D)  quantize_act(pb_xq + b*D, pb_xqs + b*(D/GS)*4, pb_xb + b*D*4, D)  b = b + 1 } }
	if t == 20 { nb := norms_off + l*qnorm_stride + D*4  b := lo  while b < hi { rmsnorm(pb_xb + b*D*4, pb_x + b*D*4, nb, D)  quantize_act(pb_xq + b*D, pb_xqs + b*(D/GS)*4, pb_xb + b*D*4, D)  b = b + 1 } }
	if t == 21 { b := lo  while b < hi { quantize_act(pb_xq + b*QD, pb_xqs + b*(QD/GS)*4, pb_xb + b*QD*4, QD)  b = b + 1 } }
	if t == 22 { b := lo  while b < hi { i := 0  while i < D { poke_f32(pb_x + b*D*4, i*4, peek_f32(pb_x + b*D*4, i*4) + peek_f32(pb_xb2 + b*D*4, i*4))  i = i + 1 }  b = b + 1 } }
	if t == 23 {
		b := lo
		while b < hi {
			i := 0
			while i < II {
				v := peek_f32(pb_hb + b*II*4, i*4)
				v = v / (1.0 + exp(0.0 - v))
				poke_f32(pb_hb + b*II*4, i*4, v * peek_f32(pb_hb2 + b*II*4, i*4))
				i = i + 1
			}
			quantize_act(pb_hq + b*II, pb_hqs + b*(II/GS)*4, pb_hb + b*II*4, II)
			b = b + 1
		}
	}
	if t == 24 { b := lo  while b < hi { i := 0  while i < D { poke_f32(pb_x + b*D*4, i*4, peek_f32(pb_x + b*D*4, i*4) + peek_f32(pb_xb + b*D*4, i*4))  i = i + 1 }  b = b + 1 } }
	if t == 25 { b := lo  while b < hi { rope_at(l, pb_tstart + b, pb_q + b*QD*4)  b = b + 1 } }
	if t == 26 {   // batched tied lm_head, TRANSPOSED output spec_logits[i*B + b]: embed row read
		nsc := D / GS   // once (hot in L1) + B contiguous writes per row (no scattered stride-VOCAB writes)
		i := lo
		while i < hi {
			wq := mb + embed_off + i*(D/2)
			ws := mb + embed_soff + i*nsc*4
			b := 0
			while b < pb_B {
				poke_f32(spec_logits, (i*pb_B + b)*4, dot_q4(pb_xq + b*D, pb_xqs + b*nsc*4, wq, ws, D, GS))
				b = b + 1
			}
			i = i + 1
		}
	}
	if t == 27 {   // parallel per-position argmax over spec_logits[i*B + b] (stride B)
		b := lo
		while b < hi {
			bi := 0
			bv := peek_f32(spec_logits, b*4)
			i := 1
			while i < VOCAB { v := peek_f32(spec_logits, (i*pb_B + b)*4)  if v > bv { bv = v  bi = i }  i = i + 1 }
			poke_i32(spec_pred, b*4, bi)
			b = b + 1
		}
	}
}

func worker(jc, dc) {
	att2 := alloc(SEQ * 4)
	for j := range jc {
		do_job(j, att2)
		dc <- 1
	}
}

func dispatch_rows(t, l, pos, d) {
	nc := n_workers
	if nc > d { nc = d }
	chunk := (d + nc - 1) / nc
	lo := 0
	while lo < d {
		hi := lo + chunk
		if hi > d { hi = d }
		if pending >= n_workers { <-done  pending = pending - 1 }
		jobs <- (t | l << 5 | pos << 13 | lo << 25 | hi << 44)
		pending = pending + 1
		lo = hi
	}
}

func barrier() {
	while pending > 0 { <-done  pending = pending - 1 }
}

// single-token int8 matmul with optional bias (bias=0 -> none)
func matmul_q8(dst, wq, ws, bias, x, out, inn) {
	quantize_act(xqb, xsb, x, inn)
	gj_dst = dst  gj_wq = wq  gj_ws = ws  gj_bias = bias  gj_n = inn
	dispatch_rows(1, 0, 0, out)
	barrier()
}

// batched matmul via the machin core builtin (weight row loaded once, reused
// across B positions) + optional per-row bias added after.
func matmul_q_batch(ob, ostride, xqb2, xsb2, wq, ws, bias, n, lo, hi, B) {
	matmul_q4_batch(ob, ostride, xqb2, xsb2, wq, ws, n, GS, B, lo, hi)
	if bias > 0 {
		i := lo
		while i < hi {
			bv := peek_f32(bias, i*4)
			b := 0
			while b < B { poke_f32(ob, (b*ostride + i)*4, peek_f32(ob, (b*ostride + i)*4) + bv)  b = b + 1 }
			i = i + 1
		}
	}
}

// GQA attention for (head, position): head h uses kv head h/KVMUL
func attn_head(l, pos, h, att2) {
	loff := l * SEQ * KV
	kvh := (h / KVMUL) * HD
	qh := qb + h*HD*4
	t := 0
	while t <= pos {
		kt := kcache + (loff + t*KV + kvh)*4
		poke_f32(att2, t*4, dot_f32(qh, kt, HD) / sqrt(float(HD)))
		t = t + 1
	}
	softmax(att2, pos + 1)
	ah := attn + h*HD*4
	j := 0
	while j < HD { poke_f32(ah, j*4, 0.0)  j = j + 1 }
	t = 0
	while t <= pos {
		vt := vcache + (loff + t*KV + kvh)*4
		axpy_f32(ah, peek_f32(att2, t*4), vt, HD)
		t = t + 1
	}
}

func attn_head_at(h, l, pos, qbase, obase, att2) {
	loff := l * SEQ * KV
	kvh := (h / KVMUL) * HD
	qh := qbase + h*HD*4
	t := 0
	while t <= pos {
		kt := kcache + (loff + t*KV + kvh)*4
		poke_f32(att2, t*4, dot_f32(qh, kt, HD) / sqrt(float(HD)))
		t = t + 1
	}
	softmax(att2, pos + 1)
	xbh := obase + h*HD*4
	j := 0
	while j < HD { poke_f32(xbh, j*4, 0.0)  j = j + 1 }
	t = 0
	while t <= pos {
		vt := vcache + (loff + t*KV + kvh)*4
		axpy_f32(xbh, peek_f32(att2, t*4), vt, HD)
		t = t + 1
	}
}

func attention(l, pos) {
	loff := l * SEQ * KV
	kc := kcache + (loff + pos*KV)*4
	vc := vcache + (loff + pos*KV)*4
	i := 0
	while i < KV { poke_f32(kc, i*4, peek_f32(kb, i*4))  poke_f32(vc, i*4, peek_f32(vb, i*4))  i = i + 1 }
	dispatch_rows(3, l, pos, NH)
	barrier()
}

// rope q (NH heads at qbase) + the K in cache (NKV heads) at pos; theta 1e6, no scaling
func rope_at(l, pos, qbase) {
	loff := l * SEQ * KV
	kbase := kcache + (loff + pos*KV)*4
	qnoff := norms_off + l*qnorm_stride + 2*D*4
	h2 := 0
	while h2 < NH { rmsnorm_head(qbase + h2*HD*4, qnoff, HD)  h2 = h2 + 1 }
	h2 = 0
	while h2 < NKV { rmsnorm_head(kbase + h2*HD*4, qnoff + HD*4, HD)  h2 = h2 + 1 }
	sp := float(pos)
	h := 0
	while h < NH {
		bb := h * HD
		i := 0
		while i < HALF {
			ang := sp * peek_f32(rinv, i*4)
			c := cos(ang)
			s := sin(ang)
			q0 := peek_f32(qbase, (bb+i)*4)
			q1 := peek_f32(qbase, (bb+i+HALF)*4)
			poke_f32(qbase, (bb+i)*4, q0*c - q1*s)
			poke_f32(qbase, (bb+i+HALF)*4, q1*c + q0*s)
			if h < NKV {
				k0 := peek_f32(kbase, (bb+i)*4)
				k1 := peek_f32(kbase, (bb+i+HALF)*4)
				poke_f32(kbase, (bb+i)*4, k0*c - k1*s)
				poke_f32(kbase, (bb+i+HALF)*4, k1*c + k0*s)
			}
			i = i + 1
		}
		h = h + 1
	}
}

// single-token rope: q (NH) at qb, k (NKV) at kb — both pre-cache
func rope_qk(pos) {
	sp := float(pos)
	h := 0
	while h < NH {
		bb := h * HD
		i := 0
		while i < HALF {
			ang := sp * peek_f32(rinv, i*4)
			c := cos(ang)
			s := sin(ang)
			q0 := peek_f32(qb, (bb+i)*4)
			q1 := peek_f32(qb, (bb+i+HALF)*4)
			poke_f32(qb, (bb+i)*4, q0*c - q1*s)
			poke_f32(qb, (bb+i+HALF)*4, q1*c + q0*s)
			if h < NKV {
				k0 := peek_f32(kb, (bb+i)*4)
				k1 := peek_f32(kb, (bb+i+HALF)*4)
				poke_f32(kb, (bb+i)*4, k0*c - k1*s)
				poke_f32(kb, (bb+i+HALF)*4, k1*c + k0*s)
			}
			i = i + 1
		}
		h = h + 1
	}
}

func softmax(p, n) {
	mx := peek_f32(p, 0)
	i := 1
	while i < n { v := peek_f32(p, i*4)  if v > mx { mx = v }  i = i + 1 }
	sm := 0.0
	i = 0
	while i < n { e := exp(peek_f32(p, i*4) - mx)  poke_f32(p, i*4, e)  sm = sm + e  i = i + 1 }
	i = 0
	while i < n { poke_f32(p, i*4, peek_f32(p, i*4) / sm)  i = i + 1 }
}

func ffn(l) {
	fb := ffn_off + l*ffn_stride
	matmul_q8(gbuf, mb + fb, mb + fb + II*D/2, 0, hb, II, D)
	matmul_q8(ubuf, mb + fb + gu, mb + fb + gu + II*D/2, 0, hb, II, D)
	i := 0
	while i < II {
		g := peek_f32(gbuf, i*4)
		g = g / (1.0 + exp(0.0 - g))
		poke_f32(gbuf, i*4, g * peek_f32(ubuf, i*4))
		i = i + 1
	}
	matmul_q8(ffn_out, mb + fb + 2*gu, mb + fb + 2*gu + D*II/2, 0, gbuf, D, II)
}

// dequantize int8 embed row `token` into dst
func embed_row(token, dst) {   // Q4 split-nibble dequant of embed row `token`
	gsD := D / GS
	half := GS / 2
	rowb := embed_off + token*(D/2)
	g := 0
	while g < gsD {
		sc := peek_f32(mb, embed_soff + (token*gsD + g)*4)
		k := 0
		while k < half {
			b := peek_u8(mb, rowb + g*half + k)
			poke_f32(dst, (g*GS + k)*4, float((b % 16) - 8) * sc)
			poke_f32(dst, (g*GS + k + half)*4, float((b / 16) - 8) * sc)
			k = k + 1
		}
		g = g + 1
	}
}

func forward(tok, pos) (best) {
	embed_row(tok, xx)
	i := 0
	l := 0
	while l < L {
		nb := norms_off + l*qnorm_stride
		rmsnorm(hb, xx, nb, D)
		ab := attn_off + l*attn_stride
		matmul_q8(qb, mb + ab, mb + ab + QD*D/2, 0, hb, QD, D)
		matmul_q8(kb, mb + ab + qblk, mb + ab + qblk + KV*D/2, 0, hb, KV, D)
		matmul_q8(vb, mb + ab + qblk + kvblk, mb + ab + qblk + kvblk + KV*D/2, 0, hb, KV, D)
		qknorm(nb + 2*D*4)
		rope_qk(pos)
		attention(l, pos)
		matmul_q8(hb, mb + ab + qblk + 2*kvblk, mb + ab + qblk + 2*kvblk + D*QD/2, 0, attn, D, QD)
		i = 0
		while i < D { poke_f32(xx, i*4, peek_f32(xx, i*4) + peek_f32(hb, i*4))  i = i + 1 }
		rmsnorm(hb, xx, nb + D*4, D)
		ffn(l)
		i = 0
		while i < D { poke_f32(xx, i*4, peek_f32(xx, i*4) + peek_f32(ffn_out, i*4))  i = i + 1 }
		l = l + 1
	}
	return classify()
}

func classify() (best) {
	rmsnorm(hb, xx, fnorm_off, D)
	quantize_act(xqb, xsb, hb, D)
	dispatch_rows(2, 0, 0, VOCAB)   // tied int8 lm_head
	barrier()
	bi := 0
	bv := peek_f32(logits, 0)
	i := 1
	while i < VOCAB { v := peek_f32(logits, i*4)  if v > bv { bv = v  bi = i }  i = i + 1 }
	return bi
}

func embed_to(token, dst) {
	embed_row(token, dst)
}

func cache_common(prompt, np) (l) {
	l = 0
	n := np
	if cache_len < n { n = cache_len }
	while l < n {
		if peek_i32(cache_buf, l*4) != prompt[l] { return }
		l = l + 1
	}
	return
}

func batch_layers(B) {
	l := 0
	while l < L {
		dispatch_rows(19, l, 0, B)  barrier()
		dispatch_rows(11, l, 0, QD)  barrier()
		dispatch_rows(12, l, 0, KV)  barrier()
		dispatch_rows(13, l, 0, KV)  barrier()
		dispatch_rows(25, l, 0, B)  barrier()
		dispatch_rows(18, l, 0, B * NH)  barrier()
		dispatch_rows(21, l, 0, B)  barrier()
		dispatch_rows(14, l, 0, D)  barrier()
		dispatch_rows(22, l, 0, B)  barrier()
		dispatch_rows(20, l, 0, B)  barrier()
		dispatch_rows(15, l, 0, II)  barrier()
		dispatch_rows(16, l, 0, II)  barrier()
		dispatch_rows(23, l, 0, B)  barrier()
		dispatch_rows(17, l, 0, D)  barrier()
		dispatch_rows(24, l, 0, B)  barrier()
		l = l + 1
	}
}

func prefill_batch(prompt, start, np) {
	ts := start
	while ts < np {
		te := ts + pb_tile
		if te > np { te = np }
		B := te - ts
		pb_B = B
		pb_tstart = ts
		b := 0
		while b < B { embed_to(prompt[ts+b], pb_x + b*D*4)  b = b + 1 }
		batch_layers(B)
		if te == np {
			i := 0
			while i < D { poke_f32(xx, i*4, peek_f32(pb_x + (B-1)*D*4, i*4))  i = i + 1 }
		}
		ts = te
	}
}

func qwen_init(path) {
	tl := parse_int(env("COLIBRI_TILE"))
	if tl > 0 { pb_tile = tl }
	if parse_int(env("COLIBRI_NOBATCH")) == 1 { pb_enabled = 0 }
	load_qwen(path)
	cx := parse_int(env("COLIBRI_CTX"))    // cap KV cache context (fit RAM); 0 = full model ctx
	if cx > 0 && cx < SEQ { SEQ = cx }
	alloc_qwen()
	sk := parse_int(env("COLIBRI_SPEC"))   // speculative draft width (0 = off)
	if sk > 0 { spec_k = sk  if spec_k > SPEC_MAX { spec_k = SPEC_MAX } }
	sn := parse_int(env("COLIBRI_SPEC_NG"))
	if sn > 0 { spec_ng = sn }
	if parse_int(env("COLIBRI_SPEC_STATS")) == 1 { spec_stats = 1 }
	nw := parse_int(env("COLIBRI_THREADS"))
	if nw > 0 { n_workers = nw } else { n_workers = 6 }
	w := 0
	while w < n_workers { go worker(jobs, done)  w = w + 1 }
}

// prompt-lookup draft: key = [spec_seq[pos-ng+1..pos-1], cur]; find its most recent
// earlier occurrence in spec_seq and propose the tokens that followed. Fills
// spec_dbuf[1..k] with the draft (spec_dbuf[0]=cur is set by the caller). k tokens.
func spec_draft(cur, pos) (k) {
	k = 0
	if pos < spec_ng { return }
	cap := spec_k
	if pos + cap + 2 >= SEQ { cap = SEQ - pos - 2 }
	if cap < 1 { return }
	p := pos - spec_ng
	while p >= 0 {
		match := 1
		j := 0
		while j < spec_ng {
			kj := cur
			if j < spec_ng - 1 { kj = peek_i32(spec_seq, (pos - spec_ng + 1 + j)*4) }
			if peek_i32(spec_seq, (p+j)*4) != kj { match = 0  break }
			j = j + 1
		}
		if match == 1 {
			src := p + spec_ng
			while k < cap && src < pos {
				poke_i32(spec_dbuf, (k+1)*4, peek_i32(spec_seq, src*4))
				k = k + 1
				src = src + 1
			}
			return
		}
		p = p - 1
	}
	return
}

// batched greedy verify: run the target over B positions [pos..pos+B-1] with inputs
// spec_dbuf[0..B-1] (causal, reuses KV[0..pos-1], fills KV[pos..pos+B-1]); write the
// per-position argmax into spec_pred[0..B-1]. spec_pred[j] = target's next token given
// prefix ending at input j -> compare vs spec_dbuf[j+1] to accept.
func spec_verify(B, pos) {
	pb_tstart = pos
	pb_B = B
	b := 0
	while b < B { embed_to(peek_i32(spec_dbuf, b*4), pb_x + b*D*4)  b = b + 1 }
	ta := now_ms()
	batch_layers(B)
	tb := now_ms()
	b = 0
	while b < B {
		rmsnorm(pb_xb + b*D*4, pb_x + b*D*4, fnorm_off, D)
		quantize_act(pb_xq + b*D, pb_xqs + b*(D/GS)*4, pb_xb + b*D*4, D)
		b = b + 1
	}
	dispatch_rows(26, 0, 0, VOCAB)  barrier()   // batched lm_head
	tc := now_ms()
	dispatch_rows(27, 0, 0, B)  barrier()       // parallel per-position argmax -> spec_pred
	td := now_ms()
	spec_t_fwd = spec_t_fwd + (tb - ta)
	spec_t_lm = spec_t_lm + (tc - tb)
	spec_t_arg = spec_t_arg + (td - tc)
}

// greedy generate with prefix cache + batched prefill; emit(token) streams pieces
// (emit=0 -> buffered). stop at eos(151645 <|im_end|>) or max_new.
func gen_stream(prompt, np, max_new, emit) (out) {
	out = []int{}
	if np > SEQ - 2 { np = SEQ - 2 }
	start := cache_common(prompt, np)
	cur := 0
	if np - start >= 16 && pb_enabled == 1 {
		prefill_batch(prompt, start, np)
		cur = classify()
	} else {
		pos := start
		while pos < np - 1 { forward(prompt[pos], pos)  pos = pos + 1 }
		cur = forward(prompt[np-1], np-1)
	}
	i := 0
	while i < np { poke_i32(cache_buf, i*4, prompt[i])  poke_i32(spec_seq, i*4, prompt[i])  i = i + 1 }
	cache_len = np
	spec_slen = np
	pos := np
	produced := 0
	while produced < max_new && pos < SEQ - 1 {
		if cur == 151645 || cur == 151643 { break }   // <|im_end|> / <|endoftext|>
		k := 0
		if spec_k > 0 { poke_i32(spec_dbuf, 0, cur)  k = spec_draft(cur, pos) }
		if k == 0 {
			out = append(out, cur)
			emit(cur)
			poke_i32(spec_seq, pos*4, cur)
			spec_slen = pos + 1
			cur = forward(cur, pos)
			pos = pos + 1
			produced = produced + 1
		} else {
			spec_verify(k + 1, pos)          // fills KV[pos..pos+k], spec_pred[0..k]
			m := 0                            // longest accepted draft prefix
			while m < k {
				if peek_i32(spec_dbuf, (m+1)*4) != peek_i32(spec_pred, m*4) { break }
				m = m + 1
			}
			spec_st_steps = spec_st_steps + 1
			spec_st_draft = spec_st_draft + k
			spec_st_accept = spec_st_accept + m
			stop := 0                         // emit confirmed run [cur, draft0..draft(m-1)]
			j := 0
			while j <= m {
				tk := peek_i32(spec_dbuf, j*4)
				if tk == 151645 || tk == 151643 { stop = 1  break }
				if produced >= max_new { stop = 1  break }
				out = append(out, tk)
				emit(tk)
				poke_i32(spec_seq, (pos+j)*4, tk)
				produced = produced + 1
				j = j + 1
			}
			spec_slen = pos + j
			if stop == 1 { break }
			cur = peek_i32(spec_pred, m*4)   // correction = target argmax at divergence (free token)
			pos = pos + m + 1
		}
	}
	if spec_k > 0 && spec_stats == 1 { println("SPEC stats: steps=" + str(spec_st_steps) + " drafted=" + str(spec_st_draft) + " accepted=" + str(spec_st_accept) + " produced=" + str(produced) + " | fwd=" + str(spec_t_fwd) + "ms lm=" + str(spec_t_lm) + "ms arg=" + str(spec_t_arg) + "ms")  flush() }
	return
}

// persist the warmed KV cache to disk (kcache/vcache buffers + a meta of the
// prefix ids) so a restart can skip the boot prefill. base -> base.k/.v/.meta
func save_kv(base) {
	kb2 := L*SEQ*KV*4
	write_file_raw(base + ".k", kcache, kb2)
	write_file_raw(base + ".v", vcache, kb2)
	meta := alloc((4 + cache_len) * 4)
	poke_i32(meta, 0, cache_len)  poke_i32(meta, 4, L)  poke_i32(meta, 8, SEQ)  poke_i32(meta, 12, KV)
	i := 0
	while i < cache_len { poke_i32(meta, (4+i)*4, peek_i32(cache_buf, i*4))  i = i + 1 }
	write_file_raw(base + ".meta", meta, (4 + cache_len)*4)
	free(meta)
}

// load a saved KV snapshot IFF it matches the current prefix ids + dims.
func load_kv(base, wids, wn) (ok) {
	ok = 0
	meta := alloc((4 + wn) * 4)
	rm := read_file_raw(base + ".meta", meta, (4 + wn)*4)
	if rm < 16 { free(meta)  return }
	cl := peek_i32(meta, 0)
	if peek_i32(meta, 4) != L || peek_i32(meta, 8) != SEQ || peek_i32(meta, 12) != KV || cl != wn { free(meta)  return }
	i := 0
	while i < cl { if peek_i32(meta, (4+i)*4) != wids[i] { free(meta)  return }  i = i + 1 }
	free(meta)
	kb2 := L*SEQ*KV*4
	if read_file_raw(base + ".k", kcache, kb2) < 1 { return }
	if read_file_raw(base + ".v", vcache, kb2) < 1 { return }
	i = 0
	while i < cl { poke_i32(cache_buf, i*4, wids[i])  i = i + 1 }
	cache_len = cl
	ok = 1
	return
}

// warm the prefix cache: prefill `prompt` into KV without generating, so later
// requests sharing this prefix skip it entirely. For a fixed agentic system
// prompt, call this once at boot -> every request (incl. the first) is warm.
func warm(prompt, np) {
	if np > SEQ - 2 { np = SEQ - 2 }
	if np < 1 { return }
	if np >= 16 && pb_enabled == 1 {
		prefill_batch(prompt, 0, np)
	} else {
		pos := 0
		while pos < np { forward(prompt[pos], pos)  pos = pos + 1 }
	}
	i := 0
	while i < np { poke_i32(cache_buf, i*4, prompt[i])  i = i + 1 }
	cache_len = np
}

func gen_ids(prompt, np, max_new) (out) {
	out = gen_stream(prompt, np, max_new, func(tid) { tid = tid })
	return
}
