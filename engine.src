// colibri_q — pure-MFL int8 (Q8_0) LLM inference engine (M1)
// Reads llama2.c "version 2" checkpoints (magic ak42): group-quantized int8
// weights + fp32 group scales, fp32 rmsnorm params. Mirrors runq.c faithfully.

// ---- config ----
var dim = 0
var hidden_dim = 0
var n_layers = 0
var n_heads = 0
var n_kv_heads = 0
var vocab_size = 0
var seq_len = 0
var head_size = 0
var kv_dim = 0
var gs = 0
var shared_cls = 0
var quant4 = 0

// ---- weight offsets into the checkpoint buffer (bytes) ----
var wbuf = 0
var w_rms_att = 0
var w_rms_ffn = 0
var w_rms_final = 0
// quantized tensor bases; per-layer block = size + 4*size/gs (q bytes then f32 scales)
var w_tok = 0
var wq_b = 0
var wk_b = 0
var wv_b = 0
var wo_b = 0
var w1_b = 0
var w2_b = 0
var w3_b = 0
var wcls_b = 0

// ---- run state ----
var s_x = 0
var s_xb = 0
var s_xb2 = 0
var s_hb = 0
var s_hb2 = 0
var s_q = 0
var s_att = 0
var s_logits = 0
var s_key_cache = 0
var s_val_cache = 0
var s_xq = 0    // quantized activation values (int8 bytes)
var s_xq_s = 0  // fp32 group scales
var s_hq = 0
var s_hq_s = 0

// ---- tokenizer ----
var vocab = []string{}
var vocab_idx = make(map[string]int)
var tok_scores = 0 // raw buffer of fp32 scores

func read_i32(b, off) (v) {
	v = byte_at(b, off) | byte_at(b, off+1) << 8 | byte_at(b, off+2) << 16 | byte_at(b, off+3) << 24
	if v >= 2147483648 { v = v - 4294967296 }
	return
}

func bytes_to_buf(b) (p) {
	n := len(b)
	p = alloc(n + 4)
	i := 0
	while i + 4 <= n {
		w := byte_at(b, i) | byte_at(b, i+1) << 8 | byte_at(b, i+2) << 16 | byte_at(b, i+3) << 24
		poke_i32(p, i, w)
		i = i + 4
	}
	while i < n { poke_u8(p, i, byte_at(b, i))  i = i + 1 }
	return
}

// packed quant bytes for a tensor: int8 = size, int4 = size/2 (split-nibble)
func wsz(size) (n) { n = size  if quant4 == 1 { n = size / 2 }  return }
// read an f32 from a bytes value at any offset (header fields)
func f32_at(b, off) (v) {
	p := alloc(4)
	poke_i32(p, 0, byte_at(b, off) | byte_at(b, off+1) << 8 | byte_at(b, off+2) << 16 | byte_at(b, off+3) << 24)
	v = peek_f32(p, 0)
	free(p)
	return
}

// quantized tensor block size in bytes: packed q values + size/gs fp32 scales
func qblock(size) (n) { n = wsz(size) + 4 * (size / gs)  return }

func load_model(path) {
	// zero-copy: mmap the checkpoint; the on-disk bytes ARE the C-struct layout,
	// so peek_* reads header + weights directly (pages fault in lazily). This is
	// what makes load near-instant instead of a multi-GB read+copy.
	mb, _ := mmap_file(path)
	wbuf = mb
	if wbuf == 0 { println("cannot mmap model: " + path)  exit(1) }
	m := peek_i32(wbuf, 0)
	v4 := 0
	if m == 1634415666 { quant4 = 0 } else { // 0x616b3432 "ak42" (int8 v2)
		if m == 1634415667 { quant4 = 1 } else { // 0x616b3433 "ak43" (int4 v3)
			if m == 1634415668 { quant4 = 0  v4 = 1 } else { // 0x616b3434 "ak44" (int8 + rope header)
				if m == 1634415669 { quant4 = 1  v4 = 1 } else { println("bad magic (want ak42/ak43/ak44/ak45)")  exit(1) } // 0x616b3435 "ak45" (int4 + rope header)
			}
		}
	}
	dim = peek_i32(wbuf, 8)
	hidden_dim = peek_i32(wbuf, 12)
	n_layers = peek_i32(wbuf, 16)
	n_heads = peek_i32(wbuf, 20)
	n_kv_heads = peek_i32(wbuf, 24)
	vocab_size = peek_i32(wbuf, 28)
	seq_len = peek_i32(wbuf, 32)
	shared_cls = peek_u8(wbuf, 36)
	gs = peek_i32(wbuf, 37)
	if v4 == 1 {
		rope_theta = peek_f32(wbuf, 41)
		l3_scaling = peek_u8(wbuf, 45)
		l3_factor = peek_f32(wbuf, 46)
		l3_low = peek_f32(wbuf, 50)
		l3_high = peek_f32(wbuf, 54)
		l3_orig = peek_i32(wbuf, 58)
	}
	head_size = dim / n_heads
	kv_dim = (dim * n_kv_heads) / n_heads
	o := 256
	w_rms_att = o    o = o + n_layers * dim * 4
	w_rms_ffn = o    o = o + n_layers * dim * 4
	w_rms_final = o  o = o + dim * 4
	w_tok = o        o = o + qblock(vocab_size * dim)
	wq_b = o         o = o + n_layers * qblock(dim * dim)
	wk_b = o         o = o + n_layers * qblock(dim * kv_dim)
	wv_b = o         o = o + n_layers * qblock(dim * kv_dim)
	wo_b = o         o = o + n_layers * qblock(dim * dim)
	w1_b = o         o = o + n_layers * qblock(dim * hidden_dim)
	w2_b = o         o = o + n_layers * qblock(hidden_dim * dim)
	w3_b = o         o = o + n_layers * qblock(dim * hidden_dim)
	if shared_cls == 1 { wcls_b = w_tok } else { wcls_b = o }
	// precompute the RoPE frequency per dim-pair once: rope_freq(hd) depends only
	// on hd (+ theta/scaling), NOT position — computing pow() per element per
	// token was ~16M pow calls in a long prefill. Table has head_size/2 entries.
	rope_freqs = alloc((head_size / 2) * 4)
	hd := 0
	while hd < head_size {
		poke_f32(rope_freqs, (hd / 2) * 4, rope_freq(hd))
		hd = hd + 2
	}
}

func alloc_state() {
	s_x = alloc(dim * 4)
	s_xb = alloc(dim * 4)
	s_xb2 = alloc(dim * 4)
	s_hb = alloc(hidden_dim * 4)
	s_hb2 = alloc(hidden_dim * 4)
	s_q = alloc(dim * 4)
	s_att = alloc(n_heads * seq_len * 4)
	s_logits = alloc(vocab_size * 4)
	s_key_cache = alloc(n_layers * seq_len * kv_dim * 4)
	s_val_cache = alloc(n_layers * seq_len * kv_dim * 4)
	s_xq = alloc(dim)
	s_xq_s = alloc((dim / gs) * 4)
	s_hq = alloc(hidden_dim)
	s_hq_s = alloc((hidden_dim / gs) * 4)
	cache_buf = alloc(seq_len * 4) // persistent prefix-cache token bookkeeping
	alloc_prefill()
	alloc_spec()
}

func load_tokenizer(path) {
	b := read_file_bytes(path)
	if len(b) == 0 { println("cannot read tokenizer: " + path)  exit(1) }
	tbuf := bytes_to_buf(b)
	tok_scores = alloc(vocab_size * 4)
	off := 4
	i := 0
	while i < vocab_size {
		poke_f32(tok_scores, i*4, peek_f32(tbuf, off))
		off = off + 4
		n := read_i32(b, off)
		off = off + 4
		piece := bytes_str(bytes_sub(b, off, off+n))
		vocab = append(vocab, piece)
		vocab_idx[piece] = i
		off = off + n
		i = i + 1
	}
	free(tbuf)
}

// ---- math kernels ----

func rmsnorm(dst, x, w, size) {
	ss := 0.0
	j := 0
	while j < size {
		v := peek_f32(x, j*4)
		ss = ss + v * v
		j = j + 1
	}
	ss = ss / float(size)
	ss = 1.0 / sqrt(ss + 0.00001)
	j = 0
	while j < size {
		poke_f32(dst, j*4, peek_f32(w, j*4) * ss * peek_f32(x, j*4))
		j = j + 1
	}
}

func softmax(x, size) {
	mx := peek_f32(x, 0)
	i := 1
	while i < size {
		v := peek_f32(x, i*4)
		if v > mx { mx = v }
		i = i + 1
	}
	sum := 0.0
	i = 0
	while i < size {
		e := exp(peek_f32(x, i*4) - mx)
		poke_f32(x, i*4, e)
		sum = sum + e
		i = i + 1
	}
	i = 0
	while i < size {
		poke_f32(x, i*4, peek_f32(x, i*4) / sum)
		i = i + 1
	}
}

// quantize fp32 buffer x[n] into int32-slot quants xq + fp32 group scales xs (runq.c quantize)
func quantize_act(xq, xs, x, n) {
	ng := n / gs
	g := 0
	while g < ng {
		base := g * gs
		wmax := 0.0
		i := 0
		while i < gs {
			v := abs(peek_f32(x, (base+i)*4))
			if v > wmax { wmax = v }
			i = i + 1
		}
		scale := wmax / 127.0
		poke_f32(xs, g*4, scale)
		i = 0
		while i < gs {
			q := 0
			if scale > 0.0 { q = int(round(peek_f32(x, (base+i)*4) / scale)) }
			poke_u8(xq, base+i, q & 255)
			i = i + 1
		}
		g = g + 1
	}
}

// xout[lo..hi) = W(int8)[d,n] @ xq[n], group-scaled (runq.c matmul)
// wq = q base offset, ws = scale base offset (bytes into wbuf)
func matmul_q(xout, xq, xs, wq, ws, n, lo, hi) {
	i := lo
	while i < hi {
		in := i * n
		poke_f32(xout, i*4, dot_q8(xq, xs, wbuf + wq + in, wbuf + ws + (in/gs)*4, n, gs))
		i = i + 1
	}
}

// int4 variant: split-nibble (byte k in a group holds w[k] low nibble and
// w[k+gs/2] high nibble, each value+8). One dot_q4 call per output element does
// the unpack + grouped dual-scaled dot, vectorized. sc unused (kept for mmj arity).
func matmul_q4(xout, xq, xs, wq, ws, n, lo, hi, sc) {
	i := lo
	while i < hi {
		in := i * n
		poke_f32(xout, i*4, dot_q4(xq, xs, wbuf + wq + i*(n/2), wbuf + ws + (in/gs)*4, n, gs))
		i = i + 1
	}
}

// quant-width dispatch: tensor base tb, logical element count tsize, input width n
func mmj(xout, xq, xs, tb, tsize, n, lo, hi, sc) {
	if quant4 == 1 { matmul_q4(xout, xq, xs, tb, tb + wsz(tsize), n, lo, hi, sc) } else { matmul_q(xout, xq, xs, tb, tb + wsz(tsize), n, lo, hi) }
}

// dequantize one token-embedding row into x (runq dequantizes whole table; same math per element)
func embed_token(token) {
	row := token * dim
	sbase := w_tok + wsz(vocab_size * dim) // scales sit after the packed q bytes
	if quant4 == 1 {
		h := gs / 2
		g := 0
		while g < dim / gs {
			gq := w_tok + token * (dim / 2) + g * h
			sc := peek_f32(wbuf, sbase + ((row + g*gs)/gs)*4)
			i := 0
			while i < h {
				b := peek_u8(wbuf, gq + i)
				poke_f32(s_x, (g*gs+i)*4, float((b & 15) - 8) * sc)
				poke_f32(s_x, (g*gs+i+h)*4, float((b >> 4) - 8) * sc)
				i = i + 1
			}
			g = g + 1
		}
		return
	}
	i := 0
	while i < dim {
		poke_f32(s_x, i*4, float(peek_i8(wbuf, w_tok + row + i)) * peek_f32(wbuf, sbase + ((row+i)/gs)*4))
		i = i + 1
	}
}

// RoPE: rotate adjacent pairs of q (all dims) and this position's cached k (kv dims)
func rope(l, pos) {
	kptr := s_key_cache + (l * seq_len * kv_dim + pos * kv_dim) * 4
	i := 0
	while i < dim {
		hd := i % head_size
		freq := peek_f32(rope_freqs, (hd/2)*4)
		val := float(pos) * freq
		fcr := cos(val)
		fci := sin(val)
		q0 := peek_f32(s_q, i*4)
		q1 := peek_f32(s_q, i*4+4)
		poke_f32(s_q, i*4, q0 * fcr - q1 * fci)
		poke_f32(s_q, i*4+4, q0 * fci + q1 * fcr)
		if i < kv_dim {
			k0 := peek_f32(kptr, i*4)
			k1 := peek_f32(kptr, i*4+4)
			poke_f32(kptr, i*4, k0 * fcr - k1 * fci)
			poke_f32(kptr, i*4+4, k0 * fci + k1 * fcr)
		}
		i = i + 2
	}
}

// one attention head over the kv cache: scores -> softmax -> weighted V sum into s_xb
func attn_head(h, l, pos) {
	loff := l * seq_len * kv_dim
	kv_mul := n_heads / n_kv_heads
	qh := s_q + h * head_size * 4
	atth := s_att + h * seq_len * 4
	t := 0
	while t <= pos {
		kt := s_key_cache + (loff + t * kv_dim + (h / kv_mul) * head_size) * 4
		score := 0.0
		j := 0
		while j < head_size {
			score = score + peek_f32(qh, j*4) * peek_f32(kt, j*4)
			j = j + 1
		}
		poke_f32(atth, t*4, score / sqrt(float(head_size)))
		t = t + 1
	}
	softmax(atth, pos + 1)
	xbh := s_xb + h * head_size * 4
	j := 0
	while j < head_size {
		poke_f32(xbh, j*4, 0.0)
		j = j + 1
	}
	t = 0
	while t <= pos {
		vt := s_val_cache + (loff + t * kv_dim + (h / kv_mul) * head_size) * 4
		a := peek_f32(atth, t*4)
		j = 0
		while j < head_size {
			poke_f32(xbh, j*4, peek_f32(xbh, j*4) + a * peek_f32(vt, j*4))
			j = j + 1
		}
		t = t + 1
	}
}

// ---- batched prefill ----
// The per-token forward re-streams ALL weights from RAM for every prompt token
// (O(n) full weight reads -> ~1.3GB x n_tokens of traffic). Batched prefill runs
// a TILE of positions through each layer together, so each weight row is loaded
// once and reused across the whole tile (GEMM, not n GEMVs) -- the prefill cost
// drops from ~weight-streaming-bound to compute-bound. Attention (inherently
// O(n^2)) is parallelized over head x position.
var pb_tile = 256
var pb_enabled = 1  // COLIBRI_NOBATCH=1 forces per-token prefill (A/B correctness)
var prof_qkv = 0
var prof_attn = 0
var prof_o = 0
var prof_ffn = 0
var pb_B = 0        // current tile size
var pb_tstart = 0   // absolute position of the tile's first token
var pb_x = 0        // TILE x dim  (residual stream)
var pb_xb = 0       // TILE x dim  (normed / attn out)
var pb_xb2 = 0      // TILE x dim  (o-proj out)
var pb_q = 0        // TILE x dim  (queries)
var pb_hb = 0       // TILE x hidden
var pb_hb2 = 0      // TILE x hidden
var pb_xq = 0       // TILE x dim  int8
var pb_xqs = 0      // TILE x (dim/gs) f32
var pb_hq = 0       // TILE x hidden int8
var pb_hqs = 0      // TILE x (hidden/gs) f32

func alloc_prefill() {
	t := pb_tile
	pb_x = alloc(t * dim * 4)
	pb_xb = alloc(t * dim * 4)
	pb_xb2 = alloc(t * dim * 4)
	pb_q = alloc(t * dim * 4)
	pb_hb = alloc(t * hidden_dim * 4)
	pb_hb2 = alloc(t * hidden_dim * 4)
	pb_xq = alloc(t * dim)
	pb_xqs = alloc(t * (dim / gs) * 4)
	pb_hq = alloc(t * hidden_dim)
	pb_hqs = alloc(t * (hidden_dim / gs) * 4)
}

// batched int8 matmul: out[b][i] = W[i,:] . xq[b][:], for b in 0..B, i in lo..hi.
// out is row-major with row stride `ostride` (dim for a dense buffer, kv_dim for
// the KV cache tile). Weight row i (wrow) is loaded ONCE and reused across all B
// positions -- the whole point. xqb/xsb are TILE-major (row stride n / n/gs).
func matmul_q_batch(ob, ostride, xqb, xsb, wq, ws, n, lo, hi, B) {
	 nsc := (n / gs) * 4
	i := lo
	while i < hi {
		in := i * n
		wrow := wbuf + wq + in
		wsp := wbuf + ws + (in / gs) * 4
		b := 0
		while b < B {
			poke_f32(ob, (b * ostride + i) * 4, dot_q8(xqb + b*n, xsb + b*nsc, wrow, wsp, n, gs))
			b = b + 1
		}
		i = i + 1
	}
}

// attention for one (head, position) with an explicit query base, output base,
// and per-worker score scratch (so parallel head x position units don't collide
// on shared state).
func attn_head_at(h, l, pos, qbase, obase, att) {
	loff := l * seq_len * kv_dim
	kv_mul := n_heads / n_kv_heads
	qh := qbase + h * head_size * 4
	t := 0
	while t <= pos {
		kt := s_key_cache + (loff + t * kv_dim + (h / kv_mul) * head_size) * 4
		poke_f32(att, t*4, dot_f32(qh, kt, head_size) / sqrt(float(head_size)))
		t = t + 1
	}
	softmax(att, pos + 1)
	xbh := obase + h * head_size * 4
	j := 0
	while j < head_size {
		poke_f32(xbh, j*4, 0.0)
		j = j + 1
	}
	t = 0
	while t <= pos {
		vt := s_val_cache + (loff + t * kv_dim + (h / kv_mul) * head_size) * 4
		axpy_f32(xbh, peek_f32(att, t*4), vt, head_size)
		t = t + 1
	}
}

// rope for a batch position: rotate the query in qbase and the cached key at pos.
func rope_at(l, pos, qbase) {
	kptr := s_key_cache + (l * seq_len * kv_dim + pos * kv_dim) * 4
	i := 0
	while i < dim {
		hd := i % head_size
		freq := peek_f32(rope_freqs, (hd/2)*4)
		val := float(pos) * freq
		fcr := cos(val)
		fci := sin(val)
		q0 := peek_f32(qbase, i*4)
		q1 := peek_f32(qbase, i*4+4)
		poke_f32(qbase, i*4, q0 * fcr - q1 * fci)
		poke_f32(qbase, i*4+4, q0 * fci + q1 * fcr)
		if i < kv_dim {
			k0 := peek_f32(kptr, i*4)
			k1 := peek_f32(kptr, i*4+4)
			poke_f32(kptr, i*4, k0 * fcr - k1 * fci)
			poke_f32(kptr, i*4+4, k0 * fci + k1 * fcr)
		}
		i = i + 2
	}
}

// ---- worker pool: jobs are packed ints, results land in disjoint buffer rows ----
// job = type | layer<<4 | pos<<12 | lo<<24 | hi<<44
// types: 0 wq  1 wk  2 wv  3 wo  4 w1  5 w3  6 w2  7 wcls  8 attention heads
//        9 fused-qkv  10 fused-w1w3   11-17 batched matmuls  18 batched attention
var n_workers = 1
var jobs = make(chan int)
var done = make(chan int)
var pending = 0

func do_job(j, sc, att) {
	t := j & 31
	l := (j >> 5) & 255
	pos := (j >> 13) & 4095
	lo := (j >> 25) & 524287
	hi := (j >> 44) & 524287
	if t == 0 { mmj(s_q, s_xq, s_xq_s, wq_b + l * qblock(dim*dim), dim*dim, dim, lo, hi, sc) }
	if t == 1 {
		kptr := s_key_cache + (l * seq_len * kv_dim + pos * kv_dim) * 4
		mmj(kptr, s_xq, s_xq_s, wk_b + l * qblock(dim*kv_dim), dim*kv_dim, dim, lo, hi, sc)
	}
	if t == 2 {
		vptr := s_val_cache + (l * seq_len * kv_dim + pos * kv_dim) * 4
		mmj(vptr, s_xq, s_xq_s, wv_b + l * qblock(dim*kv_dim), dim*kv_dim, dim, lo, hi, sc)
	}
	if t == 3 { mmj(s_xb2, s_xq, s_xq_s, wo_b + l * qblock(dim*dim), dim*dim, dim, lo, hi, sc) }
	if t == 4 { mmj(s_hb, s_xq, s_xq_s, w1_b + l * qblock(dim*hidden_dim), dim*hidden_dim, dim, lo, hi, sc) }
	if t == 5 { mmj(s_hb2, s_xq, s_xq_s, w3_b + l * qblock(dim*hidden_dim), dim*hidden_dim, dim, lo, hi, sc) }
	if t == 6 { mmj(s_xb, s_hq, s_hq_s, w2_b + l * qblock(hidden_dim*dim), hidden_dim*dim, hidden_dim, lo, hi, sc) }
	if t == 7 { mmj(s_logits, s_xq, s_xq_s, wcls_b, dim*vocab_size, dim, lo, hi, sc) }
	if t == 8 {
		h := lo
		while h < hi { attn_head(h, l, pos)  h = h + 1 }
	}
	if t == 9 { // fused qkv: this worker's rows of q, plus the matching k/v shares
		mmj(s_q, s_xq, s_xq_s, wq_b + l * qblock(dim*dim), dim*dim, dim, lo, hi, sc)
		klo := (lo * kv_dim) / dim
		khi := (hi * kv_dim) / dim
		if khi > klo {
			kptr := s_key_cache + (l * seq_len * kv_dim + pos * kv_dim) * 4
			vptr := s_val_cache + (l * seq_len * kv_dim + pos * kv_dim) * 4
			mmj(kptr, s_xq, s_xq_s, wk_b + l * qblock(dim*kv_dim), dim*kv_dim, dim, klo, khi, sc)
			mmj(vptr, s_xq, s_xq_s, wv_b + l * qblock(dim*kv_dim), dim*kv_dim, dim, klo, khi, sc)
		}
	}
	if t == 10 { // fused ffn up: w1 and w3 share the same rows
		mmj(s_hb, s_xq, s_xq_s, w1_b + l * qblock(dim*hidden_dim), dim*hidden_dim, dim, lo, hi, sc)
		mmj(s_hb2, s_xq, s_xq_s, w3_b + l * qblock(dim*hidden_dim), dim*hidden_dim, dim, lo, hi, sc)
	}
	// ---- batched prefill jobs (read pb_B / pb_tstart globals) ----
	if t == 11 { qb := wq_b + l * qblock(dim*dim)  matmul_q_batch(pb_q, dim, pb_xq, pb_xqs, qb, qb + dim*dim, dim, lo, hi, pb_B) }
	if t == 12 { kb := wk_b + l * qblock(dim*kv_dim)  matmul_q_batch(s_key_cache + (l*seq_len*kv_dim + pb_tstart*kv_dim)*4, kv_dim, pb_xq, pb_xqs, kb, kb + dim*kv_dim, dim, lo, hi, pb_B) }
	if t == 13 { vb := wv_b + l * qblock(dim*kv_dim)  matmul_q_batch(s_val_cache + (l*seq_len*kv_dim + pb_tstart*kv_dim)*4, kv_dim, pb_xq, pb_xqs, vb, vb + dim*kv_dim, dim, lo, hi, pb_B) }
	if t == 14 { ob := wo_b + l * qblock(dim*dim)  matmul_q_batch(pb_xb2, dim, pb_xq, pb_xqs, ob, ob + dim*dim, dim, lo, hi, pb_B) }
	if t == 15 { wb := w1_b + l * qblock(dim*hidden_dim)  matmul_q_batch(pb_hb, hidden_dim, pb_xq, pb_xqs, wb, wb + dim*hidden_dim, dim, lo, hi, pb_B) }
	if t == 16 { wb := w3_b + l * qblock(dim*hidden_dim)  matmul_q_batch(pb_hb2, hidden_dim, pb_xq, pb_xqs, wb, wb + dim*hidden_dim, dim, lo, hi, pb_B) }
	if t == 17 { wb := w2_b + l * qblock(hidden_dim*dim)  matmul_q_batch(pb_xb, dim, pb_hq, pb_hqs, wb, wb + hidden_dim*dim, hidden_dim, lo, hi, pb_B) }
	if t == 18 { // batched attention over flattened (b*n_heads + head) units
		u := lo
		while u < hi {
			b := u / n_heads
			h := u % n_heads
			attn_head_at(h, l, pb_tstart + b, pb_q + b*dim*4, pb_xb + b*dim*4, att)
			u = u + 1
		}
	}
	// ---- batched elementwise glue, parallelized over positions [lo,hi) ----
	if t == 19 { // att rmsnorm(pb_x -> pb_xb) + quantize(-> pb_xq)
		b := lo
		while b < hi { rmsnorm(pb_xb + b*dim*4, pb_x + b*dim*4, wbuf + w_rms_att + l*dim*4, dim)  quantize_act(pb_xq + b*dim, pb_xqs + b*(dim/gs)*4, pb_xb + b*dim*4, dim)  b = b + 1 }
	}
	if t == 20 { // ffn rmsnorm(pb_x -> pb_xb) + quantize(-> pb_xq)
		b := lo
		while b < hi { rmsnorm(pb_xb + b*dim*4, pb_x + b*dim*4, wbuf + w_rms_ffn + l*dim*4, dim)  quantize_act(pb_xq + b*dim, pb_xqs + b*(dim/gs)*4, pb_xb + b*dim*4, dim)  b = b + 1 }
	}
	if t == 21 { // quantize pb_xb (attn output) -> pb_xq
		b := lo
		while b < hi { quantize_act(pb_xq + b*dim, pb_xqs + b*(dim/gs)*4, pb_xb + b*dim*4, dim)  b = b + 1 }
	}
	if t == 22 { // residual pb_x += pb_xb2
		b := lo
		while b < hi { i := 0  while i < dim { poke_f32(pb_x + b*dim*4, i*4, peek_f32(pb_x + b*dim*4, i*4) + peek_f32(pb_xb2 + b*dim*4, i*4))  i = i + 1 }  b = b + 1 }
	}
	if t == 23 { // silu(pb_hb)*pb_hb2 -> pb_hb, quantize -> pb_hq
		b := lo
		while b < hi {
			i := 0
			while i < hidden_dim {
				v := peek_f32(pb_hb + b*hidden_dim*4, i*4)
				v = v * (1.0 / (1.0 + exp(0.0 - v)))
				poke_f32(pb_hb + b*hidden_dim*4, i*4, v * peek_f32(pb_hb2 + b*hidden_dim*4, i*4))
				i = i + 1
			}
			quantize_act(pb_hq + b*hidden_dim, pb_hqs + b*(hidden_dim/gs)*4, pb_hb + b*hidden_dim*4, hidden_dim)
			b = b + 1
		}
	}
	if t == 24 { // residual pb_x += pb_xb
		b := lo
		while b < hi { i := 0  while i < dim { poke_f32(pb_x + b*dim*4, i*4, peek_f32(pb_x + b*dim*4, i*4) + peek_f32(pb_xb + b*dim*4, i*4))  i = i + 1 }  b = b + 1 }
	}
	if t == 25 { // batched rope over positions [lo,hi)
		b := lo
		while b < hi { rope_at(l, pb_tstart + b, pb_q + b*dim*4)  b = b + 1 }
	}
	if t == 26 { // batched final rmsnorm + quantize (per position)
		b := lo
		while b < hi { rmsnorm(pb_xb + b*dim*4, pb_x + b*dim*4, wbuf + w_rms_final, dim)  quantize_act(pb_xq + b*dim, pb_xqs + b*(dim/gs)*4, pb_xb + b*dim*4, dim)  b = b + 1 }
	}
	if t == 27 { // batched classifier -> spec_logits (B x vocab)
		matmul_q_batch(spec_logits, vocab_size, pb_xq, pb_xqs, wcls_b, wcls_b + dim*vocab_size, dim, lo, hi, pb_B)
	}
}

func worker(jc, dc) {
	sc := alloc(hidden_dim)  // per-worker int4 row-unpack scratch (covers widest row)
	att := alloc(seq_len * 4) // per-worker attention score scratch (batched attn)
	for j := range jc {
		do_job(j, sc, att)
		dc <- 1
	}
}

// split rows [0,d) into n_workers chunks and enqueue with a sliding window:
// never more than n_workers jobs outstanding (unbuffered channels — a bigger
// backlog would deadlock: workers block on done<-, main on jobs<-)
func dispatch_rows(t, l, pos, d) {
	nc := n_workers
	if nc > d { nc = d }
	chunk := (d + nc - 1) / nc
	lo := 0
	while lo < d {
		hi := lo + chunk
		if hi > d { hi = d }
		if pending >= n_workers { <-done  pending = pending - 1 }
		jobs <- (t | l << 5 | pos << 13 | lo << 25 | hi << 44)
		pending = pending + 1
		lo = hi
	}
}

func barrier() {
	while pending > 0 { <-done  pending = pending - 1 }
}

func forward(token, pos) {
	embed_token(token)
	i := 0
	l := 0
	nl := n_layers
	if exit_layer > 0 && exit_layer < nl { nl = exit_layer }
	while l < nl {
		rmsnorm(s_xb, s_x, wbuf + w_rms_att + l * dim * 4, dim)
		quantize_act(s_xq, s_xq_s, s_xb, dim)
		dispatch_rows(9, l, pos, dim)  barrier()
		rope(l, pos)
		dispatch_rows(8, l, pos, n_heads)  barrier()
		// attention out projection + residual
		quantize_act(s_xq, s_xq_s, s_xb, dim)
		dispatch_rows(3, l, pos, dim)  barrier()
		i = 0
		while i < dim {
			poke_f32(s_x, i*4, peek_f32(s_x, i*4) + peek_f32(s_xb2, i*4))
			i = i + 1
		}
		// ffn
		rmsnorm(s_xb, s_x, wbuf + w_rms_ffn + l * dim * 4, dim)
		quantize_act(s_xq, s_xq_s, s_xb, dim)
		dispatch_rows(10, l, pos, hidden_dim)  barrier()
		if sparse_probe == 1 {
			maxg := 0.0
			j := 0
			while j < hidden_dim { g := peek_f32(s_hb, j*4)  g = g * (1.0/(1.0+exp(0.0-g)))  ag := abs(g)  if ag > maxg { maxg = ag }  j = j + 1 }
			thr := 0.1 * maxg
			below := 0
			keptmass := 0.0
			totmass := 0.0
			j = 0
			while j < hidden_dim {
				g := peek_f32(s_hb, j*4)  g = g * (1.0/(1.0+exp(0.0-g)))
				h := abs(g * peek_f32(s_hb2, j*4))
				totmass = totmass + h
				if abs(g) < thr { below = below + 1 } else { keptmass = keptmass + h }
				j = j + 1
			}
			sp_below = sp_below + below
			sp_total = sp_total + hidden_dim
			if totmass > 0.0 { sp_massk = sp_massk + keptmass / totmass  sp_massn = sp_massn + 1 }
		}
		i = 0
		while i < hidden_dim {
			v := peek_f32(s_hb, i*4)
			v = v * (1.0 / (1.0 + exp(0.0 - v)))
			poke_f32(s_hb, i*4, v * peek_f32(s_hb2, i*4))
			i = i + 1
		}
		quantize_act(s_hq, s_hq_s, s_hb, hidden_dim)
		dispatch_rows(6, l, pos, dim)  barrier()
		i = 0
		while i < dim {
			poke_f32(s_x, i*4, peek_f32(s_x, i*4) + peek_f32(s_xb, i*4))
			i = i + 1
		}
		l = l + 1
	}
	rmsnorm(s_x, s_x, wbuf + w_rms_final, dim)
	quantize_act(s_xq, s_xq_s, s_x, dim)
	dispatch_rows(7, 0, pos, vocab_size)  barrier()
}

func argmax_logits() (best) {
	best = 0
	bv := peek_f32(s_logits, 0)
	i := 1
	while i < vocab_size {
		v := peek_f32(s_logits, i*4)
		if v > bv { bv = v  best = i }
		i = i + 1
	}
	return
}

// ---- BPE encode (llama2.c encode(): BOS + dummy prefix + char lookup + best-score merges) ----
func bpe_encode(text) (toks) {
	toks = bpe_encode_opts(text, 1, 1)
	return
}

func bpe_encode_opts(text, add_bos, add_prefix) (toks) {
	toks = []int{}
	if add_bos == 1 { toks = append(toks, 1) } // BOS
	if len(text) == 0 { return }
	if add_prefix == 1 { toks = append(toks, vocab_idx[" "]) } // sentencepiece dummy prefix
	b := bytes(text)
	n := len(b)
	i := 0
	while i < n {
		j := i + 1
		while j < n && (byte_at(b, j) & 192) == 128 { j = j + 1 }
		c := bytes_str(bytes_sub(b, i, j))
		if has(vocab_idx, c) {
			toks = append(toks, vocab_idx[c])
		} else {
			k := i
			while k < j { toks = append(toks, byte_at(b, k) + 3)  k = k + 1 }
		}
		i = j
	}
	while true {
		best_score := 0.0 - 1000000000.0
		best_id := -1
		best_idx := -1
		ti := 0
		while ti < len(toks) - 1 {
			merged := vocab[toks[ti]] + vocab[toks[ti+1]]
			if has(vocab_idx, merged) {
				id := vocab_idx[merged]
				sc := peek_f32(tok_scores, id*4)
				if sc > best_score { best_score = sc  best_id = id  best_idx = ti }
			}
			ti = ti + 1
		}
		if best_idx == -1 { break }
		nt := []int{}
		ti = 0
		while ti < len(toks) {
			if ti == best_idx { nt = append(nt, best_id)  ti = ti + 2 } else { nt = append(nt, toks[ti])  ti = ti + 1 }
		}
		toks = nt
	}
	return
}

func decode_piece(prev, token) (piece) {
	piece = vocab[token]
	if prev == 1 && has_prefix(piece, " ") { piece = substr(piece, 1, len(piece)) }
	if has_prefix(piece, "<0x") && has_suffix(piece, ">") {
		piece = bytes_str(from_hex(substr(piece, 3, 5)))
	}
	return
}

// ---- sampling (ports runq.c: temperature softmax + top-p nucleus) ----

var rng_state = 12345

func rng_seed(s) { if s <= 0 { s = 1 }  rng_state = s & 2147483647 }

// 31-bit LCG (overflow-safe in 64-bit int), uniform [0,1)
func rng_f() (r) {
	rng_state = (rng_state * 1103515245 + 12345) & 2147483647
	r = float(rng_state) / 2147483648.0
	return
}

// softmax logits in place with temperature; returns nothing (probs live in s_logits)
func logits_softmax(temp) {
	i := 0
	while i < vocab_size {
		poke_f32(s_logits, i*4, peek_f32(s_logits, i*4) / temp)
		i = i + 1
	}
	softmax(s_logits, vocab_size)
}

// top-p (nucleus) sampling over s_logits probs; runq.c semantics incl. cutoff filter
func sample_topp(topp) (tok) {
	cutoff := (1.0 - topp) / float(vocab_size - 1)
	idx := []int{}
	i := 0
	while i < vocab_size {
		if peek_f32(s_logits, i*4) >= cutoff { idx = append(idx, i) }
		i = i + 1
	}
	n := len(idx)
	// iterative quicksort desc by prob (explicit stack)
	lo_s := []int{0}
	hi_s := []int{n - 1}
	while len(lo_s) > 0 {
		lo := lo_s[len(lo_s)-1]
		hi := hi_s[len(hi_s)-1]
		nl := []int{}
		nh := []int{}
		k := 0
		while k < len(lo_s)-1 { nl = append(nl, lo_s[k])  nh = append(nh, hi_s[k])  k = k + 1 }
		lo_s = nl
		hi_s = nh
		if lo < hi {
			pv := peek_f32(s_logits, idx[(lo+hi)/2]*4)
			a := lo
			b := hi
			while a <= b {
				while peek_f32(s_logits, idx[a]*4) > pv { a = a + 1 }
				while peek_f32(s_logits, idx[b]*4) < pv { b = b - 1 }
				if a <= b {
					t := idx[a]  idx[a] = idx[b]  idx[b] = t
					a = a + 1
					b = b - 1
				}
			}
			if lo < b { lo_s = append(lo_s, lo)  hi_s = append(hi_s, b) }
			if a < hi { lo_s = append(lo_s, a)  hi_s = append(hi_s, hi) }
		}
	}
	// truncate at cumulative topp
	cum := 0.0
	last := n - 1
	i = 0
	while i < n {
		cum = cum + peek_f32(s_logits, idx[i]*4)
		if cum > topp { last = i  break }
		i = i + 1
	}
	// sample within the truncated nucleus
	r := rng_f() * cum
	cdf := 0.0
	tok = idx[last]
	i = 0
	while i <= last {
		cdf = cdf + peek_f32(s_logits, idx[i]*4)
		if r < cdf { tok = idx[i]  return }
		i = i + 1
	}
	return
}

// sample next token: temp<=0 -> greedy argmax; else temperature softmax (+ top-p if 0<topp<1)
func sample_next(temp, topp) (tok) {
	if temp <= 0.0 { tok = argmax_logits()  return }
	logits_softmax(temp)
	if topp > 0.0 && topp < 1.0 { tok = sample_topp(topp)  return }
	// plain multinomial
	r := rng_f()
	cdf := 0.0
	tok = vocab_size - 1
	i := 0
	while i < vocab_size {
		cdf = cdf + peek_f32(s_logits, i*4)
		if r < cdf { tok = i  return }
		i = i + 1
	}
	return
}

// ---- generation with single-slot KV prefix cache ----

// Prefix-cache bookkeeping lives in a RAW buffer, not an MFL slice: the server
// runs each request in its own goroutine whose arena is reclaimed on return, so
// a slice global written by request N is dangling for request N+1 (the KV cache
// itself is in persistent alloc'd buffers, so only this bookkeeping needed
// moving). cache_buf holds the token ids at positions 0..cache_len-1.
var cache_buf = 0
var cache_len = 0

// common prefix length of cached tokens vs the new prompt
func cache_common(toks) (l) {
	l = 0
	n := len(toks)
	if cache_len < n { n = cache_len }
	while l < n {
		if peek_i32(cache_buf, l*4) != toks[l] { return }
		l = l + 1
	}
	return
}

// int8 token embedding into an arbitrary destination buffer (batched prefill)
func embed_to(token, dst) {
	row := token * dim
	sbase := w_tok + vocab_size * dim
	i := 0
	while i < dim {
		poke_f32(dst, i*4, float(peek_i8(wbuf, w_tok + row + i)) * peek_f32(wbuf, sbase + ((row+i)/gs)*4))
		i = i + 1
	}
}

// batched prefill of positions [start, np): store K/V for those positions and
// leave s_logits = logits for position np-1. int8 only (batched fast path).
// run the batched transformer layers for pb_B positions at [pb_tstart, ..),
// assuming pb_x is embedded. Leaves final hidden states in pb_x, KV written.
func batch_layers(B) {
	l := 0
	while l < n_layers {
		dispatch_rows(19, l, 0, B)  barrier()          // att rmsnorm+quant
		dispatch_rows(11, l, 0, dim)  barrier()        // Q
		dispatch_rows(12, l, 0, kv_dim)  barrier()     // K -> cache
		dispatch_rows(13, l, 0, kv_dim)  barrier()     // V -> cache
		dispatch_rows(25, l, 0, B)  barrier()          // rope
		dispatch_rows(18, l, 0, B * n_heads)  barrier() // attention -> pb_xb
		dispatch_rows(21, l, 0, B)  barrier()          // quantize attn output
		dispatch_rows(14, l, 0, dim)  barrier()        // O -> pb_xb2
		dispatch_rows(22, l, 0, B)  barrier()          // residual x += xb2
		dispatch_rows(20, l, 0, B)  barrier()          // ffn rmsnorm+quant
		dispatch_rows(15, l, 0, hidden_dim)  barrier() // w1 -> pb_hb
		dispatch_rows(16, l, 0, hidden_dim)  barrier() // w3 -> pb_hb2
		dispatch_rows(23, l, 0, B)  barrier()          // silu*w3 + quant
		dispatch_rows(17, l, 0, dim)  barrier()        // w2 -> pb_xb
		dispatch_rows(24, l, 0, B)  barrier()          // residual x += xb
		l = l + 1
	}
}

func prefill_batch(toks, start, np) {
	ts := start
	while ts < np {
		te := ts + pb_tile
		if te > np { te = np }
		B := te - ts
		pb_B = B
		pb_tstart = ts
		b := 0
		while b < B { embed_to(toks[ts+b], pb_x + b*dim*4)  b = b + 1 }
		batch_layers(B)
		if te == np {
			i := 0
			while i < dim { poke_f32(s_x, i*4, peek_f32(pb_x + (B-1)*dim*4, i*4))  i = i + 1 }
		}
		ts = te
	}
	rmsnorm(s_x, s_x, wbuf + w_rms_final, dim)
	quantize_act(s_xq, s_xq_s, s_x, dim)
	dispatch_rows(7, 0, 0, vocab_size)  barrier()
}

// ---- speculative decoding (prompt-lookup): draft k tokens from n-gram matches
// against the confirmed sequence, verify all in ONE batched forward (weights
// read once). Exact: accepted tokens are bit-identical to greedy. ----
var spec_enabled = 0  // COLIBRI_SPEC=1
var sparse_probe = 0
var exit_layer = 0  // COLIBRI_EXIT_LAYER: if >0, decode stops after this many layers
var sp_below = 0
var sp_total = 0
var sp_massk = 0.0
var sp_massn = 0
var spec_k = 8
var spec_maxb = 16
var spec_logits = 0    // spec_maxb x vocab
var spec_argmax = 0    // spec_maxb ints
var spec_tbuf = 0      // spec_maxb ints (the batch's input tokens)

func alloc_spec() {
	spec_logits = alloc(spec_maxb * vocab_size * 4)
	spec_argmax = alloc(spec_maxb * 4)
	spec_tbuf = alloc(spec_maxb * 4)
}

// forward B tokens (in spec_tbuf) at positions [ts, ts+B): writes their KV and
// leaves spec_argmax[b] = argmax of the logits at position ts+b (predicting ts+b+1).
func spec_forward(ts, B) {
	pb_B = B
	pb_tstart = ts
	b := 0
	while b < B { embed_to(peek_i32(spec_tbuf, b*4), pb_x + b*dim*4)  b = b + 1 }
	batch_layers(B)
	dispatch_rows(26, 0, 0, B)  barrier()           // final rmsnorm + quant (per position)
	dispatch_rows(27, 0, 0, vocab_size)  barrier()  // batched classifier -> spec_logits
	b = 0
	while b < B {
		base := spec_logits + b*vocab_size*4
		best := 0
		bv := peek_f32(base, 0)
		i := 1
		while i < vocab_size {
			v := peek_f32(base, i*4)
			if v > bv { bv = v  best = i }
			i = i + 1
		}
		poke_i32(spec_argmax, b*4, best)
		b = b + 1
	}
}

// prompt-lookup: last occurrence of the 2-gram ending at seq[n-1]; propose the
// up-to-k tokens that followed it. Returns count written into a raw int buffer.
func prompt_lookup(seq, n, k, out) (cnt) {
	cnt = 0
	if n < 3 { return }
	t1 := peek_i32(seq, (n-2)*4)
	t2 := peek_i32(seq, (n-1)*4)
	i := n - 3
	while i >= 1 {
		if peek_i32(seq, (i-1)*4) == t1 && peek_i32(seq, i*4) == t2 {
			j := i + 1
			while j < n && cnt < k {
				poke_i32(out, cnt*4, peek_i32(seq, j*4))
				cnt = cnt + 1
				j = j + 1
			}
			return
		}
		i = i - 1
	}
	return
}

var spec_steps = 0
var spec_tokens = 0

// speculative decode loop. cache_buf holds confirmed tokens; on entry `token`
// is the token at position `pos` (KV not yet computed), cache_len = pos.
// Returns generated count. emit(prev, tok) via the caller's decode.
func spec_generate(pos0, token0, max_new, emit) (gen) {
	pos := pos0
	token := token0
	gen = 0
	draftbuf := alloc(spec_k * 4)
	while gen < max_new && pos < seq_len {
		if is_stop_token(token) { break }
		poke_i32(cache_buf, pos*4, token)   // confirm token at pos (for lookup + KV bookkeeping)
		k := spec_k
		if pos + 1 + k >= seq_len { k = seq_len - pos - 2 }
		nd := 0
		if k > 0 { nd = prompt_lookup(cache_buf, pos+1, k, draftbuf) }
		B := 1 + nd
		poke_i32(spec_tbuf, 0, token)
		d := 0
		while d < nd { poke_i32(spec_tbuf, (d+1)*4, peek_i32(draftbuf, d*4))  d = d + 1 }
		spec_forward(pos, B)
		spec_steps = spec_steps + 1
		// verify: spec_argmax[0] is the true token at pos+1
		a := peek_i32(spec_argmax, 0)
		emit(piece_text(token, a))
		gen = gen + 1
		spec_tokens = spec_tokens + 1
		accepted := 0
		while accepted < nd && peek_i32(spec_argmax, accepted*4) == peek_i32(draftbuf, accepted*4) && gen < max_new {
			na := peek_i32(spec_argmax, (accepted+1)*4)
			poke_i32(cache_buf, (pos+1+accepted)*4, a)
			if is_stop_token(na) { accepted = accepted + 1  break }
			emit(piece_text(a, na))
			gen = gen + 1
			spec_tokens = spec_tokens + 1
			a = na
			accepted = accepted + 1
		}
		// KV valid for positions 0..pos+accepted; `a` at pos+accepted+1 has no KV
		cache_len = pos + accepted + 1
		pos = pos + accepted + 1
		token = a
	}
	free(draftbuf)
	if len(env("COLIBRI_PROF")) > 0 {
		println("SPEC steps=" + str(spec_steps) + " tokens=" + str(spec_tokens) + " accept/step=" + str(float(spec_tokens)/float(spec_steps)))
		flush()
	}
	return
}

// generate: prefill prompt toks (reusing cached KV prefix), then decode up to
// max_new tokens. emit(piece) is called per decoded piece; returns generated count.
// Also returns via globals: gen_prefill_reused (tokens skipped thanks to cache).
var gen_prefill_reused = 0

func generate_cb(toks, max_new, temp, topp, emit) (gen) {
	np := len(toks)
	start := cache_common(toks)
	if start >= np { start = np - 1 } // always re-forward the last prompt token for fresh logits
	gen_prefill_reused = start
	// batched prefill when there's a worthwhile run of new tokens (int8 only);
	// otherwise the per-token path (also the int4 path, which has no batch kernel)
	if np - start >= 16 && quant4 == 0 && pb_enabled == 1 {
		prefill_batch(toks, start, np)
	} else {
		i := start
		while i < np {
			forward(toks[i], i)
			i = i + 1
		}
	}
	// record the prompt tokens into the persistent cache buffer
	i = 0
	while i < np { poke_i32(cache_buf, i*4, toks[i])  i = i + 1 }
	cache_len = np
	prev := 1
	if np > 0 { prev = toks[np-1] }
	// speculative (prompt-lookup) decode: greedy only (verify is argmax), int8,
	// enabled by COLIBRI_SPEC. Exact — accepted tokens == plain greedy.
	if spec_enabled == 1 && temp <= 0.0 && quant4 == 0 {
		token0 := argmax_logits()
		if is_stop_token(token0) { return }
		emit(piece_text(prev, token0))
		gen = 1 + spec_generate(np, token0, max_new - 1, emit)
		return
	}
	pos := np
	token := 0
	gen = 0
	while gen < max_new && pos < seq_len {
		token = sample_next(temp, topp)
		if is_stop_token(token) { break }
		emit(piece_text(prev, token))
		forward(token, pos)
		poke_i32(cache_buf, pos*4, token) // extend the cache with the accepted token
		cache_len = pos + 1
		prev = token
		pos = pos + 1
		gen = gen + 1
	}
	if sparse_probe == 1 && sp_total > 0 {
		println("SPARSE gate<10%%max: " + str(float(sp_below*100)/float(sp_total)) + "%% of neurons  | output-mass kept by active: " + str(float(sp_massk*100.0)/float(sp_massn)) + "%%")
		flush()
	}
	return
}

// raw BPE encode without BOS/dummy-prefix (for mid-template segments)
func bpe_encode_raw(text) (toks) {
	toks = bpe_encode_opts(text, 0, 0)
	return
}

// ---- Llama-3 support: v4 header, RoPE scaling, tiktoken BPE ----

var rope_freqs = 0 // precomputed rope_freq(hd) table, head_size/2 entries
var rope_theta = 10000.0
var l3_scaling = 0
var l3_factor = 1.0
var l3_low = 1.0
var l3_high = 1.0
var l3_orig = 8192
var tok_l3 = 0 // 1 = tiktoken (llama3), 0 = sentencepiece (llama2)

// llama3 rope frequency scaling (HF/llama.cpp formula)
func rope_freq(hd) (freq) {
	freq = 1.0 / pow(rope_theta, float(hd) / float(head_size))
	if l3_scaling == 1 {
		wavelen := 2.0 * pi() / freq
		lowwl := float(l3_orig) / l3_low
		highwl := float(l3_orig) / l3_high
		if wavelen > lowwl {
			freq = freq / l3_factor
		} else {
			if wavelen > highwl {
				smooth := (float(l3_orig) / wavelen - l3_low) / (l3_high - l3_low)
				freq = (1.0 - smooth) * (freq / l3_factor) + smooth * freq
			}
		}
	}
	return
}

// ---- tiktoken tokenizer (llama3): id -> raw bytes; encode via lowest-rank merges ----

var vocab_l3 = []string{}       // decode text (NUL-containing byte tokens degrade harmlessly)
var l3_idx = make(map[string]int) // hex(token bytes) -> id

func load_tokenizer_l3(path) {
	b := read_file_bytes(path)
	if len(b) == 0 { println("cannot read tokenizer: " + path)  exit(1) }
	n := read_i32(b, 0)
	off := 4
	i := 0
	// build into a LOCAL slice then assign the global once: appending directly
	// to a global slice reallocates its backing array every call (O(n^2); ~31s
	// for the 128k-entry llama3 vocab). One assignment at the end is O(n).
	v := []string{}
	while i < n {
		l := read_i32(b, off)
		off = off + 4
		tb := bytes_sub(b, off, off+l)
		v = append(v, bytes_str(tb))
		if i < 128000 { l3_idx[to_hex(tb)] = i }
		off = off + l
		i = i + 1
	}
	vocab_l3 = v
}

// ---- pretokenizer: hand-rolled state machine for the llama3 regex ----
// (?i:'s|'t|'re|'ve|'m|'ll|'d) | [^\r\n\p{L}\p{N}]?\p{L}+ | \p{N}{1,3}
// | ?[^\s\p{L}\p{N}]+[\r\n]* | \s*[\r\n]+ | \s+(?!\S) | \s+
// \p{L}/\p{N} approximated: exact for ASCII/Latin/Greek/Cyrillic/CJK/kana/
// Hangul/Hebrew/Arabic; rare scripts may split differently (disclosed).

func cp_at(b, i) (cp, n) {
	c := byte_at(b, i)
	cp = c
	n = 1
	if c < 128 { return }
	if (c & 224) == 192 { cp = (c & 31) << 6 | (byte_at(b, i+1) & 63)  n = 2  return }
	if (c & 240) == 224 { cp = (c & 15) << 12 | (byte_at(b, i+1) & 63) << 6 | (byte_at(b, i+2) & 63)  n = 3  return }
	cp = (c & 7) << 18 | (byte_at(b, i+1) & 63) << 12 | (byte_at(b, i+2) & 63) << 6 | (byte_at(b, i+3) & 63)
	n = 4
	return
}

func is_letter(cp) (r) {
	r = false
	if cp >= 65 && cp <= 90 { r = true  return }
	if cp >= 97 && cp <= 122 { r = true  return }
	if cp >= 192 && cp <= 591 && cp != 215 && cp != 247 { r = true  return } // Latin-1..Ext-B
	if cp >= 880 && cp <= 1023 { r = true  return }   // Greek
	if cp >= 1024 && cp <= 1279 { r = true  return }  // Cyrillic
	if cp >= 1425 && cp <= 1524 { r = true  return }  // Hebrew
	if cp >= 1536 && cp <= 1791 { r = true  return }  // Arabic
	if cp >= 12352 && cp <= 12543 { r = true  return } // kana
	if cp >= 19968 && cp <= 40959 { r = true  return } // CJK
	if cp >= 44032 && cp <= 55215 { r = true  return } // Hangul
	return
}

func is_digit_cp(cp) (r) {
	r = false
	if cp >= 48 && cp <= 57 { r = true }
	return
}

func is_space_cp(cp) (r) {
	r = false
	if cp == 32 || cp == 9 || cp == 10 || cp == 13 || cp == 12 || cp == 11 || cp == 160 { r = true }
	return
}

// contraction suffix at byte offset i (after an apostrophe was seen AT i): 's 't 're 've 'm 'll 'd
func l3_contraction_len(b, i, n) (l) {
	l = 0
	if byte_at(b, i) != 39 { return } // '
	if i + 1 >= n { return }
	c1 := byte_at(b, i+1) | 32
	if c1 == 115 || c1 == 116 || c1 == 109 || c1 == 100 { l = 2  return } // 's 't 'm 'd
	if i + 2 < n {
		c2 := byte_at(b, i+2) | 32
		if (c1 == 114 && c2 == 101) || (c1 == 118 && c2 == 101) || (c1 == 108 && c2 == 108) { l = 3  return } // 're 've 'll
	}
	return
}

func l3_pretok(text) (parts) {
	parts = []string{}
	b := bytes(text)
	n := len(b)
	i := 0
	while i < n {
		// 1. contraction
		cl := l3_contraction_len(b, i, n)
		if cl > 0 { parts = append(parts, bytes_str(bytes_sub(b, i, i+cl)))  i = i + cl  continue }
		cp, w := cp_at(b, i)
		// 2. optional non-letter/digit/newline char + letter run
		j := i
		pfx := 0
		if is_letter(cp) == false && is_digit_cp(cp) == false && cp != 10 && cp != 13 {
			j = i + w
			pfx = 1
		}
		if j < n {
			c2, w2 := cp_at(b, j)
			if is_letter(c2) {
				k := j
				while k < n {
					c3, w3 := cp_at(b, k)
					if is_letter(c3) == false { break }
					k = k + w3
					w2 = w2
				}
				// don't let a letter run absorb an apostrophe-contraction boundary; regex doesn't either
				parts = append(parts, bytes_str(bytes_sub(b, i, k)))
				i = k
				continue
			}
		}
		if pfx == 1 { j = i } // reset if prefix path failed
		// 3. 1-3 digits
		if is_digit_cp(cp) {
			k := i
			cnt := 0
			while k < n && cnt < 3 {
				c3, w3 := cp_at(b, k)
				if is_digit_cp(c3) == false { break }
				k = k + w3
				cnt = cnt + 1
			}
			parts = append(parts, bytes_str(bytes_sub(b, i, k)))
			i = k
			continue
		}
		// 4. optional space + punct run + trailing newlines
		j = i
		if cp == 32 { j = i + 1 }
		if j < n {
			c2, w2 := cp_at(b, j)
			if is_space_cp(c2) == false && is_letter(c2) == false && is_digit_cp(c2) == false {
				k := j
				while k < n {
					c3, w3 := cp_at(b, k)
					if is_space_cp(c3) || is_letter(c3) || is_digit_cp(c3) { break }
					k = k + w3
				}
				while k < n && (byte_at(b, k) == 10 || byte_at(b, k) == 13) { k = k + 1 }
				parts = append(parts, bytes_str(bytes_sub(b, i, k)))
				i = k
				continue
			}
		}
		// 5/6/7. whitespace forms
		if is_space_cp(cp) {
			k := i
			has_nl := 0
			last_nl_end := i
			while k < n {
				c3, w3 := cp_at(b, k)
				if is_space_cp(c3) == false { break }
				k = k + w3
				if c3 == 10 || c3 == 13 { has_nl = 1  last_nl_end = k }
			}
			// \s*[\r\n]+ : whitespace ending in newline(s) — match up to last newline
			if has_nl == 1 && last_nl_end > i {
				trail := 1
				m := last_nl_end
				while m < k { // only spaces after last newline remain
					m = m + 1
				}
				parts = append(parts, bytes_str(bytes_sub(b, i, last_nl_end)))
				i = last_nl_end
				trail = trail
				continue
			}
			// \s+(?!\S): all but the last space if a word follows
			if k < n && k - i > 1 {
				parts = append(parts, bytes_str(bytes_sub(b, i, k-1)))
				i = k - 1
				continue
			}
			if k == n {
				parts = append(parts, bytes_str(bytes_sub(b, i, k)))
				i = k
				continue
			}
			// single space before non-space: shouldn't reach (case 2/4 handle), but be safe
			parts = append(parts, bytes_str(bytes_sub(b, i, k)))
			i = k
			continue
		}
		// fallback: single codepoint
		parts = append(parts, bytes_str(bytes_sub(b, i, i+w)))
		i = i + w
	}
	return
}

// tiktoken BPE over one pretoken: greedy lowest-id adjacent merge, hex-string symbols
func l3_bpe_piece(piece) (ids) {
	ids = []int{}
	pb := bytes(piece)
	syms := []string{}
	i := 0
	while i < len(pb) {
		syms = append(syms, to_hex(bytes_sub(pb, i, i+1)))
		i = i + 1
	}
	while len(syms) > 1 {
		best := -1
		best_id := 999999999
		i = 0
		while i < len(syms) - 1 {
			m := syms[i] + syms[i+1]
			if has(l3_idx, m) {
				id := l3_idx[m]
				if id < best_id { best_id = id  best = i }
			}
			i = i + 1
		}
		if best < 0 { break }
		ns := []string{}
		i = 0
		while i < len(syms) {
			if i == best { ns = append(ns, syms[i] + syms[i+1])  i = i + 2 } else { ns = append(ns, syms[i])  i = i + 1 }
		}
		syms = ns
	}
	i = 0
	while i < len(syms) {
		if has(l3_idx, syms[i]) { ids = append(ids, l3_idx[syms[i]]) }
		i = i + 1
	}
	return
}

// encode text with the llama3 tokenizer (no specials)
func l3_encode(text) (ids) {
	ids = []int{}
	parts := l3_pretok(text)
	i := 0
	while i < len(parts) {
		sub := l3_bpe_piece(parts[i])
		j := 0
		while j < len(sub) { ids = append(ids, sub[j])  j = j + 1 }
		i = i + 1
	}
	return
}

// unified helpers used by cli/serve
func load_tokenizer_auto() {
	if vocab_size > 100000 { tok_l3 = 1  load_tokenizer_l3("models/tokenizer-l3.bin")  return }
	load_tokenizer("models/tokenizer.bin")
}

func encode_text(text) (ids) {
	if tok_l3 == 1 {
		ids = []int{}
		ids = append(ids, 128000) // <|begin_of_text|>
		sub := l3_encode(text)
		i := 0
		while i < len(sub) { ids = append(ids, sub[i])  i = i + 1 }
		return
	}
	ids = bpe_encode(text)
	return
}

func piece_text(prev, token) (s) {
	if tok_l3 == 1 {
		s = ""
		if token < 128000 { s = vocab_l3[token] }
		return
	}
	s = decode_piece(prev, token)
	return
}

func is_stop_token(t) (r) {
	r = false
	if tok_l3 == 1 {
		if t == 128009 || t == 128001 || t == 128008 { r = true }
		return
	}
	if t == 1 || t == 2 { r = true }
	return
}
