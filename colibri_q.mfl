var dim=0

var hidden_dim=0

var n_layers=0

var n_heads=0

var n_kv_heads=0

var vocab_size=0

var seq_len=0

var head_size=0

var kv_dim=0

var gs=0

var shared_cls=0

var quant4=0

var wbuf=0

var w_rms_att=0

var w_rms_ffn=0

var w_rms_final=0

var w_tok=0

var wq_b=0

var wk_b=0

var wv_b=0

var wo_b=0

var w1_b=0

var w2_b=0

var w3_b=0

var wcls_b=0

var s_x=0

var s_xb=0

var s_xb2=0

var s_hb=0

var s_hb2=0

var s_q=0

var s_att=0

var s_logits=0

var s_key_cache=0

var s_val_cache=0

var s_xq=0

var s_xq_s=0

var s_hq=0

var s_hq_s=0

var vocab=[]string{}

var vocab_idx=make(map[string]int)

var tok_scores=0

func read_i32(b,off)(v){v=byte_at(b,off)|byte_at(b,off+1)<<8|byte_at(b,off+2)<<16|byte_at(b,off+3)<<24 if v>=2147483648{v=v-4294967296}return}

func bytes_to_buf(b)(p){n:=len(b)p=alloc(n+4)i:=0 while i+4<=n{w:=byte_at(b,i)|byte_at(b,i+1)<<8|byte_at(b,i+2)<<16|byte_at(b,i+3)<<24 poke_i32(p,i,w)i=i+4}while i<n{poke_u8(p,i,byte_at(b,i))i=i+1}return}

func wsz(size)(n){n=size  if quant4==1{n=size/2}return}

func f32_at(b,off)(v){p:=alloc(4)poke_i32(p,0,byte_at(b,off)|byte_at(b,off+1)<<8|byte_at(b,off+2)<<16|byte_at(b,off+3)<<24)v=peek_f32(p,0)free(p)return}

func qblock(size)(n){n=wsz(size)+4*(size/gs)return}

func load_model(path){mb,_:=mmap_file(path)wbuf=mb if wbuf==0{println("cannot mmap model: "+path)exit(1)}m:=peek_i32(wbuf,0)v4:=0 if m==1634415666{quant4=0}else{if m==1634415667{quant4=1}else{if m==1634415668{quant4=0  v4=1}else{println("bad magic (want ak42/ak43/ak44)")exit(1)}}}dim=peek_i32(wbuf,8)hidden_dim=peek_i32(wbuf,12)n_layers=peek_i32(wbuf,16)n_heads=peek_i32(wbuf,20)n_kv_heads=peek_i32(wbuf,24)vocab_size=peek_i32(wbuf,28)seq_len=peek_i32(wbuf,32)shared_cls=peek_u8(wbuf,36)gs=peek_i32(wbuf,37)if v4==1{rope_theta=peek_f32(wbuf,41)l3_scaling=peek_u8(wbuf,45)l3_factor=peek_f32(wbuf,46)l3_low=peek_f32(wbuf,50)l3_high=peek_f32(wbuf,54)l3_orig=peek_i32(wbuf,58)}head_size=dim/n_heads kv_dim=(dim*n_kv_heads)/n_heads o:=256 w_rms_att=o    o=o+n_layers*dim*4 w_rms_ffn=o    o=o+n_layers*dim*4 w_rms_final=o  o=o+dim*4 w_tok=o        o=o+qblock(vocab_size*dim)wq_b=o         o=o+n_layers*qblock(dim*dim)wk_b=o         o=o+n_layers*qblock(dim*kv_dim)wv_b=o         o=o+n_layers*qblock(dim*kv_dim)wo_b=o         o=o+n_layers*qblock(dim*dim)w1_b=o         o=o+n_layers*qblock(dim*hidden_dim)w2_b=o         o=o+n_layers*qblock(hidden_dim*dim)w3_b=o         o=o+n_layers*qblock(dim*hidden_dim)if shared_cls==1{wcls_b=w_tok}else{wcls_b=o}}

func alloc_state(){s_x=alloc(dim*4)s_xb=alloc(dim*4)s_xb2=alloc(dim*4)s_hb=alloc(hidden_dim*4)s_hb2=alloc(hidden_dim*4)s_q=alloc(dim*4)s_att=alloc(n_heads*seq_len*4)s_logits=alloc(vocab_size*4)s_key_cache=alloc(n_layers*seq_len*kv_dim*4)s_val_cache=alloc(n_layers*seq_len*kv_dim*4)s_xq=alloc(dim)s_xq_s=alloc((dim/gs)*4)s_hq=alloc(hidden_dim)s_hq_s=alloc((hidden_dim/gs)*4)}

func load_tokenizer(path){b:=read_file_bytes(path)if len(b)==0{println("cannot read tokenizer: "+path)exit(1)}tbuf:=bytes_to_buf(b)tok_scores=alloc(vocab_size*4)off:=4 i:=0 while i<vocab_size{poke_f32(tok_scores,i*4,peek_f32(tbuf,off))off=off+4 n:=read_i32(b,off)off=off+4 piece:=bytes_str(bytes_sub(b,off,off+n))vocab=append(vocab,piece)vocab_idx[piece]=i off=off+n i=i+1}free(tbuf)}

func rmsnorm(dst,x,w,size){ss:=0.0 j:=0 while j<size{v:=peek_f32(x,j*4)ss=ss+v*v j=j+1}ss=ss/float(size)ss=1.0/sqrt(ss+0.00001)j=0 while j<size{poke_f32(dst,j*4,peek_f32(w,j*4)*ss*peek_f32(x,j*4))j=j+1}}

func softmax(x,size){mx:=peek_f32(x,0)i:=1 while i<size{v:=peek_f32(x,i*4)if v>mx{mx=v}i=i+1}sum:=0.0 i=0 while i<size{e:=exp(peek_f32(x,i*4)-mx)poke_f32(x,i*4,e)sum=sum+e i=i+1}i=0 while i<size{poke_f32(x,i*4,peek_f32(x,i*4)/sum)i=i+1}}

func quantize_act(xq,xs,x,n){ng:=n/gs g:=0 while g<ng{base:=g*gs wmax:=0.0 i:=0 while i<gs{v:=abs(peek_f32(x,(base+i)*4))if v>wmax{wmax=v}i=i+1}scale:=wmax/127.0 poke_f32(xs,g*4,scale)i=0 while i<gs{q:=0 if scale>0.0{q=int(round(peek_f32(x,(base+i)*4)/scale))}poke_u8(xq,base+i,q&255)i=i+1}g=g+1}}

func matmul_q(xout,xq,xs,wq,ws,n,lo,hi){i:=lo while i<hi{val:=0.0 in:=i*n wrow:=wbuf+wq+in j:=0 while j<n{ival:=dot_i8(xq+j,wrow+j,gs)val=val+float(ival)*peek_f32(wbuf,ws+((in+j)/gs)*4)*peek_f32(xs,(j/gs)*4)j=j+gs}poke_f32(xout,i*4,val)i=i+1}}

func matmul_q4(xout,xq,xs,wq,ws,n,lo,hi,sc){h:=gs/2 i:=lo while i<hi{wrow:=wbuf+wq+i*(n/2)g:=0 while g<n/gs{wg:=wrow+g*h sg:=sc+g*gs k:=0 while k<h{b:=peek_u8(wg,k)poke_u8(sg,k,((b&15)-8)&255)poke_u8(sg,k+h,((b>>4)-8)&255)k=k+1}g=g+1}val:=0.0 in:=i*n j:=0 while j<n{ival:=dot_i8(xq+j,sc+j,gs)val=val+float(ival)*peek_f32(wbuf,ws+((in+j)/gs)*4)*peek_f32(xs,(j/gs)*4)j=j+gs}poke_f32(xout,i*4,val)i=i+1}}

func mmj(xout,xq,xs,tb,tsize,n,lo,hi,sc){if quant4==1{matmul_q4(xout,xq,xs,tb,tb+wsz(tsize),n,lo,hi,sc)}else{matmul_q(xout,xq,xs,tb,tb+wsz(tsize),n,lo,hi)}}

func embed_token(token){row:=token*dim sbase:=w_tok+wsz(vocab_size*dim)if quant4==1{h:=gs/2 g:=0 while g<dim/gs{gq:=w_tok+token*(dim/2)+g*h sc:=peek_f32(wbuf,sbase+((row+g*gs)/gs)*4)i:=0 while i<h{b:=peek_u8(wbuf,gq+i)poke_f32(s_x,(g*gs+i)*4,float((b&15)-8)*sc)poke_f32(s_x,(g*gs+i+h)*4,float((b>>4)-8)*sc)i=i+1}g=g+1}return}i:=0 while i<dim{poke_f32(s_x,i*4,float(peek_i8(wbuf,w_tok+row+i))*peek_f32(wbuf,sbase+((row+i)/gs)*4))i=i+1}}

func rope(l,pos){kptr:=s_key_cache+(l*seq_len*kv_dim+pos*kv_dim)*4 i:=0 while i<dim{hd:=i%head_size freq:=rope_freq(hd)val:=float(pos)*freq fcr:=cos(val)fci:=sin(val)q0:=peek_f32(s_q,i*4)q1:=peek_f32(s_q,i*4+4)poke_f32(s_q,i*4,q0*fcr-q1*fci)poke_f32(s_q,i*4+4,q0*fci+q1*fcr)if i<kv_dim{k0:=peek_f32(kptr,i*4)k1:=peek_f32(kptr,i*4+4)poke_f32(kptr,i*4,k0*fcr-k1*fci)poke_f32(kptr,i*4+4,k0*fci+k1*fcr)}i=i+2}}

func attn_head(h,l,pos){loff:=l*seq_len*kv_dim kv_mul:=n_heads/n_kv_heads qh:=s_q+h*head_size*4 atth:=s_att+h*seq_len*4 t:=0 while t<=pos{kt:=s_key_cache+(loff+t*kv_dim+(h/kv_mul)*head_size)*4 score:=0.0 j:=0 while j<head_size{score=score+peek_f32(qh,j*4)*peek_f32(kt,j*4)j=j+1}poke_f32(atth,t*4,score/sqrt(float(head_size)))t=t+1}softmax(atth,pos+1)xbh:=s_xb+h*head_size*4 j:=0 while j<head_size{poke_f32(xbh,j*4,0.0)j=j+1}t=0 while t<=pos{vt:=s_val_cache+(loff+t*kv_dim+(h/kv_mul)*head_size)*4 a:=peek_f32(atth,t*4)j=0 while j<head_size{poke_f32(xbh,j*4,peek_f32(xbh,j*4)+a*peek_f32(vt,j*4))j=j+1}t=t+1}}

var n_workers=1

var jobs=make(chan int)

var done=make(chan int)

var pending=0

func do_job(j,sc){t:=j&15 l:=(j>>4)&255 pos:=(j>>12)&4095 lo:=(j>>24)&1048575 hi:=j>>44 if t==0{mmj(s_q,s_xq,s_xq_s,wq_b+l*qblock(dim*dim),dim*dim,dim,lo,hi,sc)}if t==1{kptr:=s_key_cache+(l*seq_len*kv_dim+pos*kv_dim)*4 mmj(kptr,s_xq,s_xq_s,wk_b+l*qblock(dim*kv_dim),dim*kv_dim,dim,lo,hi,sc)}if t==2{vptr:=s_val_cache+(l*seq_len*kv_dim+pos*kv_dim)*4 mmj(vptr,s_xq,s_xq_s,wv_b+l*qblock(dim*kv_dim),dim*kv_dim,dim,lo,hi,sc)}if t==3{mmj(s_xb2,s_xq,s_xq_s,wo_b+l*qblock(dim*dim),dim*dim,dim,lo,hi,sc)}if t==4{mmj(s_hb,s_xq,s_xq_s,w1_b+l*qblock(dim*hidden_dim),dim*hidden_dim,dim,lo,hi,sc)}if t==5{mmj(s_hb2,s_xq,s_xq_s,w3_b+l*qblock(dim*hidden_dim),dim*hidden_dim,dim,lo,hi,sc)}if t==6{mmj(s_xb,s_hq,s_hq_s,w2_b+l*qblock(hidden_dim*dim),hidden_dim*dim,hidden_dim,lo,hi,sc)}if t==7{mmj(s_logits,s_xq,s_xq_s,wcls_b,dim*vocab_size,dim,lo,hi,sc)}if t==8{h:=lo while h<hi{attn_head(h,l,pos)h=h+1}}if t==9{mmj(s_q,s_xq,s_xq_s,wq_b+l*qblock(dim*dim),dim*dim,dim,lo,hi,sc)klo:=(lo*kv_dim)/dim khi:=(hi*kv_dim)/dim if khi>klo{kptr:=s_key_cache+(l*seq_len*kv_dim+pos*kv_dim)*4 vptr:=s_val_cache+(l*seq_len*kv_dim+pos*kv_dim)*4 mmj(kptr,s_xq,s_xq_s,wk_b+l*qblock(dim*kv_dim),dim*kv_dim,dim,klo,khi,sc)mmj(vptr,s_xq,s_xq_s,wv_b+l*qblock(dim*kv_dim),dim*kv_dim,dim,klo,khi,sc)}}if t==10{mmj(s_hb,s_xq,s_xq_s,w1_b+l*qblock(dim*hidden_dim),dim*hidden_dim,dim,lo,hi,sc)mmj(s_hb2,s_xq,s_xq_s,w3_b+l*qblock(dim*hidden_dim),dim*hidden_dim,dim,lo,hi,sc)}}

func worker(jc,dc){sc:=alloc(hidden_dim)for j:=range jc{do_job(j,sc)dc<-1}}

func dispatch_rows(t,l,pos,d){nc:=n_workers if nc>d{nc=d}chunk:=(d+nc-1)/nc lo:=0 while lo<d{hi:=lo+chunk if hi>d{hi=d}if pending>=n_workers{<-done  pending=pending-1}jobs<-(t|l<<4|pos<<12|lo<<24|hi<<44)pending=pending+1 lo=hi}}

func barrier(){while pending>0{<-done  pending=pending-1}}

func forward(token,pos){embed_token(token)i:=0 l:=0 while l<n_layers{rmsnorm(s_xb,s_x,wbuf+w_rms_att+l*dim*4,dim)quantize_act(s_xq,s_xq_s,s_xb,dim)dispatch_rows(9,l,pos,dim)barrier()rope(l,pos)dispatch_rows(8,l,pos,n_heads)barrier()quantize_act(s_xq,s_xq_s,s_xb,dim)dispatch_rows(3,l,pos,dim)barrier()i=0 while i<dim{poke_f32(s_x,i*4,peek_f32(s_x,i*4)+peek_f32(s_xb2,i*4))i=i+1}rmsnorm(s_xb,s_x,wbuf+w_rms_ffn+l*dim*4,dim)quantize_act(s_xq,s_xq_s,s_xb,dim)dispatch_rows(10,l,pos,hidden_dim)barrier()i=0 while i<hidden_dim{v:=peek_f32(s_hb,i*4)v=v*(1.0/(1.0+exp(0.0-v)))poke_f32(s_hb,i*4,v*peek_f32(s_hb2,i*4))i=i+1}quantize_act(s_hq,s_hq_s,s_hb,hidden_dim)dispatch_rows(6,l,pos,dim)barrier()i=0 while i<dim{poke_f32(s_x,i*4,peek_f32(s_x,i*4)+peek_f32(s_xb,i*4))i=i+1}l=l+1}rmsnorm(s_x,s_x,wbuf+w_rms_final,dim)quantize_act(s_xq,s_xq_s,s_x,dim)dispatch_rows(7,0,pos,vocab_size)barrier()}

func argmax_logits()(best){best=0 bv:=peek_f32(s_logits,0)i:=1 while i<vocab_size{v:=peek_f32(s_logits,i*4)if v>bv{bv=v  best=i}i=i+1}return}

func bpe_encode(text)(toks){toks=bpe_encode_opts(text,1,1)return}

func bpe_encode_opts(text,add_bos,add_prefix)(toks){toks=[]int{}if add_bos==1{toks=append(toks,1)}if len(text)==0{return}if add_prefix==1{toks=append(toks,vocab_idx[" "])}b:=bytes(text)n:=len(b)i:=0 while i<n{j:=i+1 while j<n&&(byte_at(b,j)&192)==128{j=j+1}c:=bytes_str(bytes_sub(b,i,j))if has(vocab_idx,c){toks=append(toks,vocab_idx[c])}else{k:=i while k<j{toks=append(toks,byte_at(b,k)+3)k=k+1}}i=j}while true{best_score:=0.0-1000000000.0 best_id:=-1 best_idx:=-1 ti:=0 while ti<len(toks)-1{merged:=vocab[toks[ti]]+vocab[toks[ti+1]]if has(vocab_idx,merged){id:=vocab_idx[merged]sc:=peek_f32(tok_scores,id*4)if sc>best_score{best_score=sc  best_id=id  best_idx=ti}}ti=ti+1}if best_idx==-1{break}nt:=[]int{}ti=0 while ti<len(toks){if ti==best_idx{nt=append(nt,best_id)ti=ti+2}else{nt=append(nt,toks[ti])ti=ti+1}}toks=nt}return}

func decode_piece(prev,token)(piece){piece=vocab[token]if prev==1&&has_prefix(piece," "){piece=substr(piece,1,len(piece))}if has_prefix(piece,"<0x")&&has_suffix(piece,">"){piece=bytes_str(from_hex(substr(piece,3,5)))}return}

var rng_state=12345

func rng_seed(s){if s<=0{s=1}rng_state=s&2147483647}

func rng_f()(r){rng_state=(rng_state*1103515245+12345)&2147483647 r=float(rng_state)/2147483648.0 return}

func logits_softmax(temp){i:=0 while i<vocab_size{poke_f32(s_logits,i*4,peek_f32(s_logits,i*4)/temp)i=i+1}softmax(s_logits,vocab_size)}

func sample_topp(topp)(tok){cutoff:=(1.0-topp)/float(vocab_size-1)idx:=[]int{}i:=0 while i<vocab_size{if peek_f32(s_logits,i*4)>=cutoff{idx=append(idx,i)}i=i+1}n:=len(idx)lo_s:=[]int{0}hi_s:=[]int{n-1}while len(lo_s)>0{lo:=lo_s[len(lo_s)-1]hi:=hi_s[len(hi_s)-1]nl:=[]int{}nh:=[]int{}k:=0 while k<len(lo_s)-1{nl=append(nl,lo_s[k])nh=append(nh,hi_s[k])k=k+1}lo_s=nl hi_s=nh if lo<hi{pv:=peek_f32(s_logits,idx[(lo+hi)/2]*4)a:=lo b:=hi while a<=b{while peek_f32(s_logits,idx[a]*4)>pv{a=a+1}while peek_f32(s_logits,idx[b]*4)<pv{b=b-1}if a<=b{t:=idx[a]idx[a]=idx[b]idx[b]=t a=a+1 b=b-1}}if lo<b{lo_s=append(lo_s,lo)hi_s=append(hi_s,b)}if a<hi{lo_s=append(lo_s,a)hi_s=append(hi_s,hi)}}}cum:=0.0 last:=n-1 i=0 while i<n{cum=cum+peek_f32(s_logits,idx[i]*4)if cum>topp{last=i  break}i=i+1}r:=rng_f()*cum cdf:=0.0 tok=idx[last]i=0 while i<=last{cdf=cdf+peek_f32(s_logits,idx[i]*4)if r<cdf{tok=idx[i]return}i=i+1}return}

func sample_next(temp,topp)(tok){if temp<=0.0{tok=argmax_logits()return}logits_softmax(temp)if topp>0.0&&topp<1.0{tok=sample_topp(topp)return}r:=rng_f()cdf:=0.0 tok=vocab_size-1 i:=0 while i<vocab_size{cdf=cdf+peek_f32(s_logits,i*4)if r<cdf{tok=i  return}i=i+1}return}

var cache_toks=[]int{}

func cache_common(toks)(l){l=0 n:=len(toks)if len(cache_toks)<n{n=len(cache_toks)}while l<n{if cache_toks[l]!=toks[l]{return}l=l+1}return}

var gen_prefill_reused=0

func generate_cb(toks,max_new,temp,topp,emit)(gen){np:=len(toks)start:=cache_common(toks)if start>=np{start=np-1}gen_prefill_reused=start i:=start while i<np{forward(toks[i],i)i=i+1}nc:=[]int{}i=0 while i<np{nc=append(nc,toks[i])i=i+1}pos:=np token:=0 gen=0 while gen<max_new&&pos<seq_len{token=sample_next(temp,topp)if is_stop_token(token){break}prev:=1 if gen>0||np>0{prev=nc[len(nc)-1]}emit(piece_text(prev,token))nc=append(nc,token)forward(token,pos)pos=pos+1 gen=gen+1}cache_toks=nc return}

func bpe_encode_raw(text)(toks){toks=bpe_encode_opts(text,0,0)return}

var rope_theta=10000.0

var l3_scaling=0

var l3_factor=1.0

var l3_low=1.0

var l3_high=1.0

var l3_orig=8192

var tok_l3=0

func rope_freq(hd)(freq){freq=1.0/pow(rope_theta,float(hd)/float(head_size))if l3_scaling==1{wavelen:=2.0*pi()/freq lowwl:=float(l3_orig)/l3_low highwl:=float(l3_orig)/l3_high if wavelen>lowwl{freq=freq/l3_factor}else{if wavelen>highwl{smooth:=(float(l3_orig)/wavelen-l3_low)/(l3_high-l3_low)freq=(1.0-smooth)*(freq/l3_factor)+smooth*freq}}}return}

var vocab_l3=[]string{}

var l3_idx=make(map[string]int)

func load_tokenizer_l3(path){b:=read_file_bytes(path)if len(b)==0{println("cannot read tokenizer: "+path)exit(1)}n:=read_i32(b,0)off:=4 i:=0 v:=[]string{}while i<n{l:=read_i32(b,off)off=off+4 tb:=bytes_sub(b,off,off+l)v=append(v,bytes_str(tb))if i<128000{l3_idx[to_hex(tb)]=i}off=off+l i=i+1}vocab_l3=v}

func cp_at(b,i)(cp,n){c:=byte_at(b,i)cp=c n=1 if c<128{return}if(c&224)==192{cp=(c&31)<<6|(byte_at(b,i+1)&63)n=2  return}if(c&240)==224{cp=(c&15)<<12|(byte_at(b,i+1)&63)<<6|(byte_at(b,i+2)&63)n=3  return}cp=(c&7)<<18|(byte_at(b,i+1)&63)<<12|(byte_at(b,i+2)&63)<<6|(byte_at(b,i+3)&63)n=4 return}

func is_letter(cp)(r){r=false if cp>=65&&cp<=90{r=true  return}if cp>=97&&cp<=122{r=true  return}if cp>=192&&cp<=591&&cp!=215&&cp!=247{r=true  return}if cp>=880&&cp<=1023{r=true  return}if cp>=1024&&cp<=1279{r=true  return}if cp>=1425&&cp<=1524{r=true  return}if cp>=1536&&cp<=1791{r=true  return}if cp>=12352&&cp<=12543{r=true  return}if cp>=19968&&cp<=40959{r=true  return}if cp>=44032&&cp<=55215{r=true  return}return}

func is_digit_cp(cp)(r){r=false if cp>=48&&cp<=57{r=true}return}

func is_space_cp(cp)(r){r=false if cp==32||cp==9||cp==10||cp==13||cp==12||cp==11||cp==160{r=true}return}

func l3_contraction_len(b,i,n)(l){l=0 if byte_at(b,i)!=39{return}if i+1>=n{return}c1:=byte_at(b,i+1)|32 if c1==115||c1==116||c1==109||c1==100{l=2  return}if i+2<n{c2:=byte_at(b,i+2)|32 if(c1==114&&c2==101)||(c1==118&&c2==101)||(c1==108&&c2==108){l=3  return}}return}

func l3_pretok(text)(parts){parts=[]string{}b:=bytes(text)n:=len(b)i:=0 while i<n{cl:=l3_contraction_len(b,i,n)if cl>0{parts=append(parts,bytes_str(bytes_sub(b,i,i+cl)))i=i+cl  continue}cp,w:=cp_at(b,i)j:=i pfx:=0 if is_letter(cp)==false&&is_digit_cp(cp)==false&&cp!=10&&cp!=13{j=i+w pfx=1}if j<n{c2,w2:=cp_at(b,j)if is_letter(c2){k:=j while k<n{c3,w3:=cp_at(b,k)if is_letter(c3)==false{break}k=k+w3 w2=w2}parts=append(parts,bytes_str(bytes_sub(b,i,k)))i=k continue}}if pfx==1{j=i}if is_digit_cp(cp){k:=i cnt:=0 while k<n&&cnt<3{c3,w3:=cp_at(b,k)if is_digit_cp(c3)==false{break}k=k+w3 cnt=cnt+1}parts=append(parts,bytes_str(bytes_sub(b,i,k)))i=k continue}j=i if cp==32{j=i+1}if j<n{c2,w2:=cp_at(b,j)if is_space_cp(c2)==false&&is_letter(c2)==false&&is_digit_cp(c2)==false{k:=j while k<n{c3,w3:=cp_at(b,k)if is_space_cp(c3)||is_letter(c3)||is_digit_cp(c3){break}k=k+w3}while k<n&&(byte_at(b,k)==10||byte_at(b,k)==13){k=k+1}parts=append(parts,bytes_str(bytes_sub(b,i,k)))i=k continue}}if is_space_cp(cp){k:=i has_nl:=0 last_nl_end:=i while k<n{c3,w3:=cp_at(b,k)if is_space_cp(c3)==false{break}k=k+w3 if c3==10||c3==13{has_nl=1  last_nl_end=k}}if has_nl==1&&last_nl_end>i{trail:=1 m:=last_nl_end while m<k{m=m+1}parts=append(parts,bytes_str(bytes_sub(b,i,last_nl_end)))i=last_nl_end trail=trail continue}if k<n&&k-i>1{parts=append(parts,bytes_str(bytes_sub(b,i,k-1)))i=k-1 continue}if k==n{parts=append(parts,bytes_str(bytes_sub(b,i,k)))i=k continue}parts=append(parts,bytes_str(bytes_sub(b,i,k)))i=k continue}parts=append(parts,bytes_str(bytes_sub(b,i,i+w)))i=i+w}return}

func l3_bpe_piece(piece)(ids){ids=[]int{}pb:=bytes(piece)syms:=[]string{}i:=0 while i<len(pb){syms=append(syms,to_hex(bytes_sub(pb,i,i+1)))i=i+1}while len(syms)>1{best:=-1 best_id:=999999999 i=0 while i<len(syms)-1{m:=syms[i]+syms[i+1]if has(l3_idx,m){id:=l3_idx[m]if id<best_id{best_id=id  best=i}}i=i+1}if best<0{break}ns:=[]string{}i=0 while i<len(syms){if i==best{ns=append(ns,syms[i]+syms[i+1])i=i+2}else{ns=append(ns,syms[i])i=i+1}}syms=ns}i=0 while i<len(syms){if has(l3_idx,syms[i]){ids=append(ids,l3_idx[syms[i]])}i=i+1}return}

func l3_encode(text)(ids){ids=[]int{}parts:=l3_pretok(text)i:=0 while i<len(parts){sub:=l3_bpe_piece(parts[i])j:=0 while j<len(sub){ids=append(ids,sub[j])j=j+1}i=i+1}return}

func load_tokenizer_auto(){if vocab_size>100000{tok_l3=1  load_tokenizer_l3("models/tokenizer-l3.bin")return}load_tokenizer("models/tokenizer.bin")}

func encode_text(text)(ids){if tok_l3==1{ids=[]int{}ids=append(ids,128000)sub:=l3_encode(text)i:=0 while i<len(sub){ids=append(ids,sub[i])i=i+1}return}ids=bpe_encode(text)return}

func piece_text(prev,token)(s){if tok_l3==1{s="" if token<128000{s=vocab_l3[token]}return}s=decode_piece(prev,token)return}

func is_stop_token(t)(r){r=false if tok_l3==1{if t==128009||t==128001||t==128008{r=true}return}if t==1||t==2{r=true}return}

func main(){a:=args()model:="models/tinyllama-1.1b-q80.bin" steps:=64 prompt:="" if len(a)>1{model=a[1]}if len(a)>2{steps=parse_int(a[2])}if len(a)>3{prompt=a[3]}nw:=parse_int(env("COLIBRI_THREADS"))if nw>0{n_workers=nw}else{n_workers=8}t0:=now_ms()load_model(model)alloc_state()load_tokenizer_auto()w:=0 while w<n_workers{go worker(jobs,done)w=w+1}t1:=now_ms()println("loaded: dim="+str(dim)+" hidden="+str(hidden_dim)+" layers="+str(n_layers)+" heads="+str(n_heads)+" kv_heads="+str(n_kv_heads)+" vocab="+str(vocab_size)+" seq="+str(seq_len)+" gs="+str(gs)+" shared_cls="+str(shared_cls)+" ("+str(t1-t0)+" ms)")if steps>seq_len{steps=seq_len}ptoks:=encode_text(prompt)token:=ptoks[0]pos:=0 t2:=now_ms()dl:=env("DL")while pos<steps{forward(token,pos)if len(dl)>0{am:=argmax_logits()println("DL "+str(pos)+" tok="+str(token)+" argmax="+str(am)+" v="+str(peek_f32(s_logits,am*4))+" l0="+str(peek_f32(s_logits,0))+" l1="+str(peek_f32(s_logits,4))+" l2="+str(peek_f32(s_logits,8)))}next:=0 if pos<len(ptoks)-1{next=ptoks[pos+1]}else{next=argmax_logits()}pos=pos+1 if is_stop_token(next){break}print(piece_text(token,next))flush()token=next}t3:=now_ms()println("")if t3>t2&&pos>0{tps:=float(pos)*1000.0/float(t3-t2)println("tokens: "+str(pos)+"  time: "+str(t3-t2)+" ms  tok/s: "+str(tps))}}

