func main() {
	a := args()
	path := "models/qwen-q8.bin"
	if len(a) > 1 { path = a[1] }
	qwen_init(path)
	println("Qwen loaded: D=" + str(D) + " L=" + str(L) + " heads=" + str(NH) + "/" + str(NKV) + " KV=" + str(KV) + " inter=" + str(II) + " vocab=" + str(VOCAB) + " ctx=" + str(SEQ) + " | " + str(n_workers) + " workers")
	flush()
	// prompt ids passed as args (space-sep), else default
	p := []int{}
	if len(a) > 2 {
		parts := split(a[2], ",")
		i := 0
		while i < len(parts) { p = append(p, parse_int(parts[i]))  i = i + 1 }
	} else {
		p = append(p, 785)  // fallback
	}
	t0 := now_ms()
	ids := gen_ids(p, len(p), 12)
	t1 := now_ms()
	s := ""
	i := 0
	while i < len(ids) { s = s + str(ids[i])  if i < len(ids)-1 { s = s + ", " }  i = i + 1 }
	println("gen: [" + s + "]  " + str(float((len(p)-1+len(ids))*1000)/float(t1-t0)) + " tok/s")
}
