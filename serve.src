// colibri serve — OpenAI-compatible inference server in pure MFL.
// Build: machin encode framework/machweb.src engine.src serve.src > serve.mfl
// Endpoints: GET /v1/models, POST /v1/chat/completions (stream + non-stream).
// Single-flight: one generation at a time via a mutex-as-service channel;
// the winning request runs inference in ITS goroutine (worker pool is shared,
// exclusive under the lock). Single-slot KV prefix cache makes multi-turn
// chats prefill only the delta.

type FnDef struct {
	name string
	description string
	arguments string
}

type MsgTC struct {
	id string
	function FnDef
}

type ChatMsg struct {
	role string
	content string
	tool_call_id string
	tool_calls []MsgTC
}

type ToolDef struct {
	function FnDef
}

type ChatReq struct {
	model string
	stream bool
	temperature float
	top_p float
	max_tokens int
	seed int
	messages []ChatMsg
	tools []ToolDef
	reqbody string
}

var model_id = "tinyllama-1.1b-q80"
var mu_acq = make(chan int)
var mu_rel = make(chan int)

// ---- skills: trigger-matched guidance injected into the system prompt.
// In-context "finetuning": curated instructions + few-shot examples make the
// small model far more reliable at a task, without changing its weights.
type Skill struct {
	name string
	triggers []string
	priority int
	when string   // "tools" = only inject when the request carries tools; "" = always eligible
	body string
}
var skills = []Skill{}
var skills_max = 2 // inject at most this many matched skills

func parse_skill(content) (sk) {
	sk = Skill{name: "", priority: 0, when: "", body: ""}
	trg := []string{}
	sep := index(content, "\n---")
	head := content
	if sep >= 0 { head = substr(content, 0, sep)  sk.body = trim(substr(content, sep+4, len(content))) }
	lines := split(head, "\n")
	i := 0
	while i < len(lines) {
		ln := trim(lines[i])
		if has_prefix(ln, "name:") { sk.name = trim(substr(ln, 5, len(ln))) }
		if has_prefix(ln, "priority:") { sk.priority = parse_int(trim(substr(ln, 9, len(ln)))) }
		if has_prefix(ln, "when:") { sk.when = trim(substr(ln, 5, len(ln))) }
		if has_prefix(ln, "triggers:") { trg = split(trim(substr(ln, 9, len(ln))), " ") }
		i = i + 1
	}
	sk.triggers = trg
	return
}

func load_skills(dir) {
	files := list_dir(dir)
	s := []Skill{}
	i := 0
	while i < len(files) {
		if has_suffix(files[i], ".skill") {
			c := read_file(dir + "/" + files[i])
			if len(c) > 0 { s = append(s, parse_skill(c)) }
		}
		i = i + 1
	}
	skills = s
}

// score a skill against lowercased request text: +priority-weighted per trigger hit
func skill_score(sk, low) (sc) {
	sc = 0
	i := 0
	while i < len(sk.triggers) {
		t := sk.triggers[i]
		if len(t) > 0 && contains(low, t) { sc = sc + 1 }
		i = i + 1
	}
	return
}

// select the top matched skills for a request; returns their concatenated bodies.
// ctx gates by context: skills declaring when:tools need tools_present, when:
// tool_result need a prior tool-result turn.
func match_skills(usertext, tools_present, tool_result_present) (out) {
	out = ""
	if len(skills) == 0 { return }
	low := to_lower(usertext)
	// score all, pick top skills_max with score>0 (priority breaks ties)
	picked := []int{}
	used := make(map[int]int)
	k := 0
	while k < skills_max {
		best := -1
		bestv := 0
		i := 0
		while i < len(skills) {
			eligible := 1
			if skills[i].when == "tools" && tools_present == false { eligible = 0 }
			if skills[i].when == "tool_result" && tool_result_present == false { eligible = 0 }
			if has(used, i) == false && eligible == 1 {
				sc := skill_score(skills[i], low) * 1000 + skills[i].priority
				hit := skill_score(skills[i], low)
				if hit > 0 && sc > bestv { bestv = sc  best = i }
			}
			i = i + 1
		}
		if best < 0 { break }
		used[best] = 1
		picked = append(picked, best)
		k = k + 1
	}
	i := 0
	while i < len(picked) {
		out = out + "\n\n## Skill: " + skills[picked[i]].name + "\n" + skills[picked[i]].body + "\n"
		i = i + 1
	}
	return
}

func mutex_srv(acq, rel) {
	while true {
		acq <- 1
		v := <-rel
		if v < 0 { break }
	}
}

// llama3 chat template at the TOKEN level:
// <|begin_of_text|>(<|start_header_id|>{role}<|end_header_id|>\n\n{content}<|eot_id|>)*<|start_header_id|>assistant<|end_header_id|>\n\n
func l3_chat_tokens(msgs) (toks) {
	toks = []int{}
	toks = append(toks, 128000)
	i := 0
	while i < len(msgs) {
		m := msgs[i]
		toks = append(toks, 128006)
		seg := l3_encode(m.role)
		j := 0
		while j < len(seg) { toks = append(toks, seg[j])  j = j + 1 }
		toks = append(toks, 128007)
		seg = l3_encode("\n\n" + m.content)
		j = 0
		while j < len(seg) { toks = append(toks, seg[j])  j = j + 1 }
		toks = append(toks, 128009)
		i = i + 1
	}
	toks = append(toks, 128006)
	seg := l3_encode("assistant")
	i = 0
	while i < len(seg) { toks = append(toks, seg[i])  i = i + 1 }
	toks = append(toks, 128007)
	seg = l3_encode("\n\n")
	i = 0
	while i < len(seg) { toks = append(toks, seg[i])  i = i + 1 }
	return
}

// Zephyr chat template at the TOKEN level: "</s>" must be the real EOS id (2),
// not the text "</s>" run through BPE (they tokenize differently).
func chat_tokens(msgs) (toks) {
	if tok_l3 == 1 {
		toks = l3_chat_tokens(msgs)
		return
	}
	toks = []int{}
	toks = append(toks, 1) // BOS
	i := 0
	while i < len(msgs) {
		m := msgs[i]
		seg := bpe_encode_raw("<|" + m.role + "|>\n" + m.content)
		j := 0
		while j < len(seg) { toks = append(toks, seg[j])  j = j + 1 }
		toks = append(toks, 2) // EOS closes each turn
		nl := bpe_encode_raw("\n")
		j = 0
		while j < len(nl) { toks = append(toks, nl[j])  j = j + 1 }
		i = i + 1
	}
	tail := bpe_encode_raw("<|assistant|>\n")
	i = 0
	while i < len(tail) { toks = append(toks, tail[i])  i = i + 1 }
	return
}

// strip surrounding double-quotes from a json_get scalar token
func unq(s) (o) {
	o = s
	if len(s) >= 2 && has_prefix(s, "\"") && has_suffix(s, "\"") { o = substr(s, 1, len(s)-1) }
	return
}

// extract the balanced-brace JSON object that contains the first occurrence of
// `anchor` (e.g. "\"tool_call\""); "" if not found. Skips prose/code-fence wrap.
func extract_obj(s, anchor) (o) {
	o = ""
	a := index(s, anchor)
	if a < 0 { return }
	// back up to the enclosing '{'
	st := a
	while st >= 0 && charat(s, st) != "{" { st = st - 1 }
	if st < 0 { return }
	depth := 0
	i := st
	instr := 0
	esc := 0
	while i < len(s) {
		c := charat(s, i)
		if esc == 1 { esc = 0  i = i + 1  continue }
		if c == "\\" && instr == 1 { esc = 1  i = i + 1  continue }
		if c == "\"" { if instr == 1 { instr = 0 } else { instr = 1 } }
		if instr == 0 {
			if c == "{" { depth = depth + 1 }
			if c == "}" { depth = depth - 1  if depth == 0 { o = substr(s, st, i+1)  return } }
		}
		i = i + 1
	}
	return
}

// build the tool-instruction text appended to the system prompt
func tools_prompt(tools, body) (s) {
	s = "\n\n# Tools\nYou can call a function. Available functions:\n"
	i := 0
	while i < len(tools) {
		params, _ := json_get(body, ".tools[" + str(i) + "].function.parameters")
		if len(params) == 0 { params = "{}" }
		s = s + "- " + tools[i].function.name + ": " + tools[i].function.description + " | parameters JSON schema: " + params + "\n"
		i = i + 1
	}
	s = s + "\nWhen you need a function, reply with ONLY this exact JSON shape on one line and nothing else — no prose, no code fence:\n"
	s = s + "{\"tool_call\": {\"name\": \"FUNCTION_NAME\", \"arguments\": {ARG_KEY: ARG_VALUE}}}\n"
	s = s + "Example: {\"tool_call\": {\"name\": \"bash\", \"arguments\": {\"command\": \"ls -la\"}}}\n"
	s = s + "The value of \"name\" MUST be one of the function names above, and \"arguments\" MUST be a JSON object.\n"
	s = s + "After you receive the tool result (a message with role tool), answer the user in plain text. If no function is needed, just answer in plain text.\n"
	return
}

// normalize messages for templating: inject tools into system prompt, render
// prior assistant tool_calls as their JSON, and tool-result messages as user
// observations (roles collapse to system/user/assistant for the chat template).
func prep_messages(cr) (out) {
	out = []ChatMsg{}
	inject := ""
	// skills: match on the last user message, inject guidance BEFORE tool schema
	last_user := ""
	ui := len(cr.messages) - 1
	while ui >= 0 {
		if cr.messages[ui].role == "user" { last_user = cr.messages[ui].content  break }
		ui = ui - 1
	}
	tres := 0
	ti := 0
	while ti < len(cr.messages) {
		if cr.messages[ti].role == "tool" { tres = 1  break }
		ti = ti + 1
	}
	sk := match_skills(last_user, len(cr.tools) > 0, tres == 1)
	if len(sk) > 0 { inject = inject + sk }
	if len(cr.tools) > 0 { inject = inject + tools_prompt(cr.tools, cr.reqbody) }
	sys_done := 0
	i := 0
	while i < len(cr.messages) {
		m := cr.messages[i]
		if m.role == "system" {
			c := m.content
			if inject != "" && sys_done == 0 { c = c + inject  sys_done = 1 }
			out = append(out, ChatMsg{role: "system", content: c})
			i = i + 1
			continue
		}
		if m.role == "tool" {
			out = append(out, ChatMsg{role: "user", content: "Tool result: " + m.content})
			i = i + 1
			continue
		}
		if m.role == "assistant" && len(m.tool_calls) > 0 {
			tc := m.tool_calls[0]
			jc := "{\"tool_call\": {\"name\": \"" + tc.function.name + "\", \"arguments\": " + tc.function.arguments + "}}"
			out = append(out, ChatMsg{role: "assistant", content: jc})
			i = i + 1
			continue
		}
		out = append(out, ChatMsg{role: m.role, content: m.content})
		i = i + 1
	}
	// tools present but no system message yet -> prepend one
	if inject != "" && sys_done == 0 {
		pre := []ChatMsg{}
		pre = append(pre, ChatMsg{role: "system", content: "You are a helpful assistant." + inject})
		j := 0
		while j < len(out) { pre = append(pre, out[j])  j = j + 1 }
		out = pre
	}
	return
}

// first non-empty json_get among several candidate paths -> raw token ("" if none)
func jget_any(obj, paths) (v) {
	v = ""
	i := 0
	while i < len(paths) {
		r, e := json_get(obj, paths[i])
		if len(e) == 0 && len(r) > 0 && r != "null" { v = r  return }
		i = i + 1
	}
	return
}

// detect+parse a tool call in the model's raw output -> (name, arguments_json).
// name "" means no tool call. 1B models emit several near-formats; accept the
// common ones: {"tool_call":{"name","arguments"}}, {"tool_call":"name","arguments":{}},
// {"name","arguments"|"parameters"}, {"function":"name","arguments"}.
func parse_tool_call(text) (name, argsjson) {
	name = ""
	argsjson = "{}"
	obj := extract_obj(text, "\"tool_call\"")
	if len(obj) == 0 { obj = extract_obj(text, "\"name\"") }
	if len(obj) == 0 { obj = extract_obj(text, "\"function\"") }
	if len(obj) == 0 { return }
	nm := jget_any(obj, []string{".tool_call.name", ".tool_call", ".name", ".function", ".function.name"})
	if len(nm) == 0 { return }
	name = unq(nm)
	if len(name) == 0 || contains(name, "{") || contains(name, " ") { name = ""  return }
	a := jget_any(obj, []string{".tool_call.arguments", ".arguments", ".tool_call.parameters", ".parameters"})
	if len(a) > 0 {
		if has_prefix(a, "\"") { argsjson = "{}" } else { argsjson = a }
	}
	return
}

func json_esc(s) (o) {
	o = replace(s, "\\", "\\\\")
	o = replace(o, "\"", "\\\"")
	o = replace(o, "\n", "\\n")
	o = replace(o, "\r", "\\r")
	o = replace(o, "\t", "\\t")
	return
}

func chunk_json(id, created, piece, finish) (s) {
	d := "{\"content\":\"" + json_esc(piece) + "\"}"
	if len(piece) == 0 { d = "{}" }
	fr := "null"
	if len(finish) > 0 { fr = "\"" + finish + "\"" }
	s = "{\"id\":\"" + id + "\",\"object\":\"chat.completion.chunk\",\"created\":" + str(created) + ",\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"delta\":" + d + ",\"finish_reason\":" + fr + "}]}"
	return
}

func handle_models() (res) {
	body := "{\"object\":\"list\",\"data\":[{\"id\":\"" + model_id + "\",\"object\":\"model\",\"created\":0,\"owned_by\":\"machin-anvil\"}]}"
	res = ok_json(body)
	return
}

func parse_chat_req(body) (cr, err) {
	err = ""
	cr = parse(body, ChatReq{})
	cr.reqbody = body
	if len(cr.messages) == 0 { err = "messages required" }
	if cr.max_tokens <= 0 { cr.max_tokens = 256 }
	if cr.temperature < 0.0 { cr.temperature = 0.0 }
	if cr.top_p <= 0.0 || cr.top_p > 1.0 { cr.top_p = 0.9 }
	return
}

// one tool_call as an OpenAI object fragment (arguments is a JSON string)
func tc_obj(callid, name, argsjson) (s) {
	s = "{\"id\":\"" + callid + "\",\"type\":\"function\",\"function\":{\"name\":\"" + json_esc(name) + "\",\"arguments\":\"" + json_esc(argsjson) + "\"}}"
	return
}

func usage_json(np, n, reused) (s) {
	s = "\"usage\":{\"prompt_tokens\":" + str(np) + ",\"completion_tokens\":" + str(n) + ",\"total_tokens\":" + str(np + n) + ",\"prompt_tokens_cached\":" + str(reused) + "}"
	return
}

func handle_chat(req) (res) {
	cr, perr := parse_chat_req(req.body)
	if len(perr) > 0 {
		res = ok_json("{\"error\":{\"message\":\"" + json_esc(perr) + "\",\"type\":\"invalid_request_error\"}}")
		res.status = "400 Bad Request"
		return
	}
	id := "chatcmpl-" + to_hex(rand_bytes(8))
	created := now()
	msgs := prep_messages(cr)
	toks := chat_tokens(msgs)
	has_tools := len(cr.tools) > 0

	// live token streaming (no tools: we don't need to inspect the whole output)
	if cr.stream && has_tools == false {
		res = sse(func(conn) {
			lk := <-mu_acq
			lk = lk
			if cr.seed > 0 { rng_seed(cr.seed) } else { rng_seed(now_ms() & 2147483647) }
			write(conn, "data: " + chunk_json(id, created, "", "") + "\n\n")
			generate_cb(toks, cr.max_tokens, cr.temperature, cr.top_p, func(piece) {
				write(conn, "data: " + chunk_json(id, created, piece, "") + "\n\n")
			})
			write(conn, "data: " + chunk_json(id, created, "", "stop") + "\n\n")
			write(conn, "data: [DONE]\n\n")
			mu_rel <- 1
		})
		return
	}

	// buffered path (non-stream, or stream+tools: we must see the full output to
	// decide content-vs-tool_call before shaping the response)
	lk := <-mu_acq
	lk = lk
	if cr.seed > 0 { rng_seed(cr.seed) } else { rng_seed(now_ms() & 2147483647) }
	out := []string{}
	n := generate_cb(toks, cr.max_tokens, cr.temperature, cr.top_p, func(piece) {
		out = append(out, piece)
	})
	reused := gen_prefill_reused
	mu_rel <- 1
	full := join(out, "")
	tname := ""
	targs := "{}"
	if has_tools { tname, targs = parse_tool_call(full) }
	callid := "call_" + to_hex(rand_bytes(6))
	np := len(toks)

	if cr.stream {
		tcinner := "{\"index\":0,\"id\":\"" + callid + "\",\"type\":\"function\",\"function\":{\"name\":\"" + json_esc(tname) + "\",\"arguments\":\"" + json_esc(targs) + "\"}}"
		res = sse(func(conn) {
			write(conn, "data: " + chunk_json(id, created, "", "") + "\n\n")
			if len(tname) > 0 {
				write(conn, "data: {\"id\":\"" + id + "\",\"object\":\"chat.completion.chunk\",\"created\":" + str(created) + ",\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[" + tcinner + "]},\"finish_reason\":\"tool_calls\"}]}\n\n")
			} else {
				write(conn, "data: " + chunk_json(id, created, full, "") + "\n\n")
				write(conn, "data: " + chunk_json(id, created, "", "stop") + "\n\n")
			}
			write(conn, "data: [DONE]\n\n")
		})
		return
	}

	if len(tname) > 0 {
		body := "{\"id\":\"" + id + "\",\"object\":\"chat.completion\",\"created\":" + str(created) + ",\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":null,\"tool_calls\":[" + tc_obj(callid, tname, targs) + "]},\"finish_reason\":\"tool_calls\"}]," + usage_json(np, n, reused) + "}"
		res = ok_json(body)
		return
	}
	body := "{\"id\":\"" + id + "\",\"object\":\"chat.completion\",\"created\":" + str(created) + ",\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"" + json_esc(full) + "\"},\"finish_reason\":\"stop\"}]," + usage_json(np, n, reused) + "}"
	res = ok_json(body)
	return
}

func api_route(req) (res) {
	if req.method == "GET" && req.path == "/v1/models" { res = handle_models()  return }
	if req.method == "POST" && req.path == "/v1/chat/completions" { res = handle_chat(req)  return }
	if req.method == "GET" && req.path == "/health" { res = ok_json("{\"ok\":true,\"model\":\"" + model_id + "\"}")  return }
	res = ok_json("{\"error\":{\"message\":\"not found\",\"type\":\"invalid_request_error\"}}")
	res.status = "404 Not Found"
	return
}

func main() {
	a := args()
	model := "models/tinyllama-1.1b-q80.bin"
	port := 8090
	if len(a) > 1 { model = a[1] }
	if len(a) > 2 { port = parse_int(a[2]) }
	nw := parse_int(env("COLIBRI_THREADS"))
	if nw > 0 { n_workers = nw } else { n_workers = 6 }
	if parse_int(env("COLIBRI_NOBATCH")) == 1 { pb_enabled = 0 }
	if parse_int(env("COLIBRI_SPEC")) == 1 { spec_enabled = 1 }
	if parse_int(env("COLIBRI_SPARSE")) == 1 { sparse_probe = 1 }
	el := parse_int(env("COLIBRI_EXIT_LAYER"))
	if el > 0 { exit_layer = el }
	sk := parse_int(env("COLIBRI_SPEC_K"))
	if sk > 0 { spec_k = sk }
	tl := parse_int(env("COLIBRI_TILE"))
	if tl > 0 { pb_tile = tl } // must be set before alloc_state sizes the batch buffers
	t0 := now_ms()
	load_model(model)
	alloc_state()
	load_tokenizer_auto()
	if tok_l3 == 1 { model_id = "llama-3.2-1b-instruct-q80" }
	// skills are OPT-IN (COLIBRI_SKILLS=<dir>): measured to HURT reliability on
	// the 1B baseline (see bench/SKILLS-EVAL.md — the M6 prompt+parser already
	// saturate tool reliability, so extra context only adds drift). The mechanism
	// ships for weaker baselines / bigger models; default is no skills.
	skills_dir := env("COLIBRI_SKILLS")
	if len(skills_dir) > 0 { load_skills(skills_dir) }
	w := 0
	while w < n_workers { go worker(jobs, done)  w = w + 1 }
	go mutex_srv(mu_acq, mu_rel)
	println("colibri serve: model=" + model_id + " dim=" + str(dim) + " layers=" + str(n_layers) + " workers=" + str(n_workers) + " skills=" + str(len(skills)) + " loaded in " + str(now_ms() - t0) + " ms")
	println("OpenAI-compatible API on http://0.0.0.0:" + str(port) + "/v1")
	serve(port, func(req) { return api_route(req) })
}
