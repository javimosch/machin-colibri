// Qwen2.5-1.5B-Instruct OpenAI-compatible server in pure MFL — ChatML template,
// SSE STREAMING (stream:true, the pi requirement), function calling, idle-release.
// Build: machin encode framework/machweb.src qwen_engine.src qwen_tok.src serve_qwen.src

var model_id = "qwen2.5-1.5b-instruct"
var IM_START = 151644
var IM_END = 151645
// tool_choice:"required" forces a call by prefilling the assistant turn with the
// start of a tool-call object, so the model cannot emit an empty '[]'. The prefix
// is reconstructed onto the reply before find_tool_call parses it.
var force_prefix = "[\n    {\"name\": \""
var mu_acq = make(chan int)
var mu_rel = make(chan int)
var last_req = 0
var released = 0
var idle_ms = 300000

func mutex_srv(acq, rel) {
	while true {
		acq <- 1
		v := <-rel
		if v < 0 { break }
	}
}

func idle_watchdog() {
	while true {
		sleep(30000)
		if idle_ms > 0 && released == 0 && now_ms() - last_req > idle_ms {
			g := <-mu_acq
			if released == 0 && now_ms() - last_req > idle_ms {
				madvise_free(mb, model_bytes)
				released = 1
				println("[anvil] idle -> released model pages")  flush()
			}
			mu_rel <- 1
		}
	}
}

func json_esc(s) (o) {
	o = replace(s, "\\", "\\\\")
	o = replace(o, "\"", "\\\"")
	o = replace(o, "\n", "\\n")
	o = replace(o, "\r", "\\r")
	o = replace(o, "\t", "\\t")
	return
}

func json_str(s) (o) {
	v := s
	if len(v) >= 2 && has_prefix(v, "\"") && has_suffix(v, "\"") { v = substr(v, 1, len(v)-1) }
	o = ""
	b := bytes(v)
	n := len(b)
	i := 0
	while i < n {
		c := byte_at(b, i)
		if c == 92 && i+1 < n {
			d := byte_at(b, i+1)
			if d == 110 { o = o + "\n"  i = i + 2  continue }
			if d == 116 { o = o + "\t"  i = i + 2  continue }
			if d == 114 { o = o + "\r"  i = i + 2  continue }
			if d == 34 { o = o + "\""  i = i + 2  continue }
			if d == 92 { o = o + "\\"  i = i + 2  continue }
			if d == 47 { o = o + "/"  i = i + 2  continue }
		}
		o = o + bytes_str(bytes_sub(b, i, i+1))
		i = i + 1
	}
	return
}

func app_ids(dst, src) (out) {
	out = dst
	i := 0
	while i < len(src) { out = append(out, src[i])  i = i + 1 }
	return
}

// build the ChatML token sequence from OpenAI messages (+ tools)
func is_forced(body) (f) {
	f = 0
	tc, te := json_get(body, ".tool_choice")
	if len(te) > 0 { return }
	if json_str(tc) == "required" { f = 1 }
	return
}

func build_prompt_ids(body) (ids) {
	ids = []int{}
	sys := "You are Qwen, created by Alibaba Cloud. You are a helpful assistant."
	r0, e0 := json_get(body, ".messages[0].role")
	first := 0
	if len(e0) == 0 && json_str(r0) == "system" {
		c0, _ := json_get(body, ".messages[0].content")
		sys = json_str(c0)
		first = 1
	}
	// tools -> collect the function specs as a JSON array
	tools := ""
	ti := 0
	while ti < 32 {
		fn, et := json_get(body, ".tools[" + str(ti) + "].function")
		if len(et) > 0 { break }
		if ti > 0 { tools = tools + ", " }
		tools = tools + fn
		ti = ti + 1
	}
	ids = append(ids, IM_START)
	ids = app_ids(ids, tok_encode_raw("system\n" + sys))
	ids = append(ids, IM_END)
	ids = app_ids(ids, tok_encode_raw("\n"))
	// Hammer/xLAM-2 tool format: tools go in a USER message (task-instruction + AVAILABLE_TOOLS +
	// strict-JSON output instruction). These fc models are format-locked to this template; the
	// generic Qwen <tool_call> prompt makes them emit an empty '[]'. find_tool_call parses the
	// [{"name":..,"arguments":..}] array (or '[]' -> no call).
	if len(tools) > 0 {
		htask := "You are a tool calling assistant. In order to complete the user's request, you need to select one or more appropriate tools from the following tools and fill in the correct values for the tool parameters. Your specific tasks are:\n1. Make one or more function/tool calls to meet the request based on the question.\n2. If none of the function can be used, point it out and refuse to answer.\n3. If the given question lacks the parameters required by the function, also point it out."
		hfmt := "The output MUST strictly adhere to the following JSON format, and NO other text MUST be included.\nThe example format is as follows. Please make sure the parameter type is correct. If no function call is needed, please directly output an empty list '[]'\n```\n[\n    {\"name\": \"func_name1\", \"arguments\": {\"argument1\": \"value1\"}}\n]\n```"
		hu := "[BEGIN OF TASK INSTRUCTION]\n" + htask + "\n[END OF TASK INSTRUCTION]\n\n[BEGIN OF AVAILABLE_TOOLS]\n[" + tools + "]\n[END OF AVAILABLE_TOOLS]\n\n[BEGIN OF TASK INSTRUCTION]\n" + hfmt + "\n[END OF TASK INSTRUCTION]\n"
		ids = append(ids, IM_START)
		ids = app_ids(ids, tok_encode_raw("user\n" + hu))
		ids = append(ids, IM_END)
		ids = app_ids(ids, tok_encode_raw("\n"))
	}
	i := first
	while i < 256 {
		role, er := json_get(body, ".messages[" + str(i) + "].role")
		if len(er) > 0 { break }
		content, _ := json_get(body, ".messages[" + str(i) + "].content")
		rr := json_str(role)
		cc := json_str(content)
		if rr == "tool" { rr = "user"  cc = "<tool_response>\n" + cc + "\n</tool_response>" }
		ids = append(ids, IM_START)
		ids = app_ids(ids, tok_encode_raw(rr + "\n" + cc))
		ids = append(ids, IM_END)
		ids = app_ids(ids, tok_encode_raw("\n"))
		i = i + 1
	}
	ids = append(ids, IM_START)
	ids = app_ids(ids, tok_encode_raw("assistant\n"))
	// tool_choice:"required" — prefill the tool-call opening so '[]' is impossible.
	if is_forced(body) == 1 { ids = app_ids(ids, tok_encode_raw(force_prefix)) }
	return
}

func find_tool_call(s) (found, name, argsj) {
	found = 0  name = ""  argsj = "{}"
	ni := index(s, "\"name\"")
	if ni < 0 { return }
	rest := substr(s, ni+6, len(s))
	q1 := index(rest, "\"")
	if q1 < 0 { return }
	after := substr(rest, q1+1, len(rest))
	q2 := index(after, "\"")
	if q2 < 0 { return }
	name = substr(after, 0, q2)
	ai := index(s, "\"arguments\"")
	if ai >= 0 {
		ar := substr(s, ai+11, len(s))
		ob := index(ar, "{")
		if ob >= 0 {
			depth := 0
			j := ob
			b := bytes(ar)
			while j < len(ar) {
				c := byte_at(b, j)
				if c == 123 { depth = depth + 1 }
				if c == 125 { depth = depth - 1  if depth == 0 { argsj = substr(ar, ob, j+1)  break } }
				j = j + 1
			}
		}
	}
	found = 1
	return
}

func handle_chat(req) (res) {
	body := req.body
	streaming := 0
	sv, se := json_get(body, ".stream")
	if len(se) == 0 && sv == "true" { streaming = 1 }
	has_tools := 0
	tf, te := json_get(body, ".tools[0]")
	if len(te) == 0 { has_tools = 1 }
	tf = tf
	max_new := 512
	mn, me := json_get(body, ".max_tokens")
	if len(me) == 0 { v := parse_int(mn)  if v > 0 { max_new = v } }
	ids := build_prompt_ids(body)
	np := len(ids)
	id := "chatcmpl-qwen"

	// live streaming (no tools): stream tokens as SSE
	if streaming == 1 && has_tools == 0 {
		res = sse(func(conn) {
			g := <-mu_acq
			last_req = now_ms()
			released = 0
			write(conn, "data: {\"id\":\"" + id + "\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"},\"finish_reason\":null}]}\n\n")
			gen_stream(ids, np, max_new, func(tid) {
				piece := tok_decode([]int{tid})
				write(conn, "data: {\"id\":\"" + id + "\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"" + json_esc(piece) + "\"},\"finish_reason\":null}]}\n\n")
			})
			g = g
			last_req = now_ms()
			mu_rel <- 1
			write(conn, "data: {\"id\":\"" + id + "\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n")
			write(conn, "data: [DONE]\n\n")
		})
		return
	}

	// buffered (non-stream, or stream+tools: must see the whole output)
	g := <-mu_acq
	last_req = now_ms()
	released = 0
	out := gen_stream(ids, np, max_new, func(tid) { tid = tid })
	g = g
	last_req = now_ms()
	mu_rel <- 1
	reply := tok_decode(out)
	if is_forced(body) == 1 { reply = force_prefix + reply }
	n := len(out)
	found, tname, targs := find_tool_call(reply)
	callid := "call_" + str(np) + str(n)

	if streaming == 1 {
		res = sse(func(conn) {
			write(conn, "data: {\"id\":\"" + id + "\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\"},\"finish_reason\":null}]}\n\n")
			if found == 1 {
				write(conn, "data: {\"id\":\"" + id + "\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"" + callid + "\",\"type\":\"function\",\"function\":{\"name\":\"" + json_esc(tname) + "\",\"arguments\":\"" + json_esc(targs) + "\"}}]},\"finish_reason\":\"tool_calls\"}]}\n\n")
			} else {
				write(conn, "data: {\"id\":\"" + id + "\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"" + json_esc(reply) + "\"},\"finish_reason\":\"stop\"}]}\n\n")
			}
			write(conn, "data: [DONE]\n\n")
		})
		return
	}
	if found == 1 {
		b := "{\"id\":\"" + id + "\",\"object\":\"chat.completion\",\"created\":0,\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":null,\"tool_calls\":[{\"id\":\"" + callid + "\",\"type\":\"function\",\"function\":{\"name\":\"" + json_esc(tname) + "\",\"arguments\":\"" + json_esc(targs) + "\"}}]},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":" + str(np) + ",\"completion_tokens\":" + str(n) + ",\"total_tokens\":" + str(np+n) + "}}"
		res = ok_json(b)
		return
	}
	b := "{\"id\":\"" + id + "\",\"object\":\"chat.completion\",\"created\":0,\"model\":\"" + model_id + "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"" + json_esc(reply) + "\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":" + str(np) + ",\"completion_tokens\":" + str(n) + ",\"total_tokens\":" + str(np+n) + "}}"
	res = ok_json(b)
	return
}

func api_route(req) (res) {
	if req.method == "POST" && req.path == "/v1/chat/completions" { res = handle_chat(req)  return }
	if req.method == "GET" && req.path == "/v1/models" { res = ok_json("{\"object\":\"list\",\"data\":[{\"id\":\"" + model_id + "\",\"object\":\"model\",\"owned_by\":\"anvil\"}]}")  return }
	if req.method == "GET" && req.path == "/health" { res = ok_json("{\"ok\":true,\"model\":\"" + model_id + "\"}")  return }
	res = ok_json("{\"error\":{\"message\":\"not found\",\"type\":\"invalid_request_error\"}}")
	return
}

func main() {
	a := args()
	path := "models/qwen-q8.bin"
	port := 8093
	tokf := "models/qwen-tok.bin"
	if len(a) > 1 { path = a[1] }
	if len(a) > 2 { port = parse_int(a[2]) }
	if len(a) > 3 { tokf = a[3] }
	t0 := now_ms()
	qwen_init(path)
	load_tok(tokf)
	is := parse_int(env("COLIBRI_IDLE"))
	if len(env("COLIBRI_IDLE")) > 0 { idle_ms = is * 1000 }
	last_req = now_ms()
	go mutex_srv(mu_acq, mu_rel)
	go idle_watchdog()
	println("qwen serve: " + model_id + " ctx=" + str(SEQ) + " loaded in " + str(now_ms()-t0) + " ms, " + str(n_workers) + " workers, idle " + str(idle_ms/1000) + "s")
	println("OpenAI API (streaming) on http://0.0.0.0:" + str(port) + "/v1")
	serve(port, func(req) { return api_route(req) })
}
